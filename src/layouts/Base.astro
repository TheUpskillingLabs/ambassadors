---
import { u } from "../lib/url";
import "@fontsource-variable/geologica/wght.css";
import "../styles/colors_and_type.css";
import "../styles/system.css";
import "../styles/guide.css";
import "../styles/app.css";
import Icon from "../components/Icon.astro";
import StepList from "../components/StepList.astro";
import { t } from "../lib/i18n";
import { path, guideHome } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** The step this page is, for the app bar's Steps menu. */
  step?: string;
  /** Before someone is an ambassador (the apply flow): no Steps menu or progress, and the logo goes to the program page. */
  bare?: boolean;
  /** Keep out of search engines (the coordinator's unlisted /invite/ page). */
  noindex?: boolean;
}
const { title, description = t("siteTagline"), step, bare = false, noindex = false } = Astro.props;
const steps = await path();
const stepIndex = steps.findIndex((s) => s.id === step);
const fullTitle = title ? `${title} · ${t("siteName")}` : `${t("siteName")} · The Upskilling Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#00141B" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="manifest" href={u("/manifest.webmanifest")} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={u("/icons/apple-touch-icon.png")} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  </head>
  <body>
    <a class="skip" href="#main">{t("skipToContent")}</a>
    <header class="appbar">
      <div class="appbar-inner">
        <a class="brand" href={bare ? u("/") : guideHome}>
          <img src={u("/assets/logo-lockup-white.png")} alt={t("brandAlt")} width="392" height="144" />
          <span class="brand-name">{t("siteName")}</span>
        </a>
        {!bare && <div class="appbar-end">
          <details class="stepsmenu" data-stepsmenu>
            <summary>
              <span>{stepIndex >= 0 ? t("nav.stepOf", { n: stepIndex + 1, total: steps.length }) : t("nav.steps")}</span>
              <Icon name="chevron" size={16} />
            </summary>
            <div class="stepsmenu-panel"><StepList current={step} dark /></div>
          </details>
          <a class="appbar-present" href={u("/present/")}><Icon name="deck" size={18} /> {t("nav.present")}</a>
        </div>}
      </div>
      {!bare && <div class="appbar-progress" role="progressbar" aria-valuemin="0" aria-valuemax={steps.length} aria-valuenow="0"
        data-total={steps.length} data-label={t("nav.progress")}><i data-progress-fill></i></div>}
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="sitefoot">
      <div class="sitefoot-inner">
        <p>{t("footer.legal")}</p>
        <p class="foot-row">
          <a href={u("/")}>{t("footer.program")}</a>
          <a href="https://theupskillinglabs.org">{t("footer.site")}</a>
          <button class="foot-reset" type="button" data-reset data-confirm={t("footer.resetConfirm")}>{t("footer.reset")}</button>
        </p>
        <p>{t("footer.license")}</p>
      </div>
    </footer>

    <script>
      import { resetAll, progress } from "../lib/store";
      // Progress line and step states from saved progress; the Steps menu closes on Escape or outside click.
      const done = progress.all();
      document.querySelectorAll<HTMLElement>("[data-step-link]").forEach((a) => a.classList.toggle("is-done", Boolean(done[a.dataset.stepLink!])));
      const bar = document.querySelector<HTMLElement>(".appbar-progress");
      if (bar) {
        const total = Number(bar.dataset.total);
        const n = new Set([...document.querySelectorAll<HTMLElement>(".stepsmenu [data-step-link]")].map((a) => a.dataset.stepLink!).filter((id) => done[id])).size;
        bar.querySelector<HTMLElement>("[data-progress-fill]")!.style.width = `${(n / total) * 100}%`;
        bar.setAttribute("aria-valuenow", String(n));
        bar.setAttribute("aria-label", bar.dataset.label!.replace("{n}", String(n)).replace("{total}", String(total)));
      }
      const menu = document.querySelector<HTMLDetailsElement>("[data-stepsmenu]");
      if (menu) {
        document.addEventListener("click", (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")!.focus(); } });
      }
      const reset = document.querySelector<HTMLButtonElement>("[data-reset]")!;
      reset.addEventListener("click", () => {
        if (!confirm(reset.dataset.confirm)) return;
        resetAll();
        location.href = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/guide/`;
      });
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/sw.js`).catch(() => {});
        });
      }
    </script>
  </body>
</html>
