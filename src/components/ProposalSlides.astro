---
/* The proposal deck: 22 slides authored as plain HTML sections
   (content/proposal/slides/*.html), shown in the order deck.json gives.
   Each file is one 1920×1080 <section> with inline styles in the site's
   tokens; its <aside> is the speaker note, lifted into data-notes for the
   /proposal/?notes view. Image paths in the files start at "/" and get the
   site's base prefix here. */
import { u } from "../lib/url";
import deck from "../../content/proposal/deck.json";

const files = import.meta.glob("../../content/proposal/slides/*.html", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const byId = Object.fromEntries(Object.entries(files).map(([p, html]) => [p.split("/").pop()!.replace(/\.html$/, ""), html]));
const base = u("/");
const slides = deck.order.map((id, i) => {
  const raw = byId[id];
  if (!raw) throw new Error(`content/proposal/slides/${id}.html is missing`);
  const notes = (raw.match(/<aside>([\s\S]*?)<\/aside>/) ?? [])[1]?.replace(/\s+/g, " ").trim() ?? "";
  const html = raw.replace(/<aside>[\s\S]*?<\/aside>\s*/, "").replace(/src="\//g, `src="${base}`);
  return { id, n: i + 1, notes, html };
});
---
<div class="slides" data-slides>
  {slides.map((s) => (
    <div class:list={["slide", { current: s.n === 1 }]} data-n={s.n} data-key={s.id} data-notes={s.notes} aria-roledescription="slide" aria-label={`Slide ${s.n}`} set:html={s.html} />
  ))}
</div>
