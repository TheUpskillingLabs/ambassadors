---
/* Practice — a card deck: read the situation, think, flip, rate.
   The first round is the core situations; "More situations" deals the rest.
   Reveal unlocks after a short think-first pause (thinking of an answer
   before seeing one is what makes practice stick). Rate privately: swipe
   right / → "Had it", left / ← "Not yet". "Not yet" cards come back first.
   Every gesture has a button and a key. Reads content/scenarios — the same
   files the prospect game will read. */
import { getCollection } from "astro:content";
import { t } from "../lib/i18n";
import Icon from "./Icon.astro";
import Placeholder from "./Placeholder.astro";
const scenarios = (await getCollection("scenarios")).map((s) => s.data).sort((a, b) => Number(b.core) - Number(a.core));
---
<section class="sd" data-sd data-count-tpl={t("practice.position")} data-reveal={t("practice.reveal")} data-flip-back={t("practice.flipBack")}>
  <p class="sd-count" data-count></p>

  <div class="sd-stage" data-stage>
    {scenarios.map((s, i) => (
      <article class="sd-card" data-id={s.id} data-core={String(s.core)} hidden={i !== 0} aria-roledescription={t("practice.card")}>
        <span class="sd-stamp had" aria-hidden="true">{t("practice.had")}</span>
        <span class="sd-stamp not" aria-hidden="true">{t("practice.notYet")}</span>
        <div class="sd-flip">
          <div class="sd-face sd-front">
            <div class="sd-body">
              <p class="kicker">{t(`practice.modes.${s.mode}`)} · {t(`practice.audiences.${s.audience}`)}</p>
              <p class="sd-setup">{s.setup}</p>
              <p class="sd-hint"><span>{t("practice.prompt")}</span><span class="bar" aria-hidden="true"><i></i></span></p>
            </div>
          </div>
          <div class="sd-face sd-back" aria-hidden="true">
            <div class="sd-body">
              <p class="lbl">{t("practice.example")}</p>
              <p class="sd-answer">{s.goodResponse}</p>
              <p class="lbl">{t("practice.why")}</p>
              <p class="t-body sd-why">{s.why}</p>
              <Placeholder show={s.placeholder} />
            </div>
          </div>
        </div>
      </article>
    ))}

    <div class="sd-done" data-done-panel hidden>
      <h2 class="t-h2">{t("practice.roundTitle")}</h2>
      <p class="t-body">{t("practice.roundBody")}</p>
      <button class="btn btn-ghost btn-block" type="button" data-more>{t("practice.more")}</button>
    </div>
  </div>

  <div class="sd-actions" data-actions>
    <span class="sd-btn-label"><button class="sd-btn" type="button" data-rate="not" aria-label={t("practice.notYet")} disabled><Icon name="close" size={26} /></button>{t("practice.notYet")}</span>
    <span class="sd-btn-label"><button class="sd-btn big" type="button" data-flip aria-label={t("practice.reveal")}><Icon name="eye" size={30} /></button><span data-flip-label>{t("practice.reveal")}</span></span>
    <span class="sd-btn-label"><button class="sd-btn had" type="button" data-rate="had" aria-label={t("practice.had")} disabled><Icon name="check" size={28} /></button>{t("practice.had")}</span>
  </div>
  <p class="sd-keys">{t("practice.keys")}</p>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</section>

<script>
  import { practice, type SelfCheck } from "../lib/store";
  const THINK_MS = 2500;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-sd]").forEach((root) => {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const all = Array.from(root.querySelectorAll<HTMLElement>(".sd-card"));
    let deck: HTMLElement[] = [];
    let at = 0, flipped = false, canFlip = false, thinkTimer: number | undefined;
    const top = () => deck[at];
    const live = (msg: string) => ($("[data-live]").textContent = msg);

    function deal(core: boolean) {
      const c = practice.all();
      deck = all.filter((el) => (el.dataset.core === "true") === core)
        .sort((a, b) => Number(c[b.dataset.id!] === "not") - Number(c[a.dataset.id!] === "not"));
      at = 0;
      $("[data-more]").hidden = !core;
      render();
    }

    function render() {
      clearTimeout(thinkTimer);
      flipped = false; canFlip = false;
      all.forEach((el) => { el.hidden = true; el.className = "sd-card"; el.style.transform = ""; el.style.opacity = ""; });
      const done = at >= deck.length;
      $("[data-done-panel]").hidden = !done;
      $("[data-actions]").hidden = done;
      $("[data-count]").textContent = done ? "" : root.dataset.countTpl!.replace("{n}", String(at + 1)).replace("{total}", String(deck.length));
      root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) => (b.disabled = true));
      $("[data-flip-label]").textContent = root.dataset.reveal!;
      if (done) return;
      deck.slice(at, at + 3).forEach((el, k) => {
        el.hidden = false;
        if (k) el.classList.add(`back${k}`);
        el.style.zIndex = String(10 - k);
        el.querySelector(".sd-back")!.setAttribute("aria-hidden", "true");
      });
      const card = top();
      card.classList.add("thinking");
      const flipBtn = $<HTMLButtonElement>("[data-flip]");
      flipBtn.disabled = true;
      thinkTimer = window.setTimeout(() => { canFlip = true; flipBtn.disabled = false; card.classList.remove("thinking"); }, reduce ? 0 : THINK_MS);
      live(card.querySelector(".sd-setup")!.textContent!);
    }

    function flip() {
      const card = top();
      if (!card || !canFlip) return;
      flipped = !flipped;
      card.classList.toggle("flipped", flipped);
      card.querySelector(".sd-back")!.setAttribute("aria-hidden", String(!flipped));
      card.querySelector(".sd-front")!.setAttribute("aria-hidden", String(flipped));
      $("[data-flip-label]").textContent = flipped ? root.dataset.flipBack! : root.dataset.reveal!;
      root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) => (b.disabled = !flipped));
      if (flipped) live(card.querySelector(".sd-answer")!.textContent!);
    }

    function rate(v: SelfCheck, fromDrag = false) {
      const card = top();
      if (!card || !flipped) return;
      practice.set(card.dataset.id!, v);
      navigator.vibrate?.(8);
      const dx = v === "had" ? 1 : -1;
      card.classList.add("gone");
      if (!fromDrag) card.style.transform = `translateX(${dx * 140}%) rotate(${dx * 18}deg)`;
      card.style.opacity = "0";
      window.setTimeout(() => { at++; render(); }, reduce ? 0 : 280);
    }

    // ── swipe on the top card ──
    let sx = 0, dx = 0, dragging = false, moved = false;
    const stage = $("[data-stage]");
    stage.addEventListener("pointerdown", (e) => {
      const card = top();
      if (!card || (e.target as HTMLElement).closest(".sd-card") !== card) return;
      sx = e.clientX; dx = 0; dragging = true; moved = false;
      card.classList.add("dragging");
      card.setPointerCapture(e.pointerId);
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const card = top();
      dx = e.clientX - sx;
      if (Math.abs(dx) > 6) moved = true;
      card.style.transform = flipped ? `translateX(${dx}px) rotate(${dx / 18}deg)` : `translateX(${dx * 0.15}px)`;
      if (flipped) {
        card.querySelector<HTMLElement>(".sd-stamp.had")!.style.opacity = String(Math.max(0, Math.min(1, dx / 110)));
        card.querySelector<HTMLElement>(".sd-stamp.not")!.style.opacity = String(Math.max(0, Math.min(1, -dx / 110)));
      }
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      const card = top();
      card.classList.remove("dragging");
      card.querySelectorAll<HTMLElement>(".sd-stamp").forEach((s) => (s.style.opacity = "0"));
      if (!moved) { card.style.transform = ""; flip(); return; }
      if (flipped && Math.abs(dx) > 110) { card.style.transform = `translateX(${dx * 4}px) rotate(${dx / 8}deg)`; rate(dx > 0 ? "had" : "not", true); }
      else card.style.transform = "";
    };
    stage.addEventListener("pointerup", end);
    stage.addEventListener("pointercancel", end);

    // ── buttons + keys ──
    $("[data-flip]").addEventListener("click", flip);
    root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) => b.addEventListener("click", () => rate(b.dataset.rate as SelfCheck)));
    $("[data-more]").addEventListener("click", () => deal(false));
    document.addEventListener("keydown", (e) => {
      const el = e.target as HTMLElement;
      if (el.closest("input, textarea") || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === " " || e.key === "Enter") { if (!el.closest("button, a")) { e.preventDefault(); flip(); } }
      else if (e.key === "ArrowRight") { e.preventDefault(); rate("had"); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); rate("not"); }
    });

    deal(true);
  });
</script>
