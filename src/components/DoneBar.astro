---
import Icon from "./Icon.astro";
import { t } from "../lib/i18n";
interface Props { id: string; nextHref?: string }
const { id, nextHref } = Astro.props;
---
<div class="done-bar" data-read-sentinel>
  <button class="btn btn-teal done-btn" type="button" data-done={id} data-next-href={nextHref} data-done-text={t("page.done")} data-read-text={t("page.markedRead")}>
    <Icon name="check" size={20} />
    <span data-done-label>{t("page.done")}</span>
  </button>
</div>
