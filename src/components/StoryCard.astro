---
/* The reader's saved 30-second why, as an information panel (not a card:
   only the link inside is pressable). */
import { u } from "../lib/url";
import { t } from "../lib/i18n";
---
<section class="panel" data-story-card>
  <h2 class="block-h">{t("page.yourWhy")}</h2>
  <p class="story-text" data-story-text hidden></p>
  <p class="t-small" data-story-empty>{t("page.noStoryYet")}</p>
  <a class="see" href={u("/your-story/")} data-story-link data-edit={t("page.editYourStory")}>{t("page.writeYourStory")} →</a>
</section>
<script>
  import { story } from "../lib/store";
  const s = story.get();
  document.querySelectorAll<HTMLElement>("[data-story-card]").forEach((card) => {
    if (!s.draft.trim()) return;
    const q = card.querySelector<HTMLElement>("[data-story-text]")!;
    q.textContent = s.draft;
    q.hidden = false;
    card.querySelector<HTMLElement>("[data-story-empty]")!.hidden = true;
    const link = card.querySelector<HTMLElement>("[data-story-link]")!;
    link.textContent = `${link.dataset.edit} →`;
  });
</script>
