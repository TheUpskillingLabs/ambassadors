---
/* A chapter of the home page: one of the three paths joining opens (Learn, Build, Pass it on). The threads run
   across its top with its own strand lit, then its name set large, marked with the model's actor for it (a
   person, a project, knowledge), then what it is, how often, and in a line or two what happens. The sections
   that follow it on the page are the chapter's; the next chapter's head ends it. Styles in
   src/styles/home.css (.hm-ch). */
import Threads from "./Threads.astro";
interface Props {
  id: string;
  c: { no: string; verb: string; mark: string; title: string; when: string; lede: string };
}
const { id, c } = Astro.props;
---
<section id={id} class="hm-ch" data-ch={id} aria-labelledby={`${id}-t`}>
  <div class="rp-wrap">
    <Threads on={id} />
    <div class="hm-ch-in">
      <div class="hm-ch-name reveal">
        <p class="hm-ch-k"><i class={`mk mk-${c.mark}`} aria-hidden="true"></i>{c.no}</p>
        <h2 class="hm-ch-verb" id={`${id}-t`}>{c.verb}<span class="dot">.</span></h2>
      </div>
      <div class="hm-ch-say reveal">
        <p class="hm-ch-title">{c.title}</p>
        <p class="hm-ch-when">{c.when}</p>
        <p class="hm-ch-lede">{c.lede}</p>
      </div>
    </div>
  </div>
</section>
