---
/* A path's own scene in the home page's journey (Learn, Build or Pass it on). While it holds the screen the
   world's weave draws in to this path's single thread, and the words sit beside it, never over it: the path's
   gem and number, its name set large, then what it is, how often, a line or two of what happens, and a way
   down to its detail after the journey. Styles in src/styles/home.css (.hm-ch, .hm-scene, .hm-side). */
interface Props {
  id: "learn" | "build" | "give";
  c: { no: string; verb: string; title: string; when: string; lede: string; more: { label: string; to: string } };
}
const { id, c } = Astro.props;
---
<section id={id} class="hm-ch hm-scene" data-ch={id} data-scene aria-labelledby={`${id}-t`}>
  <div class="hm-scene-in" data-scene-in>
    <div class="rp-wrap">
      <div class="hm-side" data-quiet>
        <p class="hm-ch-k"><i class="gem" data-gem={id} aria-hidden="true"></i>{c.no}</p>
        <h2 class="hm-ch-verb" id={`${id}-t`}>{c.verb}<span class="dot">.</span></h2>
        <p class="hm-ch-title">{c.title}</p>
        <p class="hm-ch-when">{c.when}</p>
        <p class="hm-ch-lede">{c.lede}</p>
        <a class="textlink hm-more" href={`#${c.more.to}`}>{c.more.label} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>
