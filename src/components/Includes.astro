---
/* Structured content pulled into a page by its `include` field (one or
   several). Kept to what an ambassador acts on: who, the ask, where. */
import { getCollection } from "astro:content";
import { u } from "../lib/url";
import { t } from "../lib/i18n";
import Ladder from "./Ladder.astro";
import Placeholder from "./Placeholder.astro";
import story from "../../content/site/story.json";
type Inc = "audiences" | "glossary" | "faq" | "ladder" | "story-examples";
interface Props { include?: Inc | Inc[] }
const list: Inc[] = Astro.props.include ? ([] as Inc[]).concat(Astro.props.include) : [];
const has = (k: Inc) => list.includes(k);

const audiences = has("audiences") ? (await getCollection("audiences")).sort((a, b) => a.data.order - b.data.order) : [];
const glossary = has("glossary") ? await getCollection("glossary") : [];
const faq = has("faq") ? (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order) : [];
---
{list.map((inc) => (
  <>
    {inc === "ladder" && <Ladder />}

    {inc === "audiences" && (
      <div class="profiles">
        {audiences.map((a) => (
          <article class="profile" id={a.id}>
            <p class="meta">{a.data.priority && <span class="status active">{t("include.priority")}</span>}<Placeholder show={a.data.placeholder} /></p>
            <h2 class="t-h3">{a.data.name}</h2>
            <p class="t-body">{a.data.whoTheyAre}</p>
            <dl class="kv-list">
              <div><dt class="lbl lbl-teal">{t("include.theAsk")}</dt><dd class="ask">{a.data.theAsk}</dd></div>
              <div><dt class="lbl">{t("include.whereToFind")}</dt><dd>{a.data.whereToFind.slice(0, 3).join(" · ")}</dd></div>
            </dl>
            <a class="see" href={u(`/practice/?audience=${a.data.scenarioAudience}`)}>{t("practice.withAudience")} →</a>
          </article>
        ))}
      </div>
    )}

    {inc === "faq" && (
      <section class="block">
        <h2 class="block-h">{t("include.questions")}</h2>
        <div class="faq">
          {faq.map((f) => (
            <details class="faq-item" id={f.id}>
              <summary>{f.data.question}</summary>
              <div class="faq-a"><p class="t-body">{f.data.answer}</p></div>
            </details>
          ))}
        </div>
      </section>
    )}

    {inc === "glossary" && (
      <section class="block">
        <h2 class="block-h">{t("include.brandTerms")}</h2>
        <dl class="gloss">
          {glossary.map((g) => (
            <div class="gloss-item" id={g.id}><dt class="t-h4">{g.data.term}</dt><dd><p class="t-body">{g.data.definition}</p></dd></div>
          ))}
        </dl>
      </section>
    )}

    {inc === "story-examples" && (
      <div class="story-examples">
        {story.examples.map((e) => (
          <figure><blockquote class="t-body">{e.text}</blockquote><figcaption class="t-small">{e.name}</figcaption></figure>
        ))}
      </div>
    )}
  </>
))}
