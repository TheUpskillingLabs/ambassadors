---
/* The threads: three strands twisting round each other, one for each path joining opens (learn, build, pass it
   on), in the model's colours for what each is about: people, projects, knowledge. Drawn as a helix seen from the
   side, in short segments sorted back to front, each with a halo of ink, so the strands pass over and under each
   other. With `on`, that path's strand is lit and the others step back. Styles in src/styles/home.css (.thr). */
interface Props { on?: string }
const { on = "all" } = Astro.props;
const W = 1200, H = 56, A = 17, P = 400, STEP = 12;
const ids = ["learn", "build", "give"];
type Seg = { s: string; d: number; x1: number; y1: number; x2: number; y2: number };
const segs: Seg[] = [];
ids.forEach((s, k) => {
  const ph = (k * 2 * Math.PI) / 3;
  for (let x = 0; x < W; x += STEP) {
    const t1 = (2 * Math.PI * x) / P + ph, t2 = (2 * Math.PI * (x + STEP)) / P + ph;
    segs.push({ s, d: Math.cos((t1 + t2) / 2), x1: x, y1: H / 2 - A * Math.sin(t1), x2: x + STEP, y2: H / 2 - A * Math.sin(t2) });
  }
});
segs.sort((a, b) => a.d - b.d);
const f = (n: number) => n.toFixed(1);
---
<div class="thr-box" aria-hidden="true"><svg class="thr" data-on={on} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
  {segs.map((g) => (
    <>
      <line class="h" x1={f(g.x1)} y1={f(g.y1)} x2={f(g.x2)} y2={f(g.y2)} />
      <line class="l" data-s={g.s} x1={f(g.x1)} y1={f(g.y1)} x2={f(g.x2)} y2={f(g.y2)} />
    </>
  ))}
</svg></div>
