---
/* A guide page (Start Here, Know the Labs, utility pages): header,
   "In 30 seconds", Markdown body, included content, then Done · Next. */
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "./PageHeader.astro";
import ProgressMeter from "./ProgressMeter.astro";
import Includes from "./Includes.astro";
import NextBar from "./NextBar.astro";
import { t } from "../lib/i18n";
import { sectionHref, sectionProgressId, COVERS } from "../lib/content";

interface Props {
  entry: CollectionEntry<"pages">;
  siblings: CollectionEntry<"pages">[];
  sectionTitle: string;
  sectionHref: string;
  nav: "start-here" | "know-the-labs" | "your-story" | "deck";
}
const { entry, siblings, sectionTitle, sectionHref: sHref, nav } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const tracked = siblings.filter((s) => s.data.tracked);
const i = siblings.findIndex((s) => s.id === entry.id);
const link = (e?: CollectionEntry<"pages">) => (e ? { href: sectionHref(e), title: e.data.navLabel ?? e.data.title } : null);
const pid = sectionProgressId(entry);
const ti = tracked.findIndex((s) => s.id === entry.id);
---
<Base title={d.title} description={d.summary} nav={nav}>
  <PageHeader
    back={{ href: sHref, label: sectionTitle }}
    eyebrow={d.tracked && tracked.length > 1 ? t("page.stepOf", { section: sectionTitle, n: ti + 1, total: tracked.length }) : sectionTitle}
    title={d.title}
    readTime={d.readTime}
    placeholder={d.placeholder}
    cover={COVERS[d.section] ? { variant: COVERS[d.section], name: d.section } : undefined}
  >
    {d.tracked && tracked.length > 1 && <ProgressMeter ids={tracked.map(sectionProgressId)} current={ti} />}
  </PageHeader>
  <article class="wrap page-body" data-page-id={d.tracked ? pid : undefined}>
    <section class="panel lead">
      <h2 class="block-h">{t("page.inThirtySeconds")}</h2>
      <p class="t-lede">{d.summary}</p>
    </section>
    <div class="prose"><Content /></div>
    <Includes include={d.include} />
    <NextBar id={d.tracked ? pid : undefined} next={link(siblings[i + 1])} prev={link(siblings[i - 1])} up={{ href: sHref, title: sectionTitle }} />
  </article>
</Base>
