---
/* An invite with a date: filled from the next session in schedule.json.
   Specific, dated asks outperform vague ones (implementation intentions). */
import { t } from "../lib/i18n";
---
<section class="panel" data-dated-invite>
  <h2 class="block-h">{t("invite.title")}</h2>
  <p class="story-text" data-invite-text data-template={t("invite.template")}>{t("invite.fallback")}</p>
  <p class="t-small">{t("invite.note")}</p>
</section>
<script>
  import { nextSession, formatSession } from "../lib/schedule";
  const s = nextSession();
  if (s) {
    const f = formatSession(s);
    const place = s.location.split(",")[0];
    document.querySelectorAll<HTMLElement>("[data-invite-text]").forEach((el) => {
      el.textContent = el.dataset.template!
        .replace("{what}", s.type)
        .replace("{day}", f.day)
        .replace("{time}", f.time)
        .replace("{place}", place);
    });
  }
</script>
