---
/* "Text your coordinator": opens the ambassador's own messaging app with a
   first line filled in. Nothing is sent by the site. Falls back to email
   until a coordinator phone is set in content/site/help.json. */
import help from "../../content/site/help.json";
interface Props { label: string; body: string; class?: string; attrs?: Record<string, string> }
const { label, body, class: cls = "see", attrs = {} } = Astro.props;
const c = help.coordinator;
---
<a class={cls} href={c.phone ? `sms:${c.phone}` : `mailto:${c.email}`} data-coord data-phone={c.phone} data-email={c.email} data-body={body} {...attrs}>{label}{cls === "see" && " →"}</a>
<script>
  import { profile, application } from "../lib/store";
  // Built at tap time so the name typed on this page is included.
  const build = (a: HTMLAnchorElement) => {
    const body = a.dataset.body!.replace("{me}", profile.get().me ?? application.get().first ?? "").replace(/\s+,/, ",");
    a.href = a.dataset.phone ? `sms:${a.dataset.phone}?&body=${encodeURIComponent(body)}` : `mailto:${a.dataset.email}?body=${encodeURIComponent(body)}`;
  };
  document.querySelectorAll<HTMLAnchorElement>("[data-coord]").forEach((a) => {
    build(a);
    ["pointerdown", "focus"].forEach((ev) => a.addEventListener(ev, () => build(a)));
  });
</script>
