---
import { t } from "../lib/i18n";
import Placeholder from "./Placeholder.astro";
interface Props {
  back?: { href: string; label: string };
  eyebrow?: string;
  title: string;
  readTime?: number;
  lede?: string;
  placeholder?: boolean;
}
const { back, eyebrow, title, readTime, lede, placeholder = false } = Astro.props;
---
<header class="page-head">
  <div class="wrap">
    {back && (
      <a class="back" href={back.href}><span aria-hidden="true">←</span> {back.label}</a>
    )}
    {(eyebrow || readTime || placeholder) && (
      <div class="head-meta">
        {eyebrow && <span class="lbl lbl-teal">{eyebrow}</span>}
        {readTime && <span class="lbl">{readTime} {t("page.minRead")}</span>}
        <Placeholder show={placeholder} />
      </div>
    )}
    <h1 class="t-h1">{title}</h1>
    {lede && <p class="t-lede head-lede">{lede}</p>}
    <slot />
  </div>
</header>
