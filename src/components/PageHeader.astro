---
import { u } from "../lib/url";
import { t } from "../lib/i18n";
import Icon from "./Icon.astro";
interface Props {
  back?: { href: string; label: string };
  /** Small line above the title, e.g. "Step 2 of 5". */
  eyebrow?: string;
  title: string;
  lede?: string;
  placeholder?: boolean;
}
const { back, eyebrow, title, lede, placeholder = false } = Astro.props;
---
<header class="head">
  <div class="wrap">
    {back && <a class="crumb" href={u(back.href)}><Icon name="chevron" size={16} /> {back.label}</a>}
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1 class="t-h1">{title}</h1>
    {lede && <p class="t-lede head-lede">{lede}</p>}
    {placeholder && <p class="meta"><span class="ph-chip">{t("page.placeholder")}</span></p>}
  </div>
</header>
