---
import { u } from "../../lib/url";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import NextSession from "../../components/NextSession.astro";
import { t } from "../../lib/i18n";
const items = (await getCollection("refreshers")).sort((a) => (a.data.playbook === "conversation" ? -1 : 1));
---
<Base title={t("refresher.title")} description={t("refresher.lede")} nav="refreshers">
  <PageHeader back={{ href: u("/"), label: t("nav.home") }} title={t("refresher.title")} lede={t("refresher.lede")} />
  <div class="wrap page-body">
    <div class="book-grid">
      {items.map((r) => (
        <a class="book card tappable" href={u(`/refreshers/${r.data.playbook}/`)}>
          <div class="card-body">
            <span class="lbl">{r.data.readTime} {t("page.minRead")}</span>
            <h2 class="t-h2">{r.data.title}</h2>
            <p class="t-body">{r.data.shape.map((s) => s.step).join(" → ")}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="card"><div class="card-body"><NextSession /></div></div>
  </div>
</Base>
