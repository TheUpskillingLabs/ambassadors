---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import NextSession from "../../components/NextSession.astro";
import Row from "../../components/Row.astro";
import { t } from "../../lib/i18n";
const items = (await getCollection("refreshers")).sort((a) => (a.data.playbook === "conversation" ? -1 : 1));
---
<Base title={t("refresher.title")} description={t("refresher.lede")} nav="refreshers">
  <PageHeader back={{ href: "/", label: t("nav.home") }} title={t("refresher.title")} lede={t("refresher.lede")} />
  <div class="wrap page-body">
    <ul class="rows">
      {items.map((r) => (
        <li><Row href={`/refreshers/${r.data.playbook}/`} title={r.data.title} sub={`${r.data.readTime} ${t("page.minRead")} · ${r.data.shape.map((s) => s.step).join(" → ")}`} /></li>
      ))}
      <li><Row href="/practice/" title={t("refresher.practiceRow")} sub={t("refresher.practiceSub")} /></li>
    </ul>
    <section class="panel"><NextSession /></section>
  </div>
</Base>
