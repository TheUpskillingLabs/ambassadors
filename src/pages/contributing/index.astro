---
/* /contributing/ — the contributor community: learn to build, get your work
   into your Lab, graduate, and the best of it reaches every Lab. Every role
   builds in OLOS; each Lab runs its own fork. The gold pin is graduation
   (your work was reviewed and merged into your Lab's OLOS); Reviewer,
   Committer and Maintainer are the stewards who run the review, each adding a
   ring. The core is the same system one level up (the nickel pin). Unlisted
   (noindex, and not linked from the program page) until the board approves
   it; the home page's Share path leads here, as the explainer for
   contributing. /roles/, /pin/ and /contributors/ redirect here.
   Plan: docs/contributing-rework-plan.md.

   The pins are live 3D on desktop: public/join/pin3d.js (the program page's
   pin) plus rings built in src/scripts/rankpin.ts. Two views: the hero pin,
   which turns to follow the pointer, and the stewards' picker, where each
   role's pin builds as you scroll (or pick a role) and can be dragged to turn. Phones,
   reduced motion and machines without GPU WebGL get Cycles stills of the same
   pins from LabsPin.blend (public/contributing/), framed identically.

   Three chapter covers (src/components/JoinCover.astro) reuse the program
   page's macro shots of the pin, with this page's taglines.

   Copy lives in content/site/contributing.json. */
import Site from "../../layouts/Site.astro";
import "../../styles/contributing.css";
import { u } from "../../lib/url";
import JoinCover from "../../components/JoinCover.astro";
import c from "../../../content/site/contributing.json";
import j from "../../../content/site/join.json";

const media = (f: string) => u(`/contributing/${f}`);
const RANKS = ["member", "reviewer", "committer", "maintainer"] as const;
const pinSrc = (rank: string, metal: string, size = 1200) => media(`pin-${rank}-${metal}-${size}.webp`);
const pinSet = (rank: string, metal: string) => `${pinSrc(rank, metal, 640)} 640w, ${pinSrc(rank, metal, 1200)} 1200w`;
const heroStill = media("hero-brass-760.webp");
const heroSet = `${media("hero-brass-760.webp")} 760w, ${media("hero-brass-1200.webp")} 1200w`;
const pin3d = u("/join/pin3d.js");
const home = u("/ambassador/");
const apply = u("/account/apply/");
const pageTitle = `${c.title} · The Upskilling Labs`;
const local = [
  { label: c.nav.start, href: "#start", spy: "why ch-together start" },
  { label: c.nav.how, href: "#how", spy: "how" },
  { label: c.nav.rings, href: "#given", spy: "ch-levelup given rings status" },
  { label: c.nav.core, href: "#core", spy: "ch-leader core decides" },
  { label: c.nav.program, href: home },
];
---
<Site title={pageTitle} description={c.description} image={media("og.jpg")} bodyClass="cm" local={local} note={c.placeholder ? `[PLACEHOLDER] ${c.footer.source}` : c.footer.renders}>
  <Fragment slot="head"><link rel="preload" as="image" href={heroStill} imagesrcset={heroSet} imagesizes="min(760px, 94vw, 56vh)" fetchpriority="high" /></Fragment>
    <main id="main">
      <!-- Hero: the pin on its own, in brass, turning toward the pointer. -->
      <section id="top" class="jp-hero cm-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="stage">
          <h1 class="wordin">{c.hero.title[0]}<br />{c.hero.title[1]}</h1>
          <div class="jp-pin pinin">
            <div class="bob cm-view" role="img" aria-label={c.hero.pinAlt} data-view="hero" data-pin3d={pin3d}>
              <img src={heroStill} srcset={heroSet} sizes="min(760px, 94vw, 56vh)" alt="" width="760" height="760" fetchpriority="high" data-still />
              <canvas aria-hidden="true"></canvas>
            </div>
          </div>
        </div>
        <p class="lede-hero rise d1">{c.hero.lede}</p>
        <div class="ctas rise d2">
          <a class="ghost" href="#start">{c.hero.cta}<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5v11M2.5 8 7 12.5 11.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
        <p class="status rise d3"><i aria-hidden="true"></i>{c.hero.status}</p>
        <p class="cm-draft rise d3"><b>Draft.</b> {c.draft}</p>
      </section>

      <!-- Why here: what makes The Labs different. -->
      <section id="why" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.why.kicker}</p>
            <h2 class="h2">{c.why.title}</h2>
          </div>
          <div class="jp-cols four cm-four reveal">
            {c.why.items.map((it) => (
              <div class="jp-col"><p class="label">{it.label}</p><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
        </div>
      </section>

      <JoinCover n={c.chapters[0].shot} id={c.chapters[0].id} title={c.chapters[0].title} />

      <!-- Every role builds: example roles, what each runs and what it builds in OLOS. Then the on-ramp. -->
      <section id="start" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.start.kicker}</p>
            <h2 class="h2 cm-h2-wide">{c.start.title}</h2>
            <p class="lede">{c.start.lede}</p>
          </div>
          <div class="jp-cols four cm-four reveal">
            {c.start.items.map((it) => (
              <div class="jp-col"><p class="label">{it.label}</p><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
          <p class="cm-note reveal">{c.start.note}</p>
        </div>
      </section>

      <!-- How work gets in: show it working, then review. -->
      <section id="how" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.how.kicker}</p>
            <h2 class="h2">{c.how.title}</h2>
            <p class="lede">{c.how.lede}</p>
          </div>
          <ol class="jp-steps reveal">
            {c.how.steps.map((s, i) => (
              <li class:list={{ milestone: i === c.how.steps.length - 1 }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
          <p class="cm-note">{c.how.note}</p>
        </div>
      </section>

      <JoinCover n={c.chapters[1].shot} id={c.chapters[1].id} title={c.chapters[1].title} />

      <!-- The gold pin: graduation, and how it's given. -->
      <section id="given" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.given.kicker}</p>
            <h2 class="h2">{c.given.title}</h2>
          </div>
          <ol class="jp-steps reveal">
            {c.given.steps.map((s, i) => (
              <li class:list={{ milestone: i === c.given.steps.length - 1 }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
          <p class="cm-note">{c.given.note}</p>
        </div>
      </section>

      <!-- The stewards: one role at a time, by scroll (wide screens) or by picking one. The pin beside it can be dragged. -->
      <section id="rings" class="jp-sec cm-rings">
        <div class="wrap reveal">
          <p class="kicker">{c.rings.kicker}</p>
          <h2 class="h2">{c.rings.title}</h2>
          <p class="lede">{c.rings.lede}</p>
        </div>
        <div class="cm-scrub" data-scrub>
          <div class="cm-scrub-stage">
            <div class="wrap cm-scrub-grid">
              <div class="cm-scrub-main">
                <fieldset class="cm-seg cm-seg-rank" data-seg>
                  <legend>{c.rings.picker.legend}</legend>
                  <span class="cm-pill" aria-hidden="true"></span>
                  {c.rings.picker.levels.map((name, i) => (
                    <label><input type="radio" name="cm-rank" value={i} checked={i === 0} aria-controls={`cm-step-${i}`} /><span>{name}</span></label>
                  ))}
                </fieldset>
                <ol class="cm-steps" data-steps>
                  {c.rings.steps.map((s, i) => (
                    <li class:list={["cm-step", { on: i === 0 }]} id={`cm-step-${i}`} data-step={i}>
                      <p class="kicker">{s.shows}</p>
                      <h3>{s.rank}</h3>
                      <p class="cm-line">{s.line}</p>
                      <dl class="cm-body">
                        <dt>{c.rings.labels.how}</dt><dd>{s.how}</dd>
                        <dt>{c.rings.labels.trusted}</dt><dd>{s.trusted}</dd>
                      </dl>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="cm-scrub-side">
                <div class="cm-view cm-square cm-drag" role="img" tabindex="0" aria-label={c.rings.picker.stageLabel.replace("{rank}", c.rings.steps[0].rank)} aria-describedby="cm-hint" data-view="rings" data-label={c.rings.picker.stageLabel}>
                  {RANKS.map((r, i) => (
                    <img src={pinSrc(r, "brass", 1200)} srcset={pinSet(r, "brass")} sizes="(max-width: 899px) min(64vw, 360px), min(620px, 46vw, 64vh)" alt="" width="1200" height="1200" loading="lazy" data-frame={i} class:list={{ on: i === 0 }} />
                  ))}
                  <canvas aria-hidden="true"></canvas>
                </div>
                <p id="cm-hint" class="cm-hint"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9a6 6 0 0 1 11.2-3M15 9a6 6 0 0 1-11.2 3M14.5 2.5v3.5H11M3.5 15.5V12H7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="cm-hint-drag">{c.rings.picker.hint}</span><span class="cm-hint-keys">{c.rings.picker.hintKeys}</span></p>
              </div>
            </div>
          </div>
        </div>
        <p class="wrap cm-note">{c.rings.names}</p>
      </section>

      <section id="status" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.status.kicker}</p>
            <h2 class="h2">{c.status.title}</h2>
            <p class="lede">{c.status.lede}</p>
          </div>
          <div class="jp-cols three cm-status reveal">
            {c.status.items.map((it) => (
              <div class="jp-col" data-status={it.label.toLowerCase()}><p class="label">{it.label}</p><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
        </div>
      </section>

      <JoinCover n={c.chapters[2].shot} id={c.chapters[2].id} title={c.chapters[2].title} />

      <!-- From your Lab to every Lab: the core, the same system one level up. -->
      <section id="core" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.core.kicker}</p>
            <h2 class="h2">{c.core.title}</h2>
            <p class="lede">{c.core.lede}</p>
          </div>
          <ol class="jp-steps reveal">
            {c.core.steps.map((s, i) => (
              <li class:list={{ milestone: i === c.core.steps.length - 1 }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
          <p class="cm-note">{c.core.note}</p>
        </div>
      </section>

      <section id="decides" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.decides.kicker}</p>
            <h2 class="h2">{c.decides.title}</h2>
          </div>
          <ul class="cm-list reveal">{c.decides.rules.map((g) => <li>{g}</li>)}</ul>
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{c.join.title}</h2>
          <p class="lede">{c.join.lede}</p>
          <div class="row">
            <a class="btn" href={apply}>{c.join.cta}</a>
          </div>
        </div>
      </section>
    </main>

    <script>
      import { mountView, gpuOk, kick, type RankPin } from "../../scripts/rankpin";
      import { openCovers } from "../../scripts/covers";

      const root = document.documentElement;
      const pin3d = document.querySelector<HTMLElement>("[data-pin3d]")!.dataset.pin3d!;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      const desktop = matchMedia("(hover: hover) and (pointer: fine) and (min-width: 900px)");
      const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

      /* ── nav: the header's button steps aside while the closing one is on screen ── */
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => {
        head.classList.toggle("cta-off", e.isIntersecting);
        cta.tabIndex = e.isIntersecting ? -1 : 0;
      }, { threshold: 0.25 }).observe(document.getElementById("join")!);

      // Chapter covers: opened as they come into view where scroll timelines aren't supported.
      openCovers();

      /* ── the way up: one level at a time ──
         Wide screens with motion: the stage holds still while you scroll, and the
         pin builds from one level to the next; picking a level scrolls there.
         Everywhere else, the levels are tabs. Either way the pin can be dragged. */
      const scrub = document.querySelector<HTMLElement>("[data-scrub]")!;
      const steps = [...scrub.querySelectorAll<HTMLElement>("[data-step]")];
      const frames = [...scrub.querySelectorAll<HTMLImageElement>("[data-frame]")];
      const view = scrub.querySelector<HTMLElement>('[data-view="rings"]')!;
      const seg = scrub.querySelector<HTMLFieldSetElement>("[data-seg]")!;
      const radios = [...seg.querySelectorAll<HTMLInputElement>('input[name="cm-rank"]')];
      const names = steps.map((st) => st.querySelector("h3")!.textContent || "");
      const scrubMode = () => desktop.matches && !reduce.matches && innerHeight >= 640;
      const scrubbing = () => root.hasAttribute("data-cm-scrub");
      let scrubP = 0, level = -1, seekUntil = 0;
      let pin: RankPin | null = null;

      // One pill slides behind the checked level (transform only).
      function placePill() {
        const pill = seg.querySelector<HTMLElement>(".cm-pill")!;
        const on = seg.querySelector<HTMLInputElement>("input:checked")!.closest("label")!;
        pill.style.width = `${on.offsetWidth}px`;
        pill.style.height = `${on.offsetHeight}px`;
        pill.style.transform = `translate(${on.offsetLeft}px, ${on.offsetTop}px)`;
      }
      placePill();
      new ResizeObserver(placePill).observe(seg);
      document.fonts?.ready.then(placePill);

      function show(i: number) {
        if (i === level) return;
        level = i;
        steps.forEach((st, k) => { st.classList.toggle("on", k === i); st.inert = k !== i; });
        frames.forEach((f, k) => f.classList.toggle("on", k === i));
        // While a picked level is scrolling into place, the picker already shows where it's going.
        if (!scrubbing() || performance.now() > seekUntil) { radios[i].checked = true; placePill(); }
        view.setAttribute("aria-label", view.dataset.label!.replace("{rank}", names[i]));
        if (pin && !scrubbing()) { pin.setRings(i, reduce.matches); kick(pin); }
      }

      function onScrub() {
        if (!scrubbing()) return;
        const r = scrub.getBoundingClientRect();
        const span = r.height - innerHeight;
        scrubP = span > 0 ? clamp(-r.top / span, 0, 1) : 0;
        // Four resting points, with a short hold at each.
        const x = scrubP * 3.4 - 0.2;
        show(clamp(Math.round(x), 0, 3));
        if (pin) { pin.setRingsExact(clamp(x, 0, 3)); kick(pin); }
      }
      const setScrubMode = () => {
        root.toggleAttribute("data-cm-scrub", scrubMode());
        if (scrubbing()) onScrub();
        else if (pin) { pin.setRings(level, true); kick(pin); }
      };
      let scrubQueued = false;
      addEventListener("scroll", () => { if (!scrubQueued) { scrubQueued = true; requestAnimationFrame(() => { scrubQueued = false; onScrub(); }); } }, { passive: true });
      addEventListener("resize", setScrubMode);
      desktop.addEventListener("change", setScrubMode);
      reduce.addEventListener("change", setScrubMode);
      show(0);
      setScrubMode();

      seg.addEventListener("change", (e) => {
        const i = Number((e.target as HTMLInputElement).value);
        placePill();
        if (!scrubbing()) { show(i); return; }
        // Scroll to that level's resting point; the pin builds on the way.
        const top = scrub.getBoundingClientRect().top + scrollY;
        seekUntil = performance.now() + 1200;
        scrollTo({ top: top + ((i + 0.2) / 3.4) * (scrub.offsetHeight - innerHeight), behavior: reduce.matches ? "auto" : "smooth" });
      });

      /* ── live 3D: desktop with a real GPU, after the page has loaded ── */
      // With "?pin3d" (testing), the views are reachable from the console.
      const debug: Record<string, RankPin> | null = new URLSearchParams(location.search).has("pin3d") ? ((window as unknown as { __cmPins: Record<string, RankPin> }).__cmPins = {}) : null;

      // The hero: turns toward a mouse or pen through a soft spring, and drifts when the pointer rests.
      let px = 0, py = 0, pt = 0;
      addEventListener("pointermove", (e) => { if (e.pointerType === "touch") return; px = e.clientX; py = e.clientY; pt = performance.now(); }, { passive: true });
      function follow(stage: HTMLElement, c: { s: number; t: number; vs: number; vt: number }, now: number, dt: number, t0: number): boolean {
        let ts: number, tt: number;
        if (pt && now - pt < 3500) {
          const r = stage.getBoundingClientRect();
          const nx = clamp((px - (r.left + r.width / 2)) / (Math.min(innerWidth, 1800) * 0.5), -1, 1);
          const ny = clamp((py - (r.top + r.height / 2)) / (Math.min(innerHeight, 1000) * 0.5), -1, 1);
          const soft = (v: number) => Math.sign(v) * Math.pow(Math.abs(v), 0.8);
          ts = soft(nx) < 0 ? -soft(nx) * 24 : soft(nx) * -36;
          tt = soft(ny) < 0 ? -soft(ny) * 14 : soft(ny) * -14;
        } else {
          const s = (now - t0) / 1000;
          ts = -6 + 15 * Math.sin((s * 2 * Math.PI) / 10);
          tt = -3 + 6 * Math.sin((s * 2 * Math.PI) / 7 + 1);
        }
        const k = 70, d = 2 * Math.sqrt(k) * 0.85;
        c.vs += ((ts - c.s) * k - c.vs * d) * dt; c.s += c.vs * dt;
        c.vt += ((tt - c.t) * k - c.vt * d) * dt; c.t += c.vt * dt;
        return Math.abs(ts - c.s) + Math.abs(tt - c.t) + Math.abs(c.vs) + Math.abs(c.vt) > 0.002;
      }

      function startHero() {
        const stage = document.querySelector<HTMLElement>('[data-view="hero"]')!;
        const pose = { s: 0, t: 0, vs: 0, vt: 0 }, t0 = performance.now();
        mountView(pin3d, stage.querySelector("canvas")!, stage, { metal: "brass", rings: 0 }, {
          frame(rp, dt, now) {
            const moving = follow(stage, pose, now, dt, t0);
            rp.pin.setPose(pose.s, pose.t);
            return rp.step(dt) || moving;
          },
        }).then((rp) => { if (debug) debug.hero = rp; }).catch(() => {});
      }

      function startWay() {
        const canvas = view.querySelector("canvas")!;
        // The resting angle comes from the scroll (three-quarters toward face-on as
        // the levels build) or a fixed pose. Dragging turns it from there, with
        // momentum; the arrow keys step 15 degrees; after a while it eases back.
        const REST = { s: -14, t: 6 };
        const off = { s: 0, t: 0, vs: 0, vt: 0 };
        let dragging = false, lastX = 0, lastY = 0, idle = 0;
        const samples: { x: number; y: number; t: number }[] = [];
        const nudge = () => { if (pin) kick(pin); };
        view.addEventListener("pointerdown", (e) => {
          dragging = true; view.setPointerCapture(e.pointerId); view.classList.add("grabbing", "used");
          lastX = e.clientX; lastY = e.clientY; samples.length = 0; off.vs = off.vt = 0; nudge();
        });
        view.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          const now = performance.now();
          off.s += (e.clientX - lastX) * 0.45;
          off.t = clamp(off.t + (e.clientY - lastY) * 0.3, -40, 40);
          samples.push({ x: e.clientX, y: e.clientY, t: now });
          while (samples.length && now - samples[0].t > 90) samples.shift();
          lastX = e.clientX; lastY = e.clientY; idle = 0; nudge();
        });
        const release = () => {
          if (!dragging) return;
          dragging = false; view.classList.remove("grabbing");
          // Release velocity from the last ~90 ms of movement, not the last event.
          if (samples.length > 1 && !reduce.matches) {
            const a = samples[0], b = samples[samples.length - 1], dt = Math.max(16, b.t - a.t) / 1000;
            off.vs = ((b.x - a.x) * 0.45) / dt;
            off.vt = ((b.y - a.y) * 0.3) / dt;
          }
          nudge();
        };
        view.addEventListener("pointerup", release);
        view.addEventListener("pointercancel", release);
        view.addEventListener("keydown", (e) => {
          const map: Record<string, [number, number]> = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -10], ArrowDown: [0, 10] };
          const mv = map[e.key];
          if (!mv) return;
          e.preventDefault();
          off.s += mv[0]; off.t = clamp(off.t + mv[1], -40, 40); idle = 0; off.vs = off.vt = 0;
          view.classList.add("used"); nudge();
        });
        mountView(pin3d, canvas, view, { metal: "brass", rings: level, zoom: 1.4 }, {
          frame(rp, dt) {
            let moving = dragging;
            if (!dragging) {
              // Coast: momentum that fades, then a slow return to the resting angle.
              const fr = Math.pow(0.94, dt / (1 / 60));
              off.s += off.vs * dt; off.t = clamp(off.t + off.vt * dt, -40, 40);
              off.vs *= fr; off.vt *= fr;
              if (Math.abs(off.vs) + Math.abs(off.vt) > 2) moving = true;
              else {
                off.vs = off.vt = 0;
                idle += dt;
                if (idle > 2.5 && !reduce.matches) {
                  // Unwind whole turns first, so it never spins the long way home.
                  const target = 360 * Math.round(off.s / 360);
                  const ds = target - off.s, dtl = -off.t;
                  if (Math.abs(ds) + Math.abs(dtl) > 0.05) { off.s += ds * Math.min(1, dt * 2.2); off.t += dtl * Math.min(1, dt * 2.2); moving = true; }
                  else { off.s = 0; off.t = 0; }
                }
              }
            }
            const base = scrubbing() ? { s: -26 + 22 * scrubP, t: 12 - 9 * scrubP } : REST;
            rp.pin.setPose(base.s + off.s, clamp(base.t + off.t, -40, 40));
            return rp.step(dt) || moving;
          },
        }).then((rp) => {
          pin = rp; if (debug) debug.way = rp;
          if (scrubbing()) onScrub(); else rp.setRings(level, true);
          kick(rp);
        }).catch(() => {});
      }

      const start = () => {
        if (!desktop.matches || reduce.matches || !gpuOk()) return;
        root.dataset.live = "";
        startHero();
        // The second mounts as it comes near, so the page never builds two pins at once.
        const near = (el: HTMLElement, fn: () => void) => {
          const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); fn(); } }, { rootMargin: "600px 0px" });
          io.observe(el);
        };
        near(view, startWay);
      };
      const later = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 1200));
      if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
    </script>
