---
/* /contributing/ — how The Labs is run and who it trusts with what: the
   ladder (Contributor → Role holder → Contributing Member → Reviewer →
   Committer → Maintainer), the public roles, how recognition happens, and
   who decides. The pins and buttons appear only as the symbol of each step.
   Unlisted (noindex, not linked from the program page): a working draft to
   share by link. /roles/, /pin/ and /contributors/ redirect here. Copy lives
   in content/site/contributing.json, from design/research/recognition-system.md. */
import "@fontsource-variable/geologica/wght.css";
import "../../styles/join.css";
import "../../styles/contributing.css";
import { u } from "../../lib/url";
import c from "../../../content/site/contributing.json";
import j from "../../../content/site/join.json";

const home = u("/");
const apply = u("/apply/");
const pageTitle = `${c.title} · The Upskilling Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#00141B" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={c.description} />
    <meta property="og:image" content={new URL(u("/contributing/og.jpg"), Astro.site)} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
  </head>
  <body class="jp cf">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head" data-head>
      <nav aria-label="Contributing">
        <a class="jp-brand" href="#top">
          <img src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" />
          <span class="wide-only">{c.nav.brand}</span>
        </a>
        <ul class="jp-links">
          <li><a class="navlink" href="#ladder" data-spy="ladder">{c.nav.ladder}</a></li>
          <li><a class="navlink" href="#roles" data-spy="roles given">{c.nav.roles}</a></li>
          <li><a class="navlink" href="#decides" data-spy="decides open">{c.nav.decides}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={home}>{c.nav.program}</a>
          <a class="btn" href={apply} data-head-cta><span class="wide-only">{c.nav.cta}</span><span class="narrow-only">{c.nav.ctaShort}</span></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="cf-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="wrap">
          <p class="kicker">{c.hero.kicker}</p>
          <h1>{c.hero.title}</h1>
          <p class="lede">{c.hero.lede}</p>
          <p class="cf-draft" data-draft><b>Draft.</b> {c.hero.draft}</p>
        </div>
      </section>

      <section id="ladder" class="jp-sec">
        <div class="wrap">
          <p class="kicker">{c.ladder.kicker}</p>
          <h2 class="h2">{c.ladder.title}</h2>
          <table class="cf-ladder">
            <thead><tr>{c.ladder.cols.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {c.ladder.rows.map((r) => (
                <tr data-row={r.id}>
                  <th scope="row" data-label={c.ladder.cols[0]}>{r.who}</th>
                  <td data-label={c.ladder.cols[1]}>{r.how}</td>
                  <td data-label={c.ladder.cols[2]}>{r.trusted}</td>
                  <td data-label={c.ladder.cols[3]} class="cf-symbol">
                    {r.image ? <img src={u(`/${r.image}`)} alt="" width="48" height="48" loading="lazy" /> : <span class="cf-nosym" aria-hidden="true"></span>}
                    <span>{r.symbol}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="cf-note">{c.ladder.note}</p>
        </div>
      </section>

      <section id="roles" class="jp-sec">
        <div class="wrap">
          <p class="kicker">{c.roles.kicker}</p>
          <h2 class="h2">{c.roles.title}</h2>
          <p class="lede">{c.roles.lede}</p>
          <ul class="cf-roles">
            {c.roles.items.map((r) => (
              <li class:list={{ now: r.now }}><b>{r.name}</b><span>{r.does}</span>{r.now && <em>{c.roles.open}</em>}</li>
            ))}
          </ul>
        </div>
      </section>

      <section id="given" class="jp-sec">
        <div class="wrap">
          <p class="kicker">{c.given.kicker}</p>
          <h2 class="h2">{c.given.title}</h2>
          <ol class="jp-steps cf-steps">
            {c.given.steps.map((s, i) => (
              <li class:list={{ milestone: i === c.given.steps.length - 1 }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="decides" class="jp-sec">
        <div class="wrap">
          <p class="kicker">{c.decides.kicker}</p>
          <h2 class="h2">{c.decides.title}</h2>
          <ul class="cf-list">{c.decides.rules.map((r) => <li>{r}</li>)}</ul>
        </div>
      </section>

      <section id="open" class="jp-sec cf-last">
        <div class="wrap">
          <p class="kicker">{c.open.kicker}</p>
          <h2 class="h2">{c.open.title}</h2>
          <ul class="cf-list muted">{c.open.items.map((q) => <li>{q}</li>)}</ul>
        </div>
      </section>
    </main>

    <footer class="jp-foot">
      <div class="wrap">
        <div class="col">
          <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
          <p>{j.footer.legal}</p>
          <p>{j.footer.rights}</p>
          <p><a class="textlink" href={home}>{c.footer.program} →</a></p>
          {c.placeholder && <p class="ph">[PLACEHOLDER] {c.footer.source}</p>}
        </div>
      </div>
    </footer>

    <script>
      // Nav: compact once you scroll, and mark the section in view.
      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      const links = [...head.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const order = ["ladder", "roles", "given", "decides", "open"].map((id) => document.getElementById(id)!);
      let queued = false;
      const spy = () => {
        queued = false;
        const line = innerHeight * 0.35;
        const current = order.filter((el) => el.getBoundingClientRect().top <= line).pop()?.id ?? "";
        links.forEach((a) => (a.dataset.spy!.split(" ").includes(current) ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(spy); } }, { passive: true });
      spy();
    </script>
  </body>
</html>
