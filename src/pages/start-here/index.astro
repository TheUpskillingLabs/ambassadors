---
/* Start Here is one page: the job, the minimum, then on to Know the Labs. */
import GuidePage from "../../components/GuidePage.astro";
import { sectionPages } from "../../lib/content";
import { u } from "../../lib/url";
import sections from "../../../content/site/sections.json";
const pages = await sectionPages("start-here");
---
<GuidePage entry={pages[0]} siblings={pages} sectionTitle={sections.startHere.title} sectionHref={u("/")} nav="start-here" after={{ href: u("/know-the-labs/what-we-are/"), title: sections.knowTheLabs.title }} />
