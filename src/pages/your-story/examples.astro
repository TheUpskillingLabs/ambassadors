---
import { u } from "../../lib/url";
import { getEntry } from "astro:content";
import { sectionPages } from "../../lib/content";
import GuidePage from "../../components/GuidePage.astro";
import { t } from "../../lib/i18n";
const entry = (await getEntry("pages", "your-story/examples"))!;
const siblings = await sectionPages("your-story");
---
<GuidePage entry={entry} siblings={siblings} sectionTitle={t("story.title")} sectionHref={u("/your-story/")} nav="your-story" />
