---
/* Your Story — four short answers build a 30-second why, live. Once the
   ambassador edits the draft, it's theirs and the answers stop rewriting
   it. A word count shows the spoken length (65–85 words is about 30 s).
   Everything stays in localStorage. */
import { getEntry } from "astro:content";
import StepPage from "../../components/StepPage.astro";
import { t } from "../../lib/i18n";
import story from "../../../content/site/story.json";
const entry = (await getEntry("steps", "your-story"))!;
---
<StepPage entry={entry}>
  <form class="story" data-story onsubmit="return false"
    data-short={t("story.bandShort")} data-ok={t("story.bandOk")} data-long={t("story.bandLong")}>
    {story.prompts.map((p) => (
      <div class="field">
        <label for={`q-${p.id}`}>{p.label}</label>
        <textarea id={`q-${p.id}`} rows="2" placeholder={p.example} data-answer={p.id}></textarea>
      </div>
    ))}
    <div class="field draft">
      <label for="draft">{t("story.draftLabel")}</label>
      <textarea id="draft" rows="6" data-draft aria-describedby="wordband"></textarea>
      <p class="wordband-text" id="wordband" aria-live="polite"><span><b data-words>0</b> {t("story.words")} ≈ <b data-seconds>0</b> {t("story.seconds")}</span> <span data-band-msg></span></p>
    </div>
  </form>
  <script>
    import { story, wordStats } from "../../lib/store";
    const form = document.querySelector<HTMLFormElement>("[data-story]")!;
    const answers = Array.from(form.querySelectorAll<HTMLTextAreaElement>("[data-answer]"));
    const draft = form.querySelector<HTMLTextAreaElement>("[data-draft]")!;
    const d = form.dataset;
    const built = () => answers.map((a) => a.value.trim()).filter(Boolean).map((v) => (/[.?!]$/.test(v) ? v : v + ".")).join(" ");

    const s0 = story.get();
    answers.forEach((a) => (a.value = s0.answers[a.dataset.answer!] ?? ""));
    draft.value = s0.draft || built();
    let edited = Boolean(s0.draft.trim()) && s0.draft !== built();

    function paint() {
      const s = wordStats(draft.value);
      form.querySelector("[data-words]")!.textContent = String(s.words);
      form.querySelector("[data-seconds]")!.textContent = String(s.seconds);
      form.querySelector("[data-band-msg]")!.textContent = s.words === 0 ? "" : s.words < 65 ? d.short! : s.words <= 85 ? d.ok! : d.long!;
    }
    form.addEventListener("input", (e) => {
      if (e.target === draft) edited = Boolean(draft.value.trim());
      else if (!edited) draft.value = built();
      story.save({ answers: Object.fromEntries(answers.map((a) => [a.dataset.answer!, a.value])), draft: draft.value });
      paint();
    });
    paint();
  </script>
</StepPage>
