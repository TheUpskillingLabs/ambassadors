---
/* /contributors/ — how someone becomes a Contributor: a button for every area
   of The Labs in two tiers (Oriented, then Practiced), the pin for both tiers
   in every core area, and the pinning at the quarterly regional summits.
   Same standalone dark look as the program page (join.css). Copy lives in
   content/site/contributors.json; the roll in data/contributors.json. */
import "@fontsource-variable/geologica/wght.css";
import "../../styles/join.css";
import { u } from "../../lib/url";
import c from "../../../content/site/contributors.json";
import j from "../../../content/site/join.json";
import { contributors } from "../../lib/contributors";

const media = (f: string) => u(`/join/${f}`);
const home = u("/");
const apply = u("/apply/");
const open = Math.max(0, c.areas.coreSlots - c.areas.core.length);
const pageTitle = `${c.title} · The Upskilling Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#00141B" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={c.description} />
    <meta property="og:image" content={new URL(media("pin.webp"), Astro.site)} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={media("pin-800.webp")} fetchpriority="high" />
  </head>
  <body class="jp cp">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head" data-head>
      <nav aria-label="Contributors">
        <a class="jp-brand" href="#top">
          <img src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" />
          <span class="wide-only">{c.nav.brand}</span>
        </a>
        <ul class="jp-links">
          <li><a class="navlink" href="#buttons" data-spy="buttons areas">{c.nav.buttons}</a></li>
          <li><a class="navlink" href="#pin" data-spy="pin ceremony life">{c.nav.pin}</a></li>
          <li><a class="navlink" href="#roll" data-spy="roll faq">{c.nav.roll}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={home}>{c.nav.program}</a>
          <a class="btn" href={apply} data-head-cta><span class="wide-only">{c.nav.cta}</span><span class="narrow-only">{c.nav.ctaShort}</span></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="cp-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="wrap cp-hero-grid">
          <div>
            <p class="kicker rise">{c.hero.kicker}</p>
            <h1 class="rise">{c.hero.title}</h1>
            <p class="lede rise">{c.hero.lede}</p>
          </div>
          <img class="cp-hero-pin pinin" src={media("pin-800.webp")} alt={c.hero.alt} width="800" height="800" fetchpriority="high" />
        </div>
      </section>

      <section id="buttons" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.tiers.kicker}</p>
            <h2 class="h2">{c.tiers.title}</h2>
            <p class="lede">{c.tiers.lede}</p>
          </div>
          <div class="cp-tiers reveal">
            {c.tiers.items.map((t) => (
              <div class:list={["cp-tier", t.id]}>
                <div class="cp-button" aria-hidden="true">
                  <img src={media("button-card.webp")} alt="" width="180" height="180" loading="lazy" />
                </div>
                <div><p class="kicker">{t.n} · {t.label}</p><h3>{t.title}</h3><p>{t.body}</p></div>
              </div>
            ))}
          </div>
          <p class="cp-note reveal">{c.tiers.mark}</p>
        </div>
      </section>

      <section id="areas" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.areas.kicker}</p>
            <h2 class="h2">{c.areas.title}</h2>
            <p class="lede">{c.areas.lede}</p>
          </div>
          <ul class="cp-areas reveal">
            {c.areas.core.map((a) => (
              <li class="cp-area">
                <h3>{a.name}</h3>
                <dl>
                  <dt>{c.tiers.items[0].label}</dt><dd>{a.oriented}</dd>
                  <dt>{c.tiers.items[1].label}</dt><dd>{a.practiced}</dd>
                </dl>
                <a class="textlink" href={home}>{a.link} →</a>
              </li>
            ))}
            {Array.from({ length: open }, () => (
              <li class="cp-area open"><p>{c.areas.open}</p></li>
            ))}
          </ul>
          <p class="cp-note reveal">{c.areas.electives}</p>
        </div>
      </section>

      <section id="pin" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.pin.kicker}</p>
            <h2 class="h2">{c.pin.title}</h2>
          </div>
          <ol class="jp-steps cp-steps reveal">
            {c.pin.steps.map((s, i) => (
              <li class:list={{ milestone: s.milestone }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="ceremony" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.ceremony.kicker}</p>
            <h2 class="h2">{c.ceremony.title}</h2>
            <p class="lede">{c.ceremony.lede}</p>
          </div>
          <div class="jp-cols four reveal">
            {c.ceremony.moments.map((m) => (
              <div class="jp-col"><p class="label">{m.label}</p><p>{m.body}</p></div>
            ))}
          </div>
          <p class="cp-note reveal">{c.ceremony.first}</p>
        </div>
      </section>

      <section id="life" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.life.kicker}</p>
            <h2 class="h2">{c.life.title}</h2>
          </div>
          <div class="jp-cols three reveal">
            {c.life.items.map((it) => (
              <div class="jp-col"><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section id="roll" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.roll.kicker}</p>
            <h2 class="h2">{c.roll.title}</h2>
          </div>
          {contributors.length === 0
            ? <p class="lede reveal" data-roll-empty>{c.roll.empty}</p>
            : (
              <ol class="cp-roll reveal" aria-label={c.roll.label.replace("{n}", String(contributors.length))}>
                {contributors.map((p) => (
                  <li><b>{p.name}</b>{p.region && <span>{p.region}</span>}{p.pinned && <span>{p.pinned}</span>}{p.alum && <span class="alum">{c.roll.alum}</span>}</li>
                ))}
              </ol>
            )}
        </div>
      </section>

      <section id="faq" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.faq.kicker}</p>
            <h2 class="h2">{c.faq.title}</h2>
          </div>
          <div class="jp-faq reveal">
            {c.faq.items.map((f) => (
              <details><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>
            ))}
          </div>
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{c.join.title}</h2>
          <p class="lede">{c.join.lede}</p>
          <div class="row">
            <a class="btn" href={apply}>{c.join.cta}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="jp-foot">
      <div class="wrap">
        <div class="col">
          <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
          <p>{j.footer.legal}</p>
          <p>{j.footer.rights}</p>
          <p><a class="textlink" href={home}>{c.footer.program} →</a> · {c.footer.renders}</p>
          {c.placeholder && <p class="ph">[PLACEHOLDER] draft: the core areas, the Practiced mark, and the ceremony's run of show are still to be set.</p>}
        </div>
      </div>
    </footer>

    <script>
      // Nav: compact once you scroll; the link for the section in view is
      // marked; the header button steps aside at the join section.
      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => {
        head.classList.toggle("cta-off", e.isIntersecting);
        cta.tabIndex = e.isIntersecting ? -1 : 0;
      }, { threshold: 0.25 }).observe(document.getElementById("join")!);
      const links = [...head.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const order = ["buttons", "areas", "pin", "ceremony", "life", "roll", "faq", "join"].map((id) => document.getElementById(id)!);
      let queued = false;
      const spy = () => {
        queued = false;
        const line = innerHeight * 0.35;
        const current = order.filter((el) => el.getBoundingClientRect().top <= line).pop()?.id ?? "";
        links.forEach((a) => (a.dataset.spy!.split(" ").includes(current) ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(spy); } }, { passive: true });
      spy();
    </script>
  </body>
</html>
