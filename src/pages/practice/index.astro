---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PracticeDeck from "../../components/PracticeDeck.astro";
import { t } from "../../lib/i18n";
---
<Base title={t("practice.title")} nav="playbooks">
  <PageHeader back={{ href: "/playbooks/", label: t("nav.playbooks") }} title={t("practice.title")} lede={t("practice.lede")} />
  <div class="wrap page-body">
    <PracticeDeck />
  </div>
  <script>
    // ?audience=workshop / ?mode=room preselect a filter.
    const q = new URLSearchParams(location.search);
    for (const key of ["mode", "audience"]) {
      const v = q.get(key);
      if (v) document.querySelector<HTMLButtonElement>(`[data-filter="${key}"][data-value="${CSS.escape(v)}"]`)?.click();
    }
  </script>
</Base>
