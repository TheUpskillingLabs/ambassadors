---
/* /events/ — the calendar: everything dated, coming up first, then what's
   been. Each event has its own page (/events/<id>/). Words shared with
   content/site/workshops.json. */
import Site from "../../layouts/Site.astro";
import "../../styles/page.css";
import { getCollection } from "astro:content";
import { joinHref } from "../../lib/nav";
import { upcoming, startsAt } from "../../lib/dates";
import EventList from "../../components/EventList.astro";
import w from "../../../content/site/workshops.json";

const labs = new Map((await getCollection("labs")).map((l) => [l.id, l]));
const all = await getCollection("events");
const now = new Date();
const next = upcoming(all, now);
const past = all.filter((e) => e.data.meta.status === "live" && startsAt(e.data).getTime() <= now.getTime()).sort((a, b) => startsAt(b.data).getTime() - startsAt(a.data).getTime());
const title = "Workshops and events";
const local = [{ label: "Coming up", href: "#coming", spy: "coming" }, { label: "What's been", href: "#past", spy: "past" }];
---
<Site title={`${title} · The Upskilling Labs`} description="Every workshop and event at The Labs: free, hands-on, in person at the library and some online." bodyClass="pg" local={local}>
    <main id="main">
      <section id="top" class="pg-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <p class="kicker rise">{w.hero.kicker}</p>
        <h1 class="rise d1">{title}</h1>
        <p class="lede rise d2">Free, hands-on, open to anyone. Save a seat from your account.</p>
      </section>
      <section id="coming" class="pg-sec">
        <p class="kicker">{w.coming.kicker}</p>
        <h2 class="h2">{w.coming.title}</h2>
        <EventList events={next} labs={labs} empty={w.coming.empty} />
      </section>
      {past.length > 0 && <section id="past" class="pg-sec">
        <p class="kicker">What's been</p>
        <h2 class="h2">Recently.</h2>
        <EventList events={past} labs={labs} past />
      </section>}
      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{w.join.title}</h2>
          <p class="lede">{w.join.lede}</p>
          <div class="row"><a class="btn" href={joinHref("learn")}>{w.join.cta}</a></div>
        </div>
      </section>
    </main>
    <script>
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => { head.classList.toggle("cta-off", e.isIntersecting); cta.tabIndex = e.isIntersecting ? -1 : 0; }, { threshold: 0.25 }).observe(document.getElementById("join")!);
    </script>
</Site>
