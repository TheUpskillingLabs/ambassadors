---
import { u } from "../../../lib/url";
import Account from "../../../layouts/Account.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { t } from "../../../lib/i18n";
import { guideHome } from "../../../lib/content";
---
<Account title={t("offline.title")}>
  <PageHeader title={t("offline.title")} lede={t("offline.lede")} />
  <div class="wrap page-body">
    <div class="btn-row">
      <a class="btn btn-teal" href={guideHome}>{t("nav.home")}</a>
      <a class="btn btn-ghost" href={u("/account/present/")}>{t("nav.present")}</a>
    </div>
  </div>
</Account>
