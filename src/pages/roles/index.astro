---
/* /roles/ — roles and recognition, explained: the public roles (Upskiller /
   Builder, Poderator, Mentor, Ambassador) and the merit ranks (Reviewer,
   Committer, Maintainer) with how nomination works. Unlisted (noindex, not
   linked anywhere): a working draft to share by link. Only the ambassador
   program and its button exist today. Same standalone dark look as the
   program page (join.css). Copy lives in content/site/roles.json, from
   design/research/recognition-system.md; the register in data/register.json.
   /pin/ and /contributors/ redirect here. */
import "@fontsource-variable/geologica/wght.css";
import "../../styles/join.css";
import { u } from "../../lib/url";
import c from "../../../content/site/roles.json";
import j from "../../../content/site/join.json";
import { register } from "../../lib/register";

const media = (f: string) => u(`/join/${f}`);
const home = u("/");
const apply = u("/apply/");
const pageTitle = `${c.title} · The Upskilling Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#00141B" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={c.description} />
    <meta property="og:image" content={new URL(media("pin.webp"), Astro.site)} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={media("pin-800.webp")} fetchpriority="high" />
  </head>
  <body class="jp cp">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head" data-head>
      <nav aria-label="Roles and recognition">
        <a class="jp-brand" href="#top">
          <img src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" />
          <span class="wide-only">{c.nav.brand}</span>
        </a>
        <ul class="jp-links">
          <li><a class="navlink" href="#roles" data-spy="two roles open">{c.nav.roles}</a></li>
          <li><a class="navlink" href="#ranks" data-spy="ranks">{c.nav.ranks}</a></li>
          <li><a class="navlink" href="#nomination" data-spy="nomination seats guardrails questions register">{c.nav.nomination}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={home}>{c.nav.program}</a>
          <a class="btn" href={apply} data-head-cta><span class="wide-only">{c.nav.cta}</span><span class="narrow-only">{c.nav.ctaShort}</span></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="cp-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="wrap cp-hero-grid">
          <div>
            <p class="kicker rise">{c.hero.kicker}</p>
            <h1 class="rise">{c.hero.title}</h1>
            <p class="lede rise">{c.hero.lede}</p>
            <p class="cp-draft rise" data-draft><b>Draft.</b> {c.draft}</p>
          </div>
          <img class="cp-hero-pin pinin" src={media("pin-800.webp")} alt={c.hero.alt} width="800" height="800" fetchpriority="high" />
        </div>
      </section>

      <section id="two" class="jp-sec">
        <div class="wrap">
          <div>
            <p class="kicker">{c.two.kicker}</p>
            <h2 class="h2">{c.two.title}</h2>
          </div>
          <div class="jp-cols three cp-two reveal">
            {c.two.items.map((it) => (
              <div class="jp-col"><p class="label">{it.label}</p><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
          <p class="cp-note reveal">{c.two.bridge}</p>
        </div>
      </section>

      <section id="roles" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.roles.kicker}</p>
            <h2 class="h2">{c.roles.title}</h2>
            <p class="lede">{c.roles.lede}</p>
          </div>
          <ul class="cp-rolecards reveal">
            {c.roles.items.map((r) => (
              <li class:list={["cp-rolecard", { now: r.now }]} data-role={r.id}>
                <div class="cp-rolehead">
                  {r.now
                    ? <img src={media("button-card.webp")} alt="The Ambassador button" width="72" height="72" loading="lazy" />
                    : <span class="cp-slot" aria-hidden="true"></span>}
                  <div><h3>{r.name}</h3><p class="cp-status">{r.status}</p></div>
                </div>
                <p>{r.does}</p>
                <dl>
                  <dt>{c.roles.labels.trained}</dt><dd>{r.trained}</dd>
                  <dt>{c.roles.labels.practitioner}</dt><dd>{r.practitioner}</dd>
                </dl>
              </li>
            ))}
          </ul>
          <p class="cp-note reveal">{c.roles.buttonNote}</p>
          <p class="cp-note reveal">{c.roles.notRoles}</p>
        </div>
      </section>

      <section id="open" class="jp-sec">
        <div class="wrap reveal">
          <p class="kicker">{c.open.kicker}</p>
          <h2 class="h2">{c.open.title}</h2>
          <p class="lede">{c.open.body}</p>
        </div>
      </section>

      <section id="ranks" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.ranks.kicker}</p>
            <h2 class="h2">{c.ranks.title}</h2>
            <p class="lede">{c.ranks.lede}</p>
          </div>
          <ol class="cp-ranks reveal">
            {c.ranks.items.map((r) => (
              <li class="cp-rank" data-rank={r.id}>
                <div class="cp-plates" data-plates={r.plates} role="img" aria-label={c.ranks.alt[r.id as keyof typeof c.ranks.alt]}>
                  <img src={media("pin-card.webp")} alt="" width="180" height="180" loading="lazy" />
                </div>
                <p class="kicker">{r.shows}</p>
                <h3>{r.name}</h3>
                <dl class="cp-rankdl">
                  <dt>{c.ranks.labels.recognizes}</dt><dd>{r.recognizes}</dd>
                  <dt>{c.ranks.labels.nominated}</dt><dd>{r.nominated}</dd>
                  <dt>{c.ranks.labels.can}</dt><dd>{r.can}</dd>
                </dl>
              </li>
            ))}
          </ol>
          <p class="cp-metal reveal">{c.ranks.metal}</p>
          <div class="cp-roles reveal">
            <p class="kicker">{c.ranks.areasLabel}</p>
            <ul>{c.ranks.areas.map((a) => <li>{a}</li>)}</ul>
            <p>{c.ranks.areasNote}</p>
          </div>
          <p class="cp-note reveal">{c.ranks.names}</p>
        </div>
      </section>

      <section id="nomination" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.nomination.kicker}</p>
            <h2 class="h2">{c.nomination.title}</h2>
            <p class="lede">{c.nomination.lede}</p>
          </div>
          <ol class="jp-steps cp-nsteps reveal">
            {c.nomination.steps.map((s, i) => (
              <li class:list={{ milestone: i === c.nomination.steps.length - 1 }}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="seats" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.seats.kicker}</p>
            <h2 class="h2">{c.seats.title}</h2>
          </div>
          <div class="jp-cols three reveal">
            {c.seats.items.map((it) => (
              <div class="jp-col"><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section id="guardrails" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.guardrails.kicker}</p>
            <h2 class="h2">{c.guardrails.title}</h2>
          </div>
          <ul class="cp-list reveal">{c.guardrails.items.map((g) => <li>{g}</li>)}</ul>
        </div>
      </section>

      <section id="questions" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.questions.kicker}</p>
            <h2 class="h2">{c.questions.title}</h2>
          </div>
          <ul class="cp-list muted reveal">{c.questions.items.map((q) => <li>{q}</li>)}</ul>
        </div>
      </section>

      <section id="register" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{c.register.kicker}</p>
            <h2 class="h2">{c.register.title}</h2>
          </div>
          {register.length === 0
            ? <p class="lede reveal" data-register-empty>{c.register.empty}</p>
            : (
              <ol class="cp-roll reveal" aria-label={c.register.label.replace("{n}", String(register.length))}>
                {register.map((e) => (
                  <li><span class="num">{e.number}</span><b>{e.name}</b><span>{e.rank}</span>{e.region && <span>{e.region}</span>}{e.status === "emeritus" && <span class="alum">{c.register.emeritus}</span>}</li>
                ))}
              </ol>
            )}
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{c.join.title}</h2>
          <p class="lede">{c.join.lede}</p>
          <div class="row">
            <a class="btn" href={apply}>{c.join.cta}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="jp-foot">
      <div class="wrap">
        <div class="col">
          <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
          <p>{j.footer.legal}</p>
          <p>{j.footer.rights}</p>
          <p><a class="textlink" href={home}>{c.footer.program} →</a></p>
          <p>{c.footer.renders}</p>
          {c.placeholder && <p class="ph">[PLACEHOLDER] {c.footer.source}</p>}
        </div>
      </div>
    </footer>

    <script>
      // Nav: compact once you scroll; the link for the section in view is
      // marked; the header button steps aside at the join section.
      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => {
        head.classList.toggle("cta-off", e.isIntersecting);
        cta.tabIndex = e.isIntersecting ? -1 : 0;
      }, { threshold: 0.25 }).observe(document.getElementById("join")!);
      const links = [...head.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const order = ["two", "roles", "open", "ranks", "nomination", "seats", "guardrails", "questions", "register", "join"].map((id) => document.getElementById(id)!);
      let queued = false;
      const spy = () => {
        queued = false;
        const line = innerHeight * 0.35;
        const current = order.filter((el) => el.getBoundingClientRect().top <= line).pop()?.id ?? "";
        links.forEach((a) => (a.dataset.spy!.split(" ").includes(current) ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(spy); } }, { passive: true });
      spy();
    </script>
  </body>
</html>
