---
import { u } from "../../lib/url";
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { t } from "../../lib/i18n";
import deck from "../../../content/site/deck.json";
const entry = (await getEntry("pages", "deck/customize"))!;
const { Content } = await render(entry);
const updated = new Date(deck.templateLastUpdated + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Base title={entry.data.title} description={entry.data.summary} nav="deck">
  <PageHeader back={{ href: u("/deck/"), label: t("deck.title") }} eyebrow={t("deck.title")} title={entry.data.title} readTime={entry.data.readTime} placeholder={entry.data.placeholder} />
  <div class="wrap page-body">
    <section class="summary-box">
      <h2 class="lbl lbl-teal">{t("page.inThirtySeconds")}</h2>
      <p class="t-lede">{entry.data.summary}</p>
    </section>
    <div class="btn-row">
      <a class="btn btn-teal" href={deck.templateUrl} rel="noopener" target="_blank">{t("deck.template")}</a>
      <a class="btn btn-ghost" href={deck.assetsUrl} rel="noopener" target="_blank">{t("deck.assets")}</a>
    </div>
    <p class="t-small">{t("deck.lastUpdated")}: {updated}. {t("deck.copyFresh")}</p>
    <div class="prose"><Content /></div>
    <section class="tpl">
      <h2 class="tpl-h">{t("deck.proofPoints")}</h2>
      <ul class="watch">{deck.proofSet.map((p) => <li><b>{p.stat}</b> {p.label}</li>)}</ul>
    </section>
  </div>
</Base>
