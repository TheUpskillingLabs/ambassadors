---
/* /problems/ — the problem situations each cycle works on, from
   content/problems (owners named only with consent), and the door for
   bringing one: the account, with path=problem. Copy in
   content/site/problems.json. */
import Site from "../../layouts/Site.astro";
import "../../styles/page.css";
import { getCollection } from "astro:content";
import { u } from "../../lib/url";
import { joinHref } from "../../lib/nav";
import { nextShowcase } from "../../lib/dates";
import { fill, longDate } from "../../lib/takepart";
import p from "../../../content/site/problems.json";

const now = new Date();
const problems = (await getCollection("problems")).filter((x) => x.data.meta.status === "live").sort((a, b) => b.data.meta.review.localeCompare(a.data.meta.review));
const cycles = new Map((await getCollection("cycles")).map((c) => [c.id, c]));
const coming = nextShowcase([...cycles.values()], now);
const empty = coming ? fill(p.empty.before, { title: coming.data.title, showcase: longDate(coming.data.showcase) }) : p.empty.after;
const status = p.problem.status as Record<string, string>;
const local = [
  { label: p.list.kicker, href: "#list", spy: "list" },
  { label: p.bring.kicker, href: "#bring", spy: "bring" },
];
---
<Site title={`${p.title} · The Upskilling Labs`} description={p.description} bodyClass="pg" local={local}>
    <main id="main">
      <section id="top" class="pg-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <p class="kicker rise">{p.hero.kicker}</p>
        <h1 class="rise d1">{p.hero.title}</h1>
        <p class="lede rise d2">{p.hero.lede}</p>
      </section>

      <section id="list" class="pg-sec">
        <p class="kicker">{p.list.kicker}</p>
        {problems.length ? (
          <ul class="pg-labs">
            {problems.map((x) => (
              <li>
                <span class="stage">{status[x.data.status]}{x.data.cycle && cycles.get(x.data.cycle) && ` · ${cycles.get(x.data.cycle)!.data.title}`}</span>
                <h3><a href={u(`/problems/${x.id}/`)}>{x.data.title}</a></h3>
                <p>{x.data.affects}</p>
                <a class="textlink" href={u(`/problems/${x.id}/`)}>{p.problem.kicker} →</a>
              </li>
            ))}
          </ul>
        ) : <p class="pg-empty">{empty}</p>}
      </section>

      <section id="bring" class="pg-sec">
        <p class="kicker">{p.bring.kicker}</p>
        <h2 class="h2">{p.bring.title}</h2>
        <p>{p.bring.body}</p>
        <div class="pg-start">
          <a class="btn" href={joinHref("problem")}>{p.bring.cta}</a>
          <p>{p.bring.note}</p>
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{p.join.title}</h2>
          <p class="lede">{p.join.lede}</p>
          <div class="row"><a class="btn" href={joinHref("build")}>{p.join.cta}</a></div>
        </div>
      </section>
    </main>
    <script>
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => { head.classList.toggle("cta-off", e.isIntersecting); cta.tabIndex = e.isIntersecting ? -1 : 0; }, { threshold: 0.25 }).observe(document.getElementById("join")!);
    </script>
</Site>
