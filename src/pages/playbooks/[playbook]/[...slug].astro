---
/* The playbook page template — every page in both playbooks:
   title · read time · In 30 seconds · why · shape · examples (not lines) ·
   watch out for · try it · more detail (collapsed) · Done · Next.
   The summary comes first so a returning reader can stop there. */
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ProgressMeter from "../../../components/ProgressMeter.astro";
import StoryCard from "../../../components/StoryCard.astro";
import AskList from "../../../components/AskList.astro";
import Includes from "../../../components/Includes.astro";
import PracticeDeck from "../../../components/PracticeDeck.astro";
import NextBar from "../../../components/NextBar.astro";
import { t } from "../../../lib/i18n";
import { playbookPages, playbookHref, playbookProgressId, pageSlug, COVERS } from "../../../lib/content";
import sections from "../../../../content/site/sections.json";

export async function getStaticPaths() {
  const out = [];
  for (const pb of ["conversation", "room"] as const) {
    const pages = await playbookPages(pb);
    for (const entry of pages) {
      const slug = pageSlug(entry.id);
      out.push({ params: { playbook: pb, slug: entry.data.order === 1 ? undefined : slug }, props: { entry, pages } });
    }
  }
  return out;
}

const { entry, pages } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const book = sections.playbooks.items[d.playbook];
const i = pages.findIndex((p) => p.id === entry.id);
const link = (p?: typeof entry) => (p ? { href: playbookHref(p), title: p.data.navLabel ?? p.data.title } : null);
const isOverview = i === 0;
const pid = playbookProgressId(entry);
const hasBody = Boolean(entry.body?.trim());
---
<Base title={isOverview ? d.title : `${d.title} · ${book.title}`} description={d.summary} nav="playbooks">
  <PageHeader
    back={isOverview ? { href: "/playbooks/", label: t("nav.playbooks") } : { href: playbookHref(pages[0]), label: book.title }}
    eyebrow={t("page.stepOf", { section: book.title, n: i + 1, total: pages.length })}
    title={d.title}
    readTime={d.readTime}
    placeholder={d.placeholder}
    cover={{ variant: COVERS[d.playbook], name: d.playbook }}
  >
    <ProgressMeter ids={pages.map(playbookProgressId)} current={i} />
  </PageHeader>

  <article class="wrap page-body" data-page-id={pid}>
    <section class="panel lead">
      <h2 class="block-h">{t("page.inThirtySeconds")}</h2>
      <p class="t-lede">{d.summary}</p>
      <p class="lead-why"><b>{t("page.why")}:</b> {d.why}</p>
    </section>

    {d.practice ? <PracticeDeck mode={d.playbook} /> : (
      <>
        <section class="block">
          <h2 class="block-h">{t("page.shape")}</h2>
          <ol class="stepper">{d.shape.map((s) => <li>{s}</li>)}</ol>
        </section>

        <section class="block">
          <h2 class="block-h">{t("page.examples")}</h2>
          <ul class="quotes">{d.examples.map((e) => <li>{e}</li>)}</ul>
        </section>

        {d.showInvite && <AskList />}
        {d.showStory && <StoryCard />}
        {hasBody && <div class="prose"><Content /></div>}
        <Includes include={d.include} />

        <section class="block">
          <h2 class="block-h">{t("page.watchOutFor")}</h2>
          <ul class="bullets">{d.watchOutFor.map((w) => <li>{w}</li>)}</ul>
        </section>

        <section class="tryit">
          <h2 class="block-h">{t("page.tryIt")}</h2>
          <p class="t-h4">{d.tryIt}</p>
        </section>
      </>
    )}

    <NextBar id={pid} next={link(pages[i + 1])} prev={link(pages[i - 1])} up={{ href: playbookHref(pages[0]), title: book.title }} />
  </article>
</Base>
