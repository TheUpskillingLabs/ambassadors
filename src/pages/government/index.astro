---
/* /government/ — For government: what a government can do with or through The
   Labs. Unlisted draft (noindex), linked from the home page's footer.

   One idea a section, a line at a time, for the people who decide (workforce
   boards, economic development, agencies, library systems):
   - the hero: "Upskilling that adds up.", with the world's own picture of
     The Labs (every Lab on one network) beside it;
   - what it adds up to: work, wages, wealth, in The Labs' meaning;
   - how it works: workshops, the open cycle, and sector cohorts inside it;
   - five ways to work with us, sector cohorts first;
   - showing it works, how to start, and the details for procurement;
   - the one action: a conversation (procurement staff don't make accounts),
     with a line for residents pointing to the account.

   The look is the program page's (src/styles/join.css: ink, Geologica,
   hairline rules, teal labels) with this page's layout in government.css.
   Copy lives in content/site/government.json. */
import "@fontsource-variable/geologica/wght.css";
import "../../styles/join.css";
import "../../styles/government.css";
import { u } from "../../lib/url";
import g from "../../../content/site/government.json";
import h from "../../../content/site/home.json";

const L = h.links;
const home = u("/");
const art = u("/join/hub-poster.webp");
const pageTitle = `${g.title} · The Upskilling Labs`;
const nos = ["01", "02", "03", "04", "05"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={g.description} />
    <meta name="theme-color" content="#00141B" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={g.description} />
    <meta property="og:image" content={new URL(u("/join/hub-share.jpg"), Astro.site)} />
    <script is:inline>document.documentElement.dataset.menu = "";</script>
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={art} fetchpriority="high" />
  </head>
  <body class="jp gv">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head" data-head>
      <nav aria-label="For government">
        <a class="jp-brand" href={home}>
          <img src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" />
          <span class="wide-only">{g.nav.brand}</span>
        </a>
        <ul class="jp-links" id="jp-menu">
          <li><a class="navlink" href="#frame" data-spy="frame">{g.nav.frame}</a></li>
          <li><a class="navlink" href="#how" data-spy="how">{g.nav.how}</a></li>
          <li><a class="navlink" href="#options" data-spy="options evidence">{g.nav.options}</a></li>
          <li><a class="navlink" href="#start" data-spy="start procure">{g.nav.start}</a></li>
          <li class="menu-only"><a class="navlink" href={home}>{g.nav.home}</a></li>
        </ul>
        <div class="jp-end">
          <a class="btn" href={L.contact} data-head-cta><span class="wide-only">{g.nav.cta}</span><span class="narrow-only">{g.nav.ctaShort}</span></a>
          <button class="jp-menu-btn" type="button" aria-expanded="false" aria-controls="jp-menu" aria-label={g.nav.menu} data-menu-btn data-label-open={g.nav.menu} data-label-close={g.nav.menuClose}><span></span><span></span><span></span></button>
        </div>
      </nav>
    </header>

    <main id="main">
      <!-- Hero: the headline and one sentence beside the world's picture of The Labs. -->
      <section id="top" class="gv-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="gv-art" aria-hidden="true">
          <img src={art} alt="" width="1600" height="1000" fetchpriority="high" />
        </div>
        <div class="gv-hero-copy">
          <p class="kicker rise">{g.hero.kicker}</p>
          <h1 class="rise d1">{g.hero.title}</h1>
          <p class="lede rise d2">{g.hero.lede}</p>
          <div class="gv-ctas rise d3">
            <a class="btn" href={L.contact}>{g.hero.cta}</a>
            <a class="ghost" href="#how">{g.hero.more}<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5v11M2.5 8 7 12.5 11.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </div>
      </section>

      <!-- What it adds up to: the three words, each with what it means here. -->
      <section id="frame" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{g.frame.kicker}</p>
            <h2 class="h2">{g.frame.title}</h2>
          </div>
          <dl class="gv-words reveal">
            {g.frame.items.map((it) => (
              <div><dt>{it.word}</dt><dd>{it.body}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      <!-- How it works: workshops, then the open cycle, with sector cohorts inside it. -->
      <section id="how" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{g.how.kicker}</p>
            <h2 class="h2">{g.how.title}</h2>
          </div>
          <ol class="gv-tiers reveal">
            {g.how.items.map((it, i) => (
              <li class:list={{ inside: i === 2 }}>
                <span class="n">{nos[i]}</span>
                <div class="gv-tier-h">
                  {i === 2 && <p class="gv-inside">{g.how.inside}</p>}
                  <h3>{it.title}</h3>
                  <p class="when">{it.when}</p>
                </div>
                <div class="gv-tier-b">
                  <p>{it.body}</p>
                  {it.more && <p>{it.more}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Five ways to work with us, sector cohorts first. -->
      <section id="options" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{g.options.kicker}</p>
            <h2 class="h2">{g.options.title}</h2>
          </div>
          <ol class="gv-options reveal">
            {g.options.items.map((it, i) => (
              <li><span class="n">{nos[i]}</span><h3>{it.title}</h3><p>{it.body}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="evidence" class="jp-sec">
        <div class="wrap reveal">
          <p class="kicker">{g.evidence.kicker}</p>
          <h2 class="h2 gv-h2-mid">{g.evidence.title}</h2>
          <p class="lede">{g.evidence.body}</p>
        </div>
      </section>

      <section id="start" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{g.start.kicker}</p>
            <h2 class="h2">{g.start.title}</h2>
          </div>
          <ol class="jp-steps reveal">
            {g.start.steps.map((s, i) => (
              <li class:list={{ milestone: i === g.start.steps.length - 1 }}><span class="n">{nos[i]}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>
          <p class="gv-note reveal">{g.start.note}</p>
        </div>
      </section>

      <section id="procure" class="jp-sec">
        <div class="wrap">
          <div class="gv-box reveal">
            <p class="kicker">{g.procure.kicker}</p>
            <h2>{g.procure.title}</h2>
            <ul>{g.procure.items.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{g.join.title}</h2>
          <p class="lede">{g.join.lede}</p>
          <div class="row">
            <a class="btn" href={L.contact}>{g.join.cta}</a>
            <a class="textlink" href={L.join}>{g.join.residents} →</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="jp-foot">
      <div class="wrap">
        <div class="col">
          <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
          <p>{h.footer.legal}</p>
          <p>{h.footer.rights} · {h.footer.license}</p>
          <p><a class="textlink" href={home}>{g.footer.home} →</a></p>
          {g.placeholder && <p class="ph">{g.footer.draft}</p>}
        </div>
      </div>
    </footer>

    <script>
      import { initMenu } from "../../scripts/navmenu";

      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      // Compact once you scroll; the header's button steps aside while the closing one is on screen.
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => {
        head.classList.toggle("cta-off", e.isIntersecting);
        cta.tabIndex = e.isIntersecting ? -1 : 0;
      }, { threshold: 0.25 }).observe(document.getElementById("join")!);
      // The section in view is marked in the nav.
      const links = [...head.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const order = ["frame", "how", "options", "evidence", "start", "procure", "join"].map((id) => document.getElementById(id)!);
      let queued = false;
      const spy = () => {
        queued = false;
        const line = innerHeight * 0.35;
        const current = order.filter((el) => el.getBoundingClientRect().top <= line).pop()?.id ?? "";
        links.forEach((a) => (a.dataset.spy!.split(" ").includes(current) ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(spy); } }, { passive: true });
      spy();
      initMenu();
    </script>
  </body>
</html>
