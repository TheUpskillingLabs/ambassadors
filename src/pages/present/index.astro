---
import { u } from "../../lib/url";
/* /present — the boilerplate deck. No login, no download.
     /present            full-screen presentation
     /present?short      60-second version (slides 1, 5, 6)
     /present?notes      laptop notes view (current, next, cues, timer);
                         stays in sync with a presentation window
     /present?practice   cues visible beneath each slide
   Flags combine (e.g. ?short&practice). */
import "@fontsource-variable/geologica/wght.css";
import "../../styles/colors_and_type.css";
import "../../styles/system.css";
import "../../styles/deck.css";
import Slides from "../../components/Slides.astro";
import Icon from "../../components/Icon.astro";
import { t, ui } from "../../lib/i18n";
import deck from "../../../content/site/deck.json";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t("deck.presentNow")} · {t("siteName")}</title>
    <meta name="theme-color" content="#00141B" />
    <link rel="manifest" href={u("/manifest.webmanifest")} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={u("/icons/apple-touch-icon.png")} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  </head>
  <body class="deck" data-short-slides={JSON.stringify(deck.shortSlides)}>
    <div class="deck-shell">
      <div class="viewport" data-viewport="main" aria-live="polite">
        <div class="scaler"><Slides /></div>
      </div>

      <!-- practice mode: cue under the slide -->
      <section class="practice-cue" data-practice-cue hidden>
        <div class="lbl">{t("present.talkCue")}</div>
        <p class="pc-cue" data-cue-text></p>
        <p class="pc-notes" data-notes-text></p>
      </section>

      <!-- notes view: next slide + cues + timer -->
      <aside class="notes-pane on-dark" data-notes-pane hidden>
        <div class="np-top">
          <span class="np-count" data-counter></span>
          <button class="np-timer" type="button" data-timer title={t("present.resetTimer")} aria-label={t("present.resetTimer")}>0:00</button>
        </div>
        <p class="np-pace" data-pace role="status" data-on={t("present.paceOn")} data-behind={t("present.paceBehind")} data-ahead={t("present.paceAhead")}></p>
        <div class="lbl">{t("present.talkCue")}</div>
        <p class="np-cue" data-cue-text></p>
        <p class="np-notes" data-notes-text></p>
        <div class="lbl">{t("present.next")}</div>
        <div class="viewport np-next" data-viewport="next"><div class="scaler"></div></div>
        <p class="np-end" data-next-empty hidden>{t("present.noNext")}</p>
        <div class="np-btns">
          <button class="btn btn-ghost" type="button" data-prev><Icon name="arrow-left" size={18} /> {t("page.previous")}</button>
          <button class="btn btn-white" type="button" data-next>{t("present.next")} <Icon name="arrow-right" size={18} /></button>
        </div>
        <a class="see" href="#" data-open-audience>{t("present.openAudience")} →</a>
      </aside>

      <!-- phone speaker cues -->
      <section class="cue-sheet" data-cue-sheet hidden>
        <div class="lbl"><span data-counter></span> · {t("present.talkCue")}</div>
        <p class="pc-cue" data-cue-text></p>
      </section>

      <div class="controls" data-controls>
        <a class="ctl" href={u("/room/")} data-ctl>{t("present.exit")}</a>
        <button class="ctl" type="button" data-ctl data-toggle-cues aria-pressed="false">{t("present.cues")}</button>
        <button class="ctl" type="button" data-ctl data-fullscreen>{t("present.fullscreen")}</button>
        <button class="ctl" type="button" data-ctl data-help-open aria-label={t("present.keys")}>?</button>
      </div>
      <div class="blank" data-blank hidden></div>
      <dialog class="keys" data-help aria-labelledby="keys-h">
        <h2 id="keys-h" class="t-h3">{t("present.keys")}</h2>
        <dl class="keys-list">
          {ui.present.keyListItems.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <form method="dialog"><button class="btn btn-ink btn-sm">{t("present.close")}</button></form>
      </dialog>
      <p class="deck-hint" data-hint><span data-counter></span> · {t("present.hint")}</p>
    </div>

    <script>
      import { initDeck } from "../../scripts/deck";
      initDeck();
    </script>
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>
