---
/* The Upskilling Labs home page: a prototype of the pre-login experience for
   OLOS (the app behind theupskillinglabs.org) to adopt. Its one action is the
   free account (Join The Labs); everything after it (workshops, applying,
   contributing) happens inside the account, not here.

   What it shows: The Labs is one big open project. Everyone in it builds three
   things together (open workshops and playbooks, the method and kits that turn
   strangers into teams doing real work, the platform every Lab runs on), and a
   small team at the centre curates the official versions every Lab gets. The
   Build Cycle is the engine: when teams hit obstacles, Mentors build the next
   workshops around them, and what works is shared back.

   It's one journey, after Lusion's Oryzo: a live world held on screen
   (src/scripts/orbnet.ts) while nineteen scenes go by, each one idea, the words
   small and beside the picture, never over it (src/components/HomeScene.astro).
   The motif changes shape: the system under the title; beside what this is;
   close on the centre (one open project); its three path orbits drawn down into
   a triple helix (Learn it. Build it. Share it.); down the helix to each path's
   thread, where small scenes play out: open workshops coming down Learn's; a
   Pod forming, teams, a knot freed by a workshop, the Showcase and the next
   cycle on Build's; contributions rising up Share's to the centre, which sends
   the official version out; the weave again; the system again, every Lab on one
   network and a new one born; the close, with the three ways in; and at the very end the logo forms,
   the paths flying together into its swoosh over the orb, then settling into
   the brand's own lockup. Then the footer.

   It's built on the role pages' system (src/styles/role.css, with home.css for
   what only this page has): ink, the teal and red glows with the grain only in
   them, Geologica, hairline rules, teal labels. The sessions, cities and member
   count are a snapshot in content/site/home.json; in OLOS they come from its
   own data. Links point at the live site until then. */
import "@fontsource-variable/geologica/wght.css";
import "../styles/join.css";
import "../styles/role.css";
import "../styles/home.css";
import { u } from "../lib/url";
import h from "../../content/site/home.json";
import HomeScene from "../components/HomeScene.astro";
import list from "../../content/roles/roles.json";
import j from "../../content/site/join.json";

const L = h.links;
const orbit = (f: string) => u(`/join/${f}`);
const pageTitle = h.title;
// Each way in goes straight to the account, with the path it came from (?path=, proposed for OLOS).
const pathJoin = (slug: string) => `${L.join}&path=${slug}`;
const ch = h.chapters, J = h.journey, go = ch.go;
const giveTo: Record<string, string> = { mentor: u("/mentor/"), github: L.github };
// Share's way leads to the Contributor Community page, which explains how contributing works and where to start.
const community = u("/contributing/");
// The cycle's state, switched by date: open until it closes, then underway. The page sets it again as it
// loads, so a static build never shows a stale "applications open".
const closesAt = `${J.cycle.closes}T00:00:00-04:00`;
const cycleState = Date.now() < Date.parse(closesAt) ? "open" : "closed";
const faces = [1, 2, 3, 4, 5, 6, 7].map((n) => u(`/home/face-${n}.webp`)).concat(u("/home/suzie.webp"));
---
<!doctype html>
<html lang="en" data-cycle={cycleState}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={h.description} />
    <meta name="theme-color" content="#00141B" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={h.description} />
    <meta property="og:image" content={new URL(orbit("hub-share.jpg"), Astro.site)} />
    <script is:inline>document.documentElement.dataset.menu = "";</script>
    <!-- The page opens on the logo (see the opening in src/scripts/orbnet.ts): until it's played, no poster and
         no title, so nothing shows before it. Not with reduced motion, a still, or a page opened partway down. -->
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !/orb=(still|poster)/.test(location.search) && (!location.hash || location.hash === "#top")) { document.documentElement.dataset.intro = ""; setTimeout(() => { delete document.documentElement.dataset.intro; }, 9000); }</script>
    <script is:inline define:vars={{ closesAt }}>document.documentElement.dataset.cycle = Date.now() < Date.parse(closesAt) ? "open" : "closed";</script>
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={orbit("hub-poster.webp")} fetchpriority="high" />
    <!-- Without the script, each scene's words sit in their scene (nothing is there to fade them). -->
    <noscript><style>.hm .hm-scene-in { position: sticky; top: 0; height: 100svh; transform: none; opacity: 1; pointer-events: auto; justify-content: flex-end; padding-top: calc(var(--head) + 24px); } .hm .hm-hero-in { justify-content: flex-start; padding: 0; }</style></noscript>
  </head>
  <body class="jp rp hm">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head cta-off" data-head data-quiet>
      <nav aria-label="The Upskilling Labs">
        <!-- One orb at a time: while the hero's orb is on screen it is the logo, so the header carries the
             wordmark alone; as the stage scrolls away the orb docks into the header as the mark. -->
        <a class="jp-brand hm-brand" href="#top" data-brand>
          <img class="hm-mark" src={u("/home/mark.png")} alt="" width="159" height="144" />
          <img class="hm-word" src={u("/home/wordmark.png")} alt="The Upskilling Labs" width="233" height="144" />
        </a>
        <ul class="jp-links" id="jp-menu">
          <li><a class="navlink" href="#learn">{h.nav.learn}</a></li>
          <li><a class="navlink" href="#build">{h.nav.build}</a></li>
          <li><a class="navlink" href="#share">{h.nav.share}</a></li>
          <li><a class="navlink" href="#open">{h.nav.story}</a></li>
          <li><a class="navlink" href="#found">{h.nav.found}</a></li>
          <li class="menu-only"><a class="navlink" href={L.login}>{h.nav.login}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={L.login}>{h.nav.login}</a>
          <a class="btn" href={L.join} data-head-cta><span class="wide-only">{h.nav.cta}</span><span class="narrow-only">{h.nav.ctaShort}</span></a>
          <button class="jp-menu-btn" type="button" aria-expanded="false" aria-controls="jp-menu" aria-label={j.nav.menu} data-menu-btn data-label-open={j.nav.menu} data-label-close={j.nav.menuClose}><span></span><span></span><span></span></button>
        </div>
      </nav>
    </header>

    <a class="hm-orb-link" href={L.join} aria-label={h.model.orbLabel} data-orb-link><span class="hm-orb-label">{h.model.orb} <b aria-hidden="true">→</b></span></a>
    <button class="hm-pause" type="button" data-quiet aria-pressed="false" aria-label={h.model.pauseLabel} data-pause data-pause-label={h.model.pauseLabel} data-play-label={h.model.playLabel} data-pause-text={h.model.pause} data-play-text={h.model.play}>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path class="i-pause" d="M3 2h2v8H3zM7 2h2v8H7z" /><path class="i-play" d="M3 2l7 4-7 4z" /></svg>
      <span>{h.model.pause}</span>
    </button>

    <main id="main">
      <!-- The journey: one live world (src/scripts/orbnet.ts), held on screen while its eighteen scenes go by,
           each a tall section whose words sit beside the picture, never over it, and cross-fade in place. The
           motif changes shape as you go: the system; the weave, drawn down out of its orbits; each path's own
           thread, where small scenes play out; the weave again; the system again. Then the footer. -->
      <div class="hm-journey" data-journey>
        <div class="hm-world" data-world data-faces={JSON.stringify(faces)} data-words={JSON.stringify(h.model.hover)}>
          <div class="hm-orbit" data-orbnet role="img" aria-label={h.hero.orbLabel} style={`--poster: url(${orbit("hub-poster.webp")})`}></div>
          <!-- What you're pointing at (or tapped): a card beside it, from the model. -->
          <div class="hm-card" data-card aria-hidden="true"><p class="hm-card-k"><i data-card-mk></i><span data-card-kind></span></p><p class="hm-card-t" data-card-title></p><p class="hm-card-d" data-card-detail></p></div>
          <!-- The very end: the brand's own lockup (brandkit logo-lockup-light.png), cut in two at the gap between
               mark and wordmark, placed from the world's orb so the artwork's orb sits exactly on it. It's part of
               the world, so it scrolls away with it. (Loaded as the end comes near.) -->
          <div class="hm-logo" aria-hidden="true">
            <img class="hm-logo-part" data-logo-word data-src={u("/home/logo-wordmark.webp")} alt="" width="1111" height="732" decoding="async" />
            <img class="hm-logo-part" data-logo-mark data-src={u("/home/logo-mark.webp")} alt="" width="786" height="732" decoding="async" />
          </div>
        </div>

        <div class="hm-scenes">
          <!-- The system: the title over the whole of it. -->
          <section id="top" class="hm-hero" data-scene>
            <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
            <div class="hm-scene-in hm-hero-in" data-scene-in>
              <div class="hm-hero-copy" data-quiet>
                <h1 class="rp-title wordin">{h.hero.title.map((l, i) => <span class={`hm-l hm-l${i + 1}`}>{l}</span>)}</h1>
                <p class="hm-hero-sub rise"><span class="hm-sub-in">{h.hero.sub}</span></p>
              </div>
            </div>
          </section>

          <!-- The system, beside what this is: you're in the right place, and the one action. Its three path
               orbits glow. -->
          <HomeScene id="intro" labelledby="intro-t">
            <p class="hm-side-lede">{h.intro.lede}</p>
            <h2 class="hm-side-h" id="intro-t">{h.intro.title}</h2>
            <p class="hm-side-p">{h.intro.who}</p>
            <div class="hm-people">
              <ul class="hm-faces" aria-hidden="true">
                {[1, 2, 3, 4, 5, 6, 7].map((n) => <li><img src={u(`/home/face-${n}.webp`)} alt="" width="192" height="192" loading="lazy" decoding="async" /></li>)}
              </ul>
              <p>{h.intro.people}</p>
            </div>
            <p class="rp-terms">{h.intro.terms}</p>
            <div class="hm-actions">
              <a class="btn" href={L.join} data-hero-cta>{h.intro.cta}</a>
              <a class="textlink" href={L.login}>{h.intro.login}</a>
            </div>
            <p class="rp-account">{h.intro.note}</p>
          </HomeScene>

          <!-- Where it started, and what we believe: close on the orb, which flares. -->
          <HomeScene id="open" labelledby="open-t">
            <p class="kicker">{J.open.kicker}</p>
            <h2 class="hm-side-h" id="open-t">{J.open.title}</h2>
            <p class="hm-side-p">{J.open.lede}</p>
            <p class="hm-side-p">{J.open.belief}</p>
          </HomeScene>

          <!-- The weave: three of the system's orbits drawn down into a vortex beneath the orb, one triple helix. -->
          <HomeScene id="paths" labelledby="paths-t">
            <p class="kicker">{h.threads.kicker}</p>
            <h2 class="hm-side-h hm-triad" id="paths-t">{h.threads.title.split(/(?<=\.) /).map((t, i) => <>{i > 0 && " "}<span>{t}</span></>)}</h2>
            <p class="hm-side-p">{h.threads.lede}</p>
            <ol class="hm-strands">
              {h.threads.items.map((t) => <li><a href={`#${t.id}`}><i class="gem" data-gem={t.id} aria-hidden="true"></i><b>{t.name}</b><span>{t.when}</span></a></li>)}
            </ol>
          </HomeScene>

          <!-- Learn: its thread; open workshops coming down it into a room of people; this week's. -->
          <HomeScene id="learn" path="learn" labelledby="learn-t" opener={ch.learn}>
            <p class="hm-ch-title">{ch.learn.title}</p>
            <p class="hm-ch-when">{ch.learn.when}</p>
            <p class="hm-ch-lede">{ch.learn.lede}</p>
          </HomeScene>
          <HomeScene id="workshops" path="learn" labelledby="workshops-t">
            <p class="kicker hm-k"><i class="gem" data-gem="learn" aria-hidden="true"></i>{J.workshops.kicker}</p>
            <h2 class="hm-side-h" id="workshops-t">{J.workshops.title}</h2>
            <ul class="hm-mini hm-mini-open">
              {J.workshops.topics.map((t) => <li><b>{t.title}</b><span>{t.body}</span></li>)}
            </ul>
            <p class="hm-side-p">{J.workshops.note}</p>
          </HomeScene>
          <HomeScene id="week" path="learn" labelledby="week-t">
            <figure class="hm-photo">
              <img src={u("/home/room-900.webp")} alt={J.week.photo.alt} width="900" height="675" loading="lazy" decoding="async" />
              <figcaption>{J.week.photo.caption}</figcaption>
            </figure>
            <p class="kicker hm-k"><i class="gem" data-gem="learn" aria-hidden="true"></i>{J.week.kicker}</p>
            <h2 class="hm-side-h" id="week-t">{J.week.title}</h2>
            <ol class="hm-rows">
              {J.week.items.map((e) => <li><span class="when"><b>{e.date}</b> {e.time}</span><span class="what">{e.title}</span><span class="where">{e.where}</span></li>)}
            </ol>
            <a class="textlink hm-more" href={L.events}>{J.week.all} →</a>
          </HomeScene>

          <!-- Build: its thread; strangers becoming a Pod; teams round what they propose; a knot freed by a
               workshop; the Showcase; the next cycle. -->
          <HomeScene id="build" path="build" labelledby="build-t" opener={ch.build}>
            <p class="hm-ch-title">{ch.build.title}</p>
            <p class="hm-ch-when">{ch.build.when}</p>
            <p class="hm-ch-lede">{ch.build.lede}</p>
          </HomeScene>
          {(["pod", "teams", "stuck"] as const).map((id) => (
            <HomeScene id={id} path="build" labelledby={`${id}-t`}>
              <p class="kicker hm-k"><i class="gem" data-gem="build" aria-hidden="true"></i>{J[id].kicker}</p>
              <h2 class="hm-side-h" id={`${id}-t`}>{J[id].title}</h2>
              <p class="hm-side-p">{J[id].lede}</p>
            </HomeScene>
          ))}
          <HomeScene id="showcase" path="build" labelledby="showcase-t">
            <p class="kicker hm-k"><i class="gem" data-gem="build" aria-hidden="true"></i>{J.showcase.kicker}</p>
            <h2 class="hm-side-h" id="showcase-t">{J.showcase.title}</h2>
            <p class="hm-side-p">{J.showcase.lede}</p>
            <div class="hm-says">
              {J.showcase.quotes.map((q) => (
                <figure>
                  <img src={u(`/home/${q.photo}.webp`)} alt="" width="560" height="560" loading="lazy" decoding="async" />
                  <blockquote>“{q.quote}”</blockquote>
                  <figcaption><b>{q.name}</b> {q.role}</figcaption>
                </figure>
              ))}
            </div>
          </HomeScene>
          <HomeScene id="cycle" path="build" labelledby="cycle-t">
            <div data-when="open">
              <p class="status"><i aria-hidden="true"></i>{J.cycle.kicker}</p>
              <h2 class="hm-side-h" id="cycle-t">{J.cycle.title}</h2>
              <p class="hm-side-p">{J.cycle.body}</p>
            </div>
            <div data-when="closed">
              <p class="status"><i aria-hidden="true"></i>{J.cycle.closed.kicker}</p>
              <h2 class="hm-side-h">{J.cycle.closed.title}</h2>
              <p class="hm-side-p">{J.cycle.closed.body}</p>
            </div>
            <ul class="hm-know" aria-label={J.cycle.know.kicker}>
              {J.cycle.know.items.map((it) => <li><b>{it.title}</b><span>{it.body}</span></li>)}
            </ul>
            <div class="hm-actions">
              <a class="btn" href={pathJoin("build")} data-when="open">{J.cycle.cta}</a>
              <a class="btn" href={L.join} data-when="closed">{J.cycle.closed.cta}</a>
              <a class="textlink" href={u("/upskiller/")}>{J.cycle.upskiller}</a>
            </div>
            <p class="rp-account" data-when="open">{J.cycle.apply}</p>
            <p class="rp-account" data-when="closed">{J.cycle.closed.note}</p>
          </HomeScene>

          <!-- Share: its thread, with contributions rising up it; then the centre, where they're curated and
               sent back out to every Lab. -->
          <HomeScene id="share" path="share" labelledby="share-t" opener={ch.share}>
            <p class="hm-ch-title">{ch.share.title}</p>
            <p class="hm-ch-when">{ch.share.when}</p>
            <ul class="hm-mini hm-mini-links">
              {ch.share.ways.map((w) => <li><b>{w.title}</b><span>{w.body}{w.to && <> <a class="textlink" href={giveTo[w.to]}>{w.link} →</a></>}</span></li>)}
            </ul>
            <p class="hm-ch-lede">{ch.share.lede}</p>
            <a class="hm-more textlink" href={community}>{ch.share.more} →</a>
          </HomeScene>
          <HomeScene id="centre" path="share" labelledby="centre-t">
            <p class="kicker hm-k"><i class="gem" data-gem="share" aria-hidden="true"></i>{J.centre.kicker}</p>
            <h2 class="hm-side-h" id="centre-t">{J.centre.title}</h2>
            <p class="hm-side-p">{J.centre.lede}</p>
            <div class="hm-go"><a class="hm-path" href={community}><em>{go.share.label}<small>{go.share.note}</small></em><span aria-hidden="true">→</span></a></div>
          </HomeScene>

          <!-- The weave again: the loop. -->
          <HomeScene id="together" labelledby="together-t">
            {J.together.kicker && <p class="kicker">{J.together.kicker}</p>}
            <h2 class="hm-side-h" id="together-t">{J.together.title}</h2>
            <p class="hm-side-p">{J.together.lede}</p>
          </HomeScene>

          <!-- The system again: every Lab on its own and on the network; a new Lab born; the cities. -->
          <HomeScene id="labs" labelledby="labs-t">
            <p class="kicker">{J.labs.kicker}</p>
            <h2 class="hm-side-h" id="labs-t">{J.labs.title}</h2>
            <p class="hm-side-p">{J.labs.lede}</p>
            <ul class="hm-cityline">
              {J.labs.items.map((c) => <li class:list={{ active: c.active }}><i aria-hidden="true"></i><b>{c.city}</b><span>{c.status} · {c.detail}</span></li>)}
            </ul>
            <p class="rp-account">{J.labs.note}</p>
          </HomeScene>

          <!-- Start a Lab: close on the newborn Lab, where its first people gather and The Labs' kit reaches it from
               the centre (silver). For anyone who'd start one where they live; founding goes on in the account. -->
          <HomeScene id="found" labelledby="found-t">
            <p class="kicker">{J.found.kicker}</p>
            <h2 class="hm-side-h" id="found-t">{J.found.title}</h2>
            <p class="hm-side-p">{J.found.lede}</p>
            <p class="hm-side-p">{J.found.offer}</p>
            <p class="hm-early">{J.found.early}</p>
            <div class="hm-actions">
              <a class="btn" href={pathJoin("start-a-lab")}>{J.found.cta}</a>
            </div>
            <p class="rp-account">{J.found.note}</p>
          </HomeScene>

          <!-- The close: the one action, and the three ways in. -->
          <HomeScene id="start" labelledby="start-t">
            <h2 class="hm-side-h" id="start-t">{h.join.title}</h2>
            <p class="hm-side-p">{h.join.lede}</p>
            <p class="hm-early">{h.join.early}</p>
            <ul class="hm-ways-in">
              {h.threads.items.map((t) => <li><a href={pathJoin(t.path)}><i class="gem" data-gem={t.id} aria-hidden="true"></i><b>{t.name}</b><span>{t.then}</span><em aria-hidden="true">→</em></a></li>)}
            </ul>
            <div class="hm-actions">
              <a class="btn" href={L.join}>{h.join.cta}</a>
              <a class="ghost" href={L.donate}>{h.join.donate}</a>
            </div>
            <p class="rp-account">{h.join.note}</p>
          </HomeScene>

          <!-- The very end: the system gives way to the logo. The paths fly together into the swoosh over the orb,
               and the wordmark settles in beside it (the lockup is in the world, above). No words: just the time. -->
          <section id="end" class="hm-scene hm-end" data-scene aria-hidden="true"></section>
        </div>
      </div>
    </main>

    <footer class="hm-foot">
      <div class="rp-wrap">
        <div class="hm-foot-top">
          <div class="hm-foot-brand">
            <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
            <p>{h.join.lede}</p>
            <a class="ghost small" href={L.donate}>{h.join.donate}</a>
          </div>
          <nav class="hm-foot-cols" aria-label="Footer">
            <div><p class="kicker">{h.footer.explore}</p><a href={L.events}>{h.footer.workshops}</a><a href="#build">{h.nav.build}</a><a href="#labs">{J.labs.kicker}</a><a href="#found">{h.footer.found}</a></div>
            <div><p class="kicker">{h.footer.roles}</p>{list.roles.map((c) => <a href={u(`/${c.slug}/`)}>{c.name}</a>)}</div>
            <div><p class="kicker">{h.footer.community}</p><a href={L.about}>{h.footer.about}</a><a href={L.board}>{h.footer.board}</a><a href={community}>{h.footer.contributors}</a><a href={u("/government/")}>{h.footer.government}</a><a href={L.contact}>{h.footer.contact}</a><a href={L.join}>{h.footer.member}</a></div>
            <div><p class="kicker">{h.footer.open}</p><a href={L.github}>{h.footer.built}</a><a href={L.join}>{h.nav.cta}</a></div>
          </nav>
        </div>
        <div class="hm-foot-mid">
          <p class="kicker">{h.footer.partners}</p>
          <div class="sponsors">
            <img src={u("/assets/dcpl-knockout-logo.png")} alt="DC Public Library" width="117" height="96" loading="lazy" />
            <img src={u("/assets/levy-strategic-design-white.png")} alt="Levy Strategic Design" width="198" height="96" loading="lazy" />
            <img src={u("/assets/superbloom-white.png")} alt="Superbloom Design" width="406" height="96" loading="lazy" />
          </div>
        </div>
        <div class="hm-foot-legal">
          <p>{h.footer.legal}</p>
          <p>{h.footer.google} <a class="textlink" href={L.privacy}>{h.footer.privacy} →</a></p>
          <p>{h.footer.rights} · {h.footer.license}</p>
          {h.placeholder && <p class="ph">Prototype for OLOS: sessions, cities and member counts are a snapshot from Sep 29, 2026.</p>}
        </div>
      </div>
    </footer>

    <script>
      import { openCovers } from "../scripts/covers";
      import { initMenu } from "../scripts/navmenu";
      import { mountOrbNet } from "../scripts/orbnet";

      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      initMenu();
      openCovers();

      // The journey's scenes. Each scene's words are pinned to the screen (a fixed layer: the browser holds them
      // still as the page scrolls, so nothing is moved by script and nothing can lag the finger) and cross-fade
      // with the next by opacity alone (the old one out, then the new one in), so words never scroll across the
      // picture. Where the scenes sit on the page is measured once (and again if it reflows), so following the
      // scroll reads nothing back from the page.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const scenes = [...document.querySelectorAll<HTMLElement>("[data-scene]")];
      const inners = scenes.map((el) => el.querySelector<HTMLElement>("[data-scene-in]"));
      const ons = scenes.map(() => 0);
      const smooth = (a: number, b: number, x: number) => { const t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
      // Style writes only when a value changes, so a frame where nothing moves costs the page nothing.
      const styled = new WeakMap<HTMLElement, Record<string, string>>();
      const put = (el: HTMLElement, k: string, v: string) => {
        let m = styled.get(el); if (!m) styled.set(el, (m = {}));
        if (m[k] === v) return; m[k] = v;
        el.style.setProperty(k.startsWith("--") ? k : k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`), v);
      };
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      const startAt = scenes.findIndex((el) => el.id === "start");
      let ctaOff: boolean | null = null;
      const syncCta = () => { const off = ons[1] > 0.5 || ons[startAt] > 0.25; if (off === ctaOff) return; ctaOff = off; head.classList.toggle("cta-off", off); cta.tabIndex = off ? -1 : 0; };
      let tops: number[] = [], bots: number[] = [], vh = 1;
      const measure = () => {
        // (The layout's height, which holds still while a phone's toolbar comes and goes.)
        const y = window.scrollY; vh = document.documentElement.clientHeight || window.innerHeight;
        tops = scenes.map((el) => el.getBoundingClientRect().top + y); bots = scenes.map((el) => el.getBoundingClientRect().bottom + y);
      };
      let onPlace: (() => void) | null = null;
      const place = () => {
        const y = window.scrollY, n = scenes.length;
        scenes.forEach((_, i) => {
          const top = tops[i] - y, bottom = bots[i] - y;
          let op = 1;
          if (i > 0 && top > 0) op = Math.min(op, 1 - smooth(0.35, 0.65, top / vh));
          if (i < n - 1 && bottom < vh) op = Math.min(op, 1 - smooth(0, 0.3, (vh - bottom) / vh));
          if (top >= vh || bottom <= 0) op = 0;
          ons[i] = op;
          const inner = inners[i];
          // A scene's words far from the screen are hidden outright, so the phone keeps no layer for them (twenty
          // full-width layers would otherwise sit in its GPU memory). They're shown a screen early, so they're
          // ready before they fade in, and nothing has to be drawn mid-fade.
          const near = top < vh * 2 && bottom > -vh;
          if (inner) { put(inner, "opacity", op.toFixed(3)); put(inner, "pointerEvents", op < 0.5 ? "none" : "auto"); put(inner, "visibility", near ? "visible" : "hidden"); }
        });
        syncCta(); onPlace?.();
      };
      let placing = 0;
      const placeSoon = () => { if (!placing) placing = requestAnimationFrame(() => { placing = 0; place(); }); };
      const remeasure = () => { measure(); place(); };
      window.addEventListener("scroll", placeSoon, { passive: true });
      // Only when the width changes: a phone's toolbars coming and going as you scroll change the height alone,
      // and the scenes are sized in svh, which doesn't move with them (re-measuring then lays the page out
      // mid-scroll). Real changes in size reach the observer below through the page's own size.
      let lastW = window.innerWidth;
      window.addEventListener("resize", () => { if (window.innerWidth === lastW) return; lastW = window.innerWidth; remeasure(); });
      window.addEventListener("load", remeasure);
      new ResizeObserver(remeasure).observe(document.body);
      remeasure();
      // Tabbing into a scene's link brings its scene to the middle of the screen, so it's never focused unseen.
      scenes.forEach((el, i) => el.addEventListener("focusin", () => {
        if (ons[i] > 0.9) return;
        const top = el.getBoundingClientRect().top + window.scrollY + Math.max(0, el.offsetHeight - window.innerHeight) / 2;
        window.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
      }));
      // The pause shows while the journey is on screen.
      let inJourney = true;
      new IntersectionObserver(([e]) => { inJourney = e.isIntersecting; root.classList.toggle("in-journey", inJourney); }).observe(document.querySelector("[data-journey]")!);

      // The world: the live model behind the journey, its camera and its motif following the scenes. Reduced
      // motion gets it still (it still follows the page); without WebGL 2 the poster stays.
      const orbMode = new URLSearchParams(location.search).get("orb");
      const still = reduce || orbMode === "still" || orbMode === "poster";
      const world = document.querySelector<HTMLElement>("[data-world]")!;
      const card = world.querySelector<HTMLElement>("[data-card]")!;
      const cardMk = card.querySelector<HTMLElement>("[data-card-mk]")!, cardKind = card.querySelector<HTMLElement>("[data-card-kind]")!;
      const cardTitle = card.querySelector<HTMLElement>("[data-card-title]")!, cardDetail = card.querySelector<HTMLElement>("[data-card-detail]")!;
      let cardWas = "", sysNow = 1;
      const pause = document.querySelector<HTMLButtonElement>("[data-pause]")!;
      const orbLink = document.querySelector<HTMLAnchorElement>("[data-orb-link]")!;
      // One orb at a time: while the world's orb is on screen, the header carries the wordmark alone; when it
      // leaves (the weave's threads, or the detail), the mark comes back.
      const brand = document.querySelector<HTMLElement>("[data-brand]")!;
      let dockM = 0;
      // The lockup's two parts, placed so the artwork's orb (centre 511.1, 484.3, radius 348.2 in the 2061-wide
      // source) lands exactly on the world's: the mark cut from x 140, the wordmark from x 950, both from y 120.
      const logoWord = document.querySelector<HTMLElement>("[data-logo-word]")!, logoMark = document.querySelector<HTMLElement>("[data-logo-mark]")!;
      const LOGO = { cx: 511.1, cy: 484.3, r: 348.2, top: 120, mark: [140, 786], word: [950, 1111] };
      const logoParts = [[logoMark, LOGO.mark], [logoWord, LOGO.word]] as const;
      const loadLogo = () => logoParts.forEach(([el]) => { if (!el.getAttribute("src")) el.setAttribute("src", el.dataset.src!); });
      // Sized once (and again only if the orb grows or shrinks by much), then moved and scaled by transform, so
      // following the orb never lays the page out again.
      let logoK0 = 0;
      const placeLogo = (x: number, y: number, r: number) => {
        const k = r / LOGO.r, top = y + (LOGO.top - LOGO.cy) * k;
        if (!logoK0 || Math.abs(k / logoK0 - 1) > 0.08) { logoK0 = k; for (const [el, [, w]] of logoParts) put(el, "width", `${(w * k).toFixed(1)}px`); }
        for (const [el, [x0, w]] of logoParts) {
          const sc = (k * w) / parseFloat(styled.get(el)!.width);
          put(el, "transform", `translate(${(x + (x0 - LOGO.cx) * k).toFixed(2)}px, ${top.toFixed(2)}px) scale(${sc.toFixed(4)})`);
        }
      };
      let orbR0 = 0;
      const SCENES_LOGO_LOAD = scenes.length - 5; // load the lockup a few scenes ahead of the end
      // The opening on the logo: only from the top of the page. It waits for the lockup's artwork, and the
      // page's own words come in as it finishes.
      const playIntro = root.hasAttribute("data-intro") && !still && window.scrollY < 40;
      if (playIntro) loadLogo(); else delete root.dataset.intro;
      const heroCopy = document.querySelector<HTMLElement>(".hm-hero-copy")!;
      const net = mountOrbNet(world.querySelector<HTMLElement>("[data-orbnet]")!, {
        intro: playIntro, introReady: () => logoParts.every(([el]) => (el as HTMLImageElement).complete && (el as HTMLImageElement).naturalWidth > 0),
        still, poster: orbMode === "poster", anchors: scenes, stage: document.body,
        faces: JSON.parse(world.dataset.faces ?? "[]"), words: JSON.parse(world.dataset.words ?? "{}"),
        // Anything in the system can be asked what it is, while the system is the picture.
        inspectable: () => inJourney && sysNow > 0.7,
        onFrame: (f) => {
          sysNow = f.sys;
          // The card: beside what you're pointing at, flipped to its left near the right edge.
          const hv = f.hover;
          card.classList.toggle("on", !!hv);
          if (hv) {
            const was = hv.type + hv.title + hv.detail;
            if (was !== cardWas) { cardWas = was; cardMk.className = `mk mk-${hv.type}`; cardKind.textContent = hv.kind; cardTitle.textContent = hv.title; cardDetail.textContent = hv.detail; }
            const flip = hv.x > window.innerWidth - 300;
            card.style.transform = `translate(${(flip ? hv.x - hv.r - 14 : hv.x + hv.r + 14).toFixed(1)}px, ${hv.y.toFixed(1)}px) translate(${flip ? "-100%" : "0"}, -50%)`;
          }
          // The orb is the button while the whole system holds the screen under the title: a link laid over it
          // (sized once, then moved and scaled with the orb).
          const show = ons[0] * Math.max(0, 1 - f.s * 4) * f.intro;
          put(orbLink, "--show", show.toFixed(3));
          put(orbLink, "visibility", show > 0.05 ? "visible" : "hidden");
          if (show > 0.05) {
            if (!orbR0 || Math.abs(f.orb.r / orbR0 - 1) > 0.08) { orbR0 = f.orb.r; put(orbLink, "width", `${(orbR0 * 2).toFixed(1)}px`); put(orbLink, "height", `${(orbR0 * 2).toFixed(1)}px`); }
            put(orbLink, "transform", `translate(${(f.orb.x - f.orb.r).toFixed(1)}px, ${(f.orb.y - f.orb.r).toFixed(1)}px) scale(${(f.orb.r / orbR0).toFixed(4)})`);
          }
          const onScreen = inJourney && f.orb.r > 14 && f.orb.y > -f.orb.r * 0.5 && f.orb.y < window.innerHeight + f.orb.r ? 1 : 0;
          dockM += (1 - onScreen - dockM) * 0.15;
          put(brand, "--m", dockM.toFixed(3));
          // The very end: the logo forms round the world's orb, so the header's steps aside, and the wordmark
          // settles in beside the orb as in the lockup.
          put(brand, "opacity", (1 - f.logo).toFixed(3));
          if (f.s > SCENES_LOGO_LOAD) loadLogo();
          if (f.logo > 0.01 || f.word > 0.01 || f.settle > 0.01) placeLogo(f.orb.x, f.orb.y, f.orb.r);
          put(logoWord, "opacity", f.word.toFixed(3));
          put(logoMark, "opacity", f.settle.toFixed(3));
          // The page's own words come in as the opening finishes: the first line, then the second as the world
          // acts it out (f.title2), then the sentence under them.
          put(heroCopy, "--in", f.intro.toFixed(3));
          put(heroCopy, "--l2", f.title2.toFixed(3));
          if (f.intro >= 1 && root.hasAttribute("data-intro")) delete root.dataset.intro;
        },
      });
      if (!net) {
        delete root.dataset.intro;
        brand.style.setProperty("--m", "1"); orbLink.hidden = true;
        // Without the world, the end is the lockup itself, centred, shown with the last scene.
        loadLogo();
        const r = Math.min(window.innerWidth / 5.47 * 0.85, window.innerHeight * 0.22) / 1, x = (window.innerWidth - 5.47 * r) / 2 + (511.1 - 156) / 348.2 * r;
        placeLogo(x, window.innerHeight / 2, r);
        onPlace = () => { const op = ons[ons.length - 1].toFixed(3); put(logoWord, "opacity", op); put(logoMark, "opacity", op); };
        onPlace();
      }
      if (!net || still) pause.hidden = true;
      if (net) {
        // The orb is Join The Labs: pressing it sets off the one big pulse (the orb flares, a wave crosses the
        // orbits, sparks go out to every Lab), then the account opens. A new-tab click, reduced motion or a paused
        // model skip straight to the link.
        orbLink.addEventListener("click", (e) => {
          if (reduce || net.paused() || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          net.join();
          window.setTimeout(() => { window.location.href = orbLink.href; }, 1100);
        });
        const hov = (v: boolean) => () => net.setOrbHover(v);
        orbLink.addEventListener("pointerenter", hov(true)); orbLink.addEventListener("pointerleave", hov(false));
        orbLink.addEventListener("focus", hov(true)); orbLink.addEventListener("blur", hov(false));
      }
      pause.addEventListener("click", () => {
        if (!net) return;
        const v = !net.paused(); net.setPaused(v);
        pause.setAttribute("aria-pressed", String(v));
        pause.setAttribute("aria-label", v ? pause.dataset.playLabel! : pause.dataset.pauseLabel!);
        pause.querySelector("span")!.textContent = v ? pause.dataset.playText! : pause.dataset.pauseText!;
      });
    </script>
  </body>
</html>
