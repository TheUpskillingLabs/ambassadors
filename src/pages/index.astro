---
/* The Upskilling Labs home page: a prototype of the pre-login experience for
   OLOS (the app behind theupskillinglabs.org) to adopt. Its one action is the
   free account (Join The Labs); everything after it (workshops, applying,
   contributing) happens inside the account, not here.

   It opens with a journey, after Lusion's Oryzo: one live world held on screen
   (src/scripts/orbnet.ts) while eight scenes go by, the words small and beside
   the picture, never over it. The motif changes shape as you go: the whole
   system under the title; the system beside what this is; its three path
   orbits drawn down through time into a triple helix beneath the orb (one
   account, three paths); each path's own thread (Learn, Build, Pass it on); the braid again;
   the system again, a new Lab born in it, with the three ways in. Then the
   world scrolls away and the detail follows on the plain ground: the short
   version, the workshops and the room (Learn), a Build Cycle, what it is and
   isn't, two Upskillers and the next cycle (Build), the ways to pass it on,
   how it began, and the cities.

   It's built on the role pages' system (src/styles/role.css, with home.css for
   what only this page has): ink, the teal and red glows with the grain only in
   them, Geologica, hairline rules, teal labels. The sessions, cities and member
   count are a snapshot in content/site/home.json; in OLOS they come from its
   own data. Links point at the live site until then. */
import "@fontsource-variable/geologica/wght.css";
import "../styles/join.css";
import "../styles/role.css";
import "../styles/home.css";
import { u } from "../lib/url";
import h from "../../content/site/home.json";
import HomeChapter from "../components/HomeChapter.astro";
import list from "../../content/roles/roles.json";
import j from "../../content/site/join.json";

const L = h.links;
const orbit = (f: string) => u(`/join/${f}`);
const small = (s: string) => u(`/roles/${s}/button-400.webp`);
const ACCT = '<svg class="acct" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="10" r="3.2"/><path d="M6.2 18.4c1.3-2.2 3.4-3.4 5.8-3.4s4.5 1.2 5.8 3.4"/></svg>';
const nos = ["01", "02", "03", "04", "05", "06"];
const pageTitle = h.title;
// The four facts wear the system's glyphs: The Labs (a small orb), a place (the library), people, and
// knowledge passed on (built by the people who learn here).
const glyph: Record<string, string> = { free: "lab", place: "place", people: "person", keep: "knowledge" };
// Each path in the last shot goes straight to the account, with the path it came from (?path=, proposed for OLOS).
const pathJoin = (slug: string) => `${L.join}&path=${slug}`;
// The chapters, and where Contribute's ways link on.
const ch = h.chapters, go = ch.go;
const giveTo: Record<string, string> = { mentor: u("/mentor/"), github: L.github };
// The cycle's state, switched by date: open until it closes, then underway. The page sets it again as it
// loads, so a static build never shows a stale "applications open".
const closesAt = `${h.cycle.closes}T00:00:00-04:00`;
const cycleState = Date.now() < Date.parse(closesAt) ? "open" : "closed";
const faces = [1, 2, 3, 4, 5, 6, 7].map((n) => u(`/home/face-${n}.webp`)).concat(u("/home/suzie.webp"));
---
<!doctype html>
<html lang="en" data-cycle={cycleState}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={h.description} />
    <meta name="theme-color" content="#00141B" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={h.description} />
    <meta property="og:image" content={new URL(orbit("hub-share.jpg"), Astro.site)} />
    <script is:inline>document.documentElement.dataset.menu = "";</script>
    <script is:inline define:vars={{ closesAt }}>document.documentElement.dataset.cycle = Date.now() < Date.parse(closesAt) ? "open" : "closed";</script>
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={orbit("hub-poster.webp")} fetchpriority="high" />
  </head>
  <body class="jp rp hm">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head cta-off" data-head data-quiet>
      <nav aria-label="The Upskilling Labs">
        <!-- One orb at a time: while the hero's orb is on screen it is the logo, so the header carries the
             wordmark alone; as the stage scrolls away the orb docks into the header as the mark. -->
        <a class="jp-brand hm-brand" href="#top" data-brand>
          <img class="hm-mark" src={u("/home/mark.png")} alt="" width="159" height="144" />
          <img class="hm-word" src={u("/home/wordmark.png")} alt="The Upskilling Labs" width="233" height="144" />
        </a>
        <ul class="jp-links" id="jp-menu">
          <li><a class="navlink" href="#learn">{h.nav.learn}</a></li>
          <li><a class="navlink" href="#build">{h.nav.build}</a></li>
          <li><a class="navlink" href="#give">{h.nav.give}</a></li>
          <li><a class="navlink" href="#story">{h.nav.story}</a></li>
          <li class="menu-only"><a class="navlink" href={L.login}>{h.nav.login}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={L.login}>{h.nav.login}</a>
          <a class="btn" href={L.join} data-head-cta><span class="wide-only">{h.nav.cta}</span><span class="narrow-only">{h.nav.ctaShort}</span></a>
          <button class="jp-menu-btn" type="button" aria-expanded="false" aria-controls="jp-menu" aria-label={j.nav.menu} data-menu-btn data-label-open={j.nav.menu} data-label-close={j.nav.menuClose}><span></span><span></span><span></span></button>
        </div>
      </nav>
    </header>

    <a class="hm-orb-link" href={L.join} aria-label={h.model.orbLabel} data-orb-link><span class="hm-orb-label">{h.model.orb} <b aria-hidden="true">→</b></span></a>
    <button class="hm-pause" type="button" data-quiet aria-pressed="false" aria-label={h.model.pauseLabel} data-pause data-pause-label={h.model.pauseLabel} data-play-label={h.model.playLabel} data-pause-text={h.model.pause} data-play-text={h.model.play}>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path class="i-pause" d="M3 2h2v8H3zM7 2h2v8H7z" /><path class="i-play" d="M3 2l7 4-7 4z" /></svg>
      <span>{h.model.pause}</span>
    </button>

    <main id="main">
      <!-- The journey: one live world (src/scripts/orbnet.ts), held on screen while its scenes go by, each a tall
           section whose words sit beside the picture, never over it, and cross-fade in place. The motif changes
           shape as you go: the system, the weave, each path's thread, the weave, the system. Then the world scrolls
           away, and the detail follows on the plain ground. -->
      <div class="hm-journey" data-journey>
        <div class="hm-world" data-world data-faces={JSON.stringify(faces)} data-words={JSON.stringify(h.model.hover)}>
          <div class="hm-orbit" data-orbnet role="img" aria-label={h.hero.orbLabel} style={`--poster: url(${orbit("hub-poster.webp")})`}></div>
          <!-- What you're pointing at (or tapped): a card beside it, from the model. -->
          <div class="hm-card" data-card aria-hidden="true"><p class="hm-card-k"><i data-card-mk></i><span data-card-kind></span></p><p class="hm-card-t" data-card-title></p><p class="hm-card-d" data-card-detail></p></div>
        </div>

        <div class="hm-scenes">
          <!-- 1. The system: the title over the whole of it. -->
          <section id="top" class="hm-hero" data-scene>
            <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
            <div class="hm-scene-in hm-hero-in" data-scene-in>
              <div class="hm-hero-copy" data-quiet>
                <p class="status hm-eyebrow rise" data-when="open"><i aria-hidden="true"></i>{h.hero.eyebrow}</p>
                <p class="status hm-eyebrow rise" data-when="closed"><i aria-hidden="true"></i>{h.hero.eyebrowClosed}</p>
                <h1 class="rp-title wordin">{h.hero.title.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
                {(["open", "closed"] as const).map((st) => (
                  <ul class="hm-spec rise" data-when={st}>{h.hero.spec[st].map((f) => <li>{f}</li>)}</ul>
                ))}
              </div>
            </div>
          </section>

          <!-- 2. The system, beside what this is: the one action. -->
          <section id="intro" class="hm-scene" data-scene aria-label={h.intro.label}>
            <div class="hm-scene-in" data-scene-in>
              <div class="rp-wrap"><div class="hm-side" data-quiet>
                <p class="hm-side-lede">{h.intro.lede}</p>
                <div class="hm-people">
                  <ul class="hm-faces" aria-hidden="true">
                    {[1, 2, 3, 4, 5, 6, 7].map((n) => <li><img src={u(`/home/face-${n}.webp`)} alt="" width="192" height="192" loading="lazy" decoding="async" /></li>)}
                  </ul>
                  <p>{h.intro.people}</p>
                </div>
                <p class="rp-terms"><b>{h.intro.strong}</b> {h.intro.terms}</p>
                <div class="hm-actions">
                  <a class="btn" href={L.join} data-hero-cta>{h.intro.cta}</a>
                  <a class="textlink" href={L.login}>{h.intro.login}</a>
                </div>
                <p class="rp-account">{h.intro.note}</p>
              </div></div>
            </div>
          </section>

          <!-- 3. The weave: three of the system's orbits drawn down into a vortex beneath the orb, one triple helix. -->
          <section id="paths" class="hm-scene" data-scene aria-labelledby="paths-t">
            <div class="hm-scene-in" data-scene-in>
              <div class="rp-wrap"><div class="hm-side" data-quiet>
                <p class="kicker">{h.threads.kicker}</p>
                <h2 class="hm-side-h hm-triad" id="paths-t">{h.threads.title.split(/(?<=\.) /).map((t, i) => <>{i > 0 && " "}<span>{t}</span></>)}</h2>
                <p class="hm-side-p">{h.threads.lede}</p>
                <ol class="hm-strands">
                  {h.threads.items.map((t) => <li><a href={`#${t.id}`}><i class="gem" data-gem={t.id} aria-hidden="true"></i><b>{t.name}</b><span>{t.when}</span></a></li>)}
                </ol>
              </div></div>
            </div>
          </section>

          <!-- 4–6. Each path's own thread (src/components/HomeChapter.astro). -->
          <HomeChapter id="learn" c={ch.learn} />
          <HomeChapter id="build" c={ch.build} />
          <HomeChapter id="give" c={ch.give} />

          <!-- 7. The weave again: the three back together. -->
          <section id="together" class="hm-scene" data-scene aria-labelledby="together-t">
            <div class="hm-scene-in" data-scene-in>
              <div class="rp-wrap"><div class="hm-side" data-quiet>
                <p class="kicker">{h.together.kicker}</p>
                <h2 class="hm-side-h" id="together-t">{h.together.title}</h2>
                <p class="hm-side-p">{h.together.lede}</p>
              </div></div>
            </div>
          </section>

          <!-- 8. The system again, with a new Lab born in it: the one action, and the three ways in. -->
          <section id="start" class="hm-scene hm-close" data-scene aria-labelledby="start-t">
            <div class="hm-scene-in" data-scene-in>
              <div class="rp-wrap"><div class="hm-side" data-quiet>
                <h2 class="hm-side-h" id="start-t">{h.join.title}</h2>
                <p class="hm-side-p">{h.join.lede}</p>
                <ul class="hm-ways-in">
                  {h.threads.items.map((t) => <li><a href={pathJoin(t.path)}><i class="gem" data-gem={t.id} aria-hidden="true"></i><b>{t.name}</b><span>{t.then}</span><em aria-hidden="true">→</em></a></li>)}
                </ul>
                <div class="hm-actions">
                  <a class="btn" href={L.join}>{h.join.cta}</a>
                  <a class="ghost" href={L.donate}>{h.join.donate}</a>
                </div>
                <p class="rp-account">{h.join.note}</p>
              </div></div>
            </div>
          </section>
        </div>
      </div>

      <!-- The detail, after the journey, on the plain ground: the short version, then each path's own detail in
           the journey's order, how it began, and the cities. -->
      <section id="what" class="rp-sec rp-simple hm-after">
        <div class="rp-wrap">
          <div class="rp-head center reveal">
            <p class="kicker">{h.facts.kicker}</p>
            <h2 class="rp-h2">{h.facts.title}</h2>
          </div>
          <ul class="rp-facts">
            {h.facts.items.map((f) => (
              <li class="reveal">
                <i class={`mk mk-${glyph[f.icon] ?? "person"}`} aria-hidden="true"></i>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Learn: the next few workshops to drop into, and what they teach, then the room. -->
      <section id="sessions" class="rp-sec hm-sessions">
        <div class="rp-wrap">
          <div class="hm-head-row reveal">
            <div class="rp-head">
              <p class="kicker hm-k"><i class="gem" data-gem="learn" aria-hidden="true"></i>{h.sessions.kicker}</p>
              <h2 class="rp-h2">{h.sessions.title}</h2>
            </div>
            <a class="textlink" href={L.events}>{h.sessions.all} →</a>
          </div>
          <ol class="hm-events">
            {h.sessions.items.map((e) => (
              <li class="reveal">
                <p class="when"><b>{e.date}</b> {e.time}</p>
                <h3>{e.title}</h3>
                <p class="where">{e.where}</p>
              </li>
            ))}
          </ol>
          <ul class="hm-learn">
            {h.sessions.learn.map((l) => (
              <li class="reveal"><h3>{l.title}</h3><p>{l.body}</p></li>
            ))}
          </ul>
        </div>
      </section>

      <!-- The room: where it happens, and who's in it. -->
      <section class="hm-room" aria-labelledby="room-t">
        <img src={u("/home/room-1800.webp")} srcset={`${u("/home/room-900.webp")} 900w, ${u("/home/room-1800.webp")} 1800w`} sizes="100vw" alt={h.room.alt} width="1800" height="1350" loading="lazy" decoding="async" />
        <div class="rp-wrap hm-room-text reveal">
          <h2 class="rp-h2" id="room-t">{h.room.title}</h2>
          <p class="rp-lede-sm">{h.room.body}</p>
          <div class="hm-go"><a class="hm-path" href={pathJoin(go.learn.path)}><em>{go.learn.label}<small>{go.learn.note}</small></em><span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- Build: how a Build Cycle works, from a workshop to the Showcase and giving back; what it is and isn't;
           two Upskillers in their own words; then the next cycle, with the button. -->
      <section id="how" class="rp-sec rp-path">
        <div class="rp-wrap">
          <div class="rp-head reveal">
            <p class="kicker hm-k"><i class="gem" data-gem="build" aria-hidden="true"></i>{h.how.kicker}</p>
            <h2 class="rp-h2">{h.how.title}</h2>
          </div>
          <ol class="rp-steps" style={`--n: ${h.how.steps.length}`}>
            {h.how.steps.map((s, i) => (
              <li class:list={["reveal", s.mark && `is-${s.mark}`]}>
                <span class="dot" aria-hidden="true"></span>
                <p class="rp-step"><span class="no">{nos[i]}</span></p>
                <h3>{s.title}</h3>
                <p class="rp-body">{s.body}</p>
                {s.mark === "account" && <p class="rp-mark"><Fragment set:html={ACCT} />{h.how.markAccount}</p>}
                {s.mark === "button" && <p class="rp-mark"><img src={small("upskiller")} alt="" width="40" height="40" loading="lazy" />{h.how.markButton}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- What it is and isn't: a realistic preview, before anyone commits. The application itself, its dates and
           its questions are inside the account. -->
      <section id="before" class="rp-sec hm-honest">
        <div class="rp-wrap">
          <div class="rp-head reveal">
            <p class="kicker">{h.honest.kicker}</p>
            <h2 class="rp-h2">{h.honest.title}</h2>
          </div>
          <ul class="hm-isnt">
            {h.honest.items.map((it) => <li class="reveal"><h3>{it.title}</h3><p>{it.body}</p></li>)}
          </ul>
        </div>
      </section>

      <!-- Spotlights: two Upskillers, in their own words. -->
      <section id="spotlights" class="rp-sec hm-quotes">
        <div class="rp-wrap">
          <div class="rp-head reveal">
            <p class="kicker">{h.spotlights.kicker}</p>
            <h2 class="rp-h2">{h.spotlights.title}</h2>
          </div>
          <div class="hm-quote-row">
            {h.spotlights.items.map((q) => (
              <figure class="reveal">
                <img class="hm-portrait" src={u(`/home/${q.photo}.webp`)} alt={q.name} width="560" height="560" loading="lazy" decoding="async" />
                <blockquote>“{q.quote}”</blockquote>
                <figcaption><b>{q.name}</b> {q.role}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- The next Build Cycle, with the button every Upskiller gets. Open until it closes, then underway. -->
      <section id="cycle" class="hm-cycle">
        <div class="rp-wrap hm-cycle-in reveal">
          <div class="hm-cycle-text" data-when="open">
            <p class="status"><i aria-hidden="true"></i>{h.cycle.kicker}</p>
            <h2 class="rp-h2">{h.cycle.title}</h2>
            <p class="rp-lede-sm">{h.cycle.body}</p>
            <p class="hm-apply">{h.cycle.apply}</p>
            <a class="btn" href={pathJoin("build")}>{h.cycle.cta}</a>
          </div>
          <div class="hm-cycle-text" data-when="closed">
            <p class="status"><i aria-hidden="true"></i>{h.cycle.closed.kicker}</p>
            <h2 class="rp-h2">{h.cycle.closed.title}</h2>
            <p class="rp-lede-sm">{h.cycle.closed.body}</p>
            <ul class="hm-ways">
              {h.cycle.closed.ways.map((w) => <li><a class="textlink" href={w.to === "mentor" ? u("/mentor/") : L.events}>{w.label} →</a></li>)}
            </ul>
            <a class="btn" href={L.join}>{h.cycle.closed.cta}</a>
            <p class="hm-apply">{h.cycle.closed.note}</p>
          </div>
          <a class="hm-cycle-button" href={u("/upskiller/")} aria-label="The Upskiller button: what Upskillers do">
            <img src={u("/roles/upskiller/hero-760.webp")} alt="" width="760" height="760" loading="lazy" decoding="async" />
          </a>
        </div>
      </section>

      <!-- Pass it on: the ways to make The Labs better, then the way in. -->
      <section id="ways" class="rp-sec hm-give">
        <div class="rp-wrap">
          <div class="rp-head reveal">
            <p class="kicker hm-k"><i class="gem" data-gem="give" aria-hidden="true"></i>{ch.give.kicker}</p>
            <h2 class="rp-h2">{ch.give.heading}</h2>
          </div>
          <ul class="hm-three">
            {ch.give.ways.map((w) => (
              <li class="reveal">
                <h3>{w.title}</h3>
                <p class="rp-body">{w.body}</p>
                {w.to && <a class="textlink" href={giveTo[w.to]}>{w.link} →</a>}
              </li>
            ))}
          </ul>
          <div class="hm-go reveal"><a class="hm-path" href={pathJoin(go.give.path)}><em>{go.give.label}<small>{go.give.note}</small></em><span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- How it began and where it's going, then the cities. -->
      <section id="story" class="rp-sec rp-moments hm-story">
        <div class="rp-wrap">
          <div class="rp-head reveal">
            <p class="kicker">{h.story.kicker}</p>
            <h2 class="rp-h2">{h.story.title}</h2>
          </div>
          <ol class="rp-rows">
            {h.story.items.map((m, i) => (
              <li class="rp-row reveal">
                <p class="rp-step"><span class="no">{nos[i]}</span></p>
                <h3>{m.title}</h3>
                <p class="rp-body">{m.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Cities: where there's a Lab, and where there's a waitlist. -->
      <section id="cities" class="rp-sec hm-cities">
        <div class="rp-wrap rp-split">
          <div class="rp-head reveal">
            <p class="kicker">{h.cities.kicker}</p>
            <h2 class="rp-h2">{h.cities.title}</h2>
            <p class="rp-lede-sm">{h.cities.note}</p>
          </div>
          <ul class="hm-city-list reveal">
            {h.cities.items.map((c) => (
              <li class:list={{ active: c.active }}>
                <h3>{c.city}</h3>
                <p class="state"><i aria-hidden="true"></i>{c.status}</p>
                <p class="detail">{c.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="hm-foot">
      <div class="rp-wrap">
        <div class="hm-foot-top">
          <div class="hm-foot-brand">
            <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
            <p>{h.join.lede}</p>
            <a class="ghost small" href={L.donate}>{h.join.donate}</a>
          </div>
          <nav class="hm-foot-cols" aria-label="Footer">
            <div><p class="kicker">{h.footer.explore}</p><a href={L.events}>{h.footer.workshops}</a><a href="#build">{h.nav.build}</a><a href="#cities">{h.cities.title.replace(".", "")}</a></div>
            <div><p class="kicker">{h.footer.roles}</p>{list.roles.map((c) => <a href={u(`/${c.slug}/`)}>{c.name}</a>)}</div>
            <div><p class="kicker">{h.footer.community}</p><a href={L.about}>{h.footer.about}</a><a href={L.board}>{h.footer.board}</a><a href={L.contact}>{h.footer.contact}</a><a href={L.join}>{h.footer.member}</a></div>
            <div><p class="kicker">{h.footer.open}</p><a href={L.github}>{h.footer.built}</a><a href={L.join}>{h.nav.cta}</a></div>
          </nav>
        </div>
        <div class="hm-foot-mid">
          <p class="kicker">{h.footer.partners}</p>
          <div class="sponsors">
            <img src={u("/assets/dcpl-knockout-logo.png")} alt="DC Public Library" width="117" height="96" loading="lazy" />
            <img src={u("/assets/levy-strategic-design-white.png")} alt="Levy Strategic Design" width="198" height="96" loading="lazy" />
            <img src={u("/assets/superbloom-white.png")} alt="Superbloom Design" width="406" height="96" loading="lazy" />
          </div>
        </div>
        <div class="hm-foot-legal">
          <p>{h.footer.legal}</p>
          <p>{h.footer.google} <a class="textlink" href={L.privacy}>{h.footer.privacy} →</a></p>
          <p>{h.footer.rights} · {h.footer.license}</p>
          {h.placeholder && <p class="ph">Prototype for OLOS: sessions, cities and member counts are a snapshot from Sep 29, 2026.</p>}
        </div>
      </div>
    </footer>

    <script>
      import { openCovers } from "../scripts/covers";
      import { initMenu } from "../scripts/navmenu";
      import { mountOrbNet } from "../scripts/orbnet";

      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      initMenu();
      openCovers();

      // The journey's scenes. Each scene's words are held in place while any of it is on screen and cross-fade
      // with the next (the old one out, then the new one in), so words never scroll across the picture. The
      // last scene isn't held as it leaves: it scrolls away with the world, into the detail.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const scenes = ["top", "intro", "paths", "learn", "build", "give", "together", "start"].map((id) => document.getElementById(id)!);
      const inners = scenes.map((el) => el.querySelector<HTMLElement>("[data-scene-in]")!);
      const ons = scenes.map(() => 0);
      const smooth = (a: number, b: number, x: number) => { const t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      const syncCta = () => { const off = ons[1] > 0.5 || ons[ons.length - 1] > 0.25; head.classList.toggle("cta-off", off); cta.tabIndex = off ? -1 : 0; };
      const place = () => {
        const vh = window.innerHeight, n = scenes.length;
        scenes.forEach((el, i) => {
          const r = el.getBoundingClientRect(), inner = inners[i];
          let y = 0, op = 1;
          if (i > 0 && r.top > 0) { y = -r.top; op = Math.min(op, 1 - smooth(0.35, 0.65, r.top / vh)); }
          if (i < n - 1 && r.bottom < vh) { y = vh - r.bottom; op = Math.min(op, 1 - smooth(0, 0.3, (vh - r.bottom) / vh)); }
          if (r.top >= vh || r.bottom <= 0) op = 0;
          inner.style.transform = y ? `translate3d(0, ${y.toFixed(1)}px, 0)` : "";
          inner.style.opacity = op.toFixed(3);
          inner.style.pointerEvents = op < 0.5 ? "none" : "";
          ons[i] = op;
        });
        syncCta();
      };
      let placing = 0;
      const placeSoon = () => { if (!placing) placing = requestAnimationFrame(() => { placing = 0; place(); }); };
      window.addEventListener("scroll", placeSoon, { passive: true });
      window.addEventListener("resize", placeSoon);
      place();
      // Tabbing into a scene's link brings its scene to the middle of the screen, so it's never focused unseen.
      scenes.forEach((el, i) => el.addEventListener("focusin", () => {
        if (ons[i] > 0.9) return;
        const top = el.getBoundingClientRect().top + window.scrollY + Math.max(0, el.offsetHeight - window.innerHeight) / 2;
        window.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
      }));
      // The pause shows while the journey is on screen.
      let inJourney = true;
      new IntersectionObserver(([e]) => { inJourney = e.isIntersecting; root.classList.toggle("in-journey", inJourney); }).observe(document.querySelector("[data-journey]")!);

      // The world: the live model behind the journey, its camera and its motif following the scenes. Reduced
      // motion gets it still (it still follows the page); without WebGL 2 the poster stays.
      const orbMode = new URLSearchParams(location.search).get("orb");
      const still = reduce || orbMode === "still" || orbMode === "poster";
      const world = document.querySelector<HTMLElement>("[data-world]")!;
      const card = world.querySelector<HTMLElement>("[data-card]")!;
      const cardMk = card.querySelector<HTMLElement>("[data-card-mk]")!, cardKind = card.querySelector<HTMLElement>("[data-card-kind]")!;
      const cardTitle = card.querySelector<HTMLElement>("[data-card-title]")!, cardDetail = card.querySelector<HTMLElement>("[data-card-detail]")!;
      let cardWas = "", sysNow = 1;
      const pause = document.querySelector<HTMLButtonElement>("[data-pause]")!;
      const orbLink = document.querySelector<HTMLAnchorElement>("[data-orb-link]")!;
      // One orb at a time: while the world's orb is on screen, the header carries the wordmark alone; when it
      // leaves (the weave's threads, or the detail), the mark comes back.
      const brand = document.querySelector<HTMLElement>("[data-brand]")!;
      let dockM = 0;
      const net = mountOrbNet(world.querySelector<HTMLElement>("[data-orbnet]")!, {
        still, poster: orbMode === "poster", anchors: scenes, stage: document.body,
        faces: JSON.parse(world.dataset.faces ?? "[]"), words: JSON.parse(world.dataset.words ?? "{}"),
        // Anything in the system can be asked what it is, while the system is the picture.
        inspectable: () => inJourney && sysNow > 0.7,
        onFrame: (f) => {
          sysNow = f.sys;
          // The card: beside what you're pointing at, flipped to its left near the right edge.
          const hv = f.hover;
          card.classList.toggle("on", !!hv);
          if (hv) {
            const was = hv.type + hv.title + hv.detail;
            if (was !== cardWas) { cardWas = was; cardMk.className = `mk mk-${hv.type}`; cardKind.textContent = hv.kind; cardTitle.textContent = hv.title; cardDetail.textContent = hv.detail; }
            const flip = hv.x > window.innerWidth - 300;
            card.style.transform = `translate(${(flip ? hv.x - hv.r - 14 : hv.x + hv.r + 14).toFixed(1)}px, ${hv.y.toFixed(1)}px) translate(${flip ? "-100%" : "0"}, -50%)`;
          }
          // The orb is the button while the whole system holds the screen under the title: a link laid over it.
          const show = ons[0] * Math.max(0, 1 - f.s * 4);
          orbLink.style.transform = `translate(${(f.orb.x - f.orb.r).toFixed(1)}px, ${(f.orb.y - f.orb.r).toFixed(1)}px)`;
          orbLink.style.width = orbLink.style.height = `${(f.orb.r * 2).toFixed(1)}px`;
          orbLink.style.setProperty("--show", show.toFixed(3));
          orbLink.style.visibility = show > 0.05 ? "visible" : "hidden";
          const onScreen = inJourney && f.orb.r > 14 && f.orb.y > -f.orb.r * 0.5 && f.orb.y < window.innerHeight + f.orb.r ? 1 : 0;
          dockM += (1 - onScreen - dockM) * 0.15;
          brand.style.setProperty("--m", dockM.toFixed(3));
        },
      });
      if (!net) { brand.style.setProperty("--m", "1"); orbLink.hidden = true; }
      if (!net || still) pause.hidden = true;
      if (net) {
        // The orb is Join The Labs: pressing it sets off the one big pulse (the orb flares, a wave crosses the
        // orbits, sparks go out to every Lab), then the account opens. A new-tab click, reduced motion or a paused
        // model skip straight to the link.
        orbLink.addEventListener("click", (e) => {
          if (reduce || net.paused() || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          net.join();
          window.setTimeout(() => { window.location.href = orbLink.href; }, 1100);
        });
        const hov = (v: boolean) => () => net.setOrbHover(v);
        orbLink.addEventListener("pointerenter", hov(true)); orbLink.addEventListener("pointerleave", hov(false));
        orbLink.addEventListener("focus", hov(true)); orbLink.addEventListener("blur", hov(false));
      }
      pause.addEventListener("click", () => {
        if (!net) return;
        const v = !net.paused(); net.setPaused(v);
        pause.setAttribute("aria-pressed", String(v));
        pause.setAttribute("aria-label", v ? pause.dataset.playLabel! : pause.dataset.pauseLabel!);
        pause.querySelector("span")!.textContent = v ? pause.dataset.playText! : pause.dataset.pauseText!;
      });
    </script>
  </body>
</html>
