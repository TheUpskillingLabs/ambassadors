---
/* / — the public Ambassador Program page (the site's front door; /join/ redirects here), built from the design mockup
   (Main.dc.html). A standalone page: its own header and footer, dark
   throughout. Copy lives in content/site/join.json; media in public/join/.
   The hero is the Ambassador button in live 3D (src/scripts/button3d.ts, on
   the pin's 3D bundle, public/join/pin3d.js), loaded after the page on wide
   screens with a mouse. It turns to face the pointer; a Cycles still of the
   same button shows while it loads, on phones, with reduced motion, and
   without WebGL. */
import "@fontsource-variable/geologica/wght.css";
import "../styles/join.css";
import { guideHome } from "../lib/content";
import { u } from "../lib/url";
import j from "../../content/site/join.json";
import { slots, founders } from "../lib/roster";
import JoinCover from "../components/JoinCover.astro";

const media = (f: string) => u(`/join/${f}`);
const still = media("hero-button-760.webp");
const stillSet = `${media("hero-button-760.webp")} 760w, ${media("hero-button-1200.webp")} 1200w`;
const apply = u("/apply/");
const pageTitle = `${j.title} · The Upskilling Labs`;

// Our why: the manifesto, split into letters so the page can brighten it
// letter by letter as you read down (its one effect). Screen readers get the
// plain sentence; the letters are hidden from them.
const manifestoText = j.you.statement.join(" ");
const manifestoWords = manifestoText.split(/\s+/).map((w) => [...w]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={j.description} />
    <meta name="theme-color" content="#00141B" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={j.description} />
    <meta property="og:image" content={new URL(media("button-share.jpg"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={j.hero.buttonAlt} />
    <link rel="icon" href={u("/favicon.png")} type="image/png" />
    <link rel="preload" as="image" href={still} imagesrcset={stillSet} imagesizes="min(760px, 94vw, 56vh)" fetchpriority="high" />
  </head>
  <body class="jp">
    <a class="skip" href="#main">Skip to content</a>
    <header class="jp-head" data-head>
      <nav aria-label="Ambassador program">
        <a class="jp-brand" href="#top">
          <img src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" />
          <span class="wide-only">{j.nav.brand}</span>
        </a>
        <ul class="jp-links">
          <li><a class="navlink" href="#you" data-spy="you labs team ripple goal">{j.nav.why}</a></li>
          <li><a class="navlink" href="#path" data-spy="path">{j.nav.how}</a></li>
          <li><a class="navlink" href="#commit" data-spy="commit join">{j.nav.commit}</a></li>
        </ul>
        <div class="jp-end">
          <a class="navlink wide-only" href={guideHome}>{j.nav.guide}</a>
          <a class="btn" href={apply} data-head-cta><span class="wide-only">{j.nav.cta}</span><span class="narrow-only">{j.nav.ctaShort}</span></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="jp-hero">
        <span class="jp-sentinel" data-top-sentinel aria-hidden="true"></span>
        <div class="stage">
          <h1 class="wordin">{j.hero.title[0]}<br />{j.hero.title[1]}</h1>
          <div class="jp-pin pinin">
            <div class="bob" role="img" aria-label={j.hero.buttonAlt} data-pin3d={media("pin3d.js")} data-art={media("button-art.webp")}>
              <img src={still} srcset={stillSet} sizes="min(760px, 94vw, 56vh)" alt="" width="760" height="760" fetchpriority="high" data-still />
              <canvas aria-hidden="true" data-pin-canvas></canvas>
            </div>
          </div>
        </div>
        <p class="lede-hero rise d1">{j.hero.lede}</p>
        <div class="ctas rise d2">
          <a class="btn" href={apply}>{j.hero.cta}</a>
          <a class="ghost" href="#you">{j.hero.secondary}<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5v11M2.5 8 7 12.5 11.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
        <p class="status rise d3"><i aria-hidden="true"></i>{j.hero.status}</p>
      </section>

      <section id="you" class="jp-sec jp-you">
        <div class="wrap">
          <p class="kicker reveal">{j.you.kicker}</p>
          <p class="jp-manifesto" data-manifesto>
            <span class="sr">{manifestoText}</span>
            <span aria-hidden="true">{manifestoWords.map((w, wi) => <>{wi > 0 && " "}<span class="w">{w.map((c) => <span class="c">{c}</span>)}</span></>)}</span>
          </p>
        </div>
      </section>

      <JoinCover n={0} />

      <section id="labs" class="jp-labs">
        <div class="jp-split">
          <div class="reveal">
            <p class="kicker">{j.labs.kicker}</p>
            <h2 class="h2">{j.labs.title}</h2>
            <p class="lede">{j.labs.lede}</p>
          </div>
          <dl class="jp-habits reveal">
            {j.labs.habits.map((h) => <div><dt>{h.title}</dt><dd>{h.body}</dd></div>)}
          </dl>
        </div>
      </section>

      <section id="team" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{j.team.kicker}</p>
            <h2 class="h2" style="max-width: 900px">{j.team.title}</h2>
            <p class="lede" style="max-width: 640px">{j.team.lede}</p>
          </div>
          <ol class="jp-cols three jp-moments reveal">
            {j.team.roles.map((r) => (
              <li class="jp-col">
                <img class="icon" src={media(`moment-${r.icon}.webp`)} alt="" width="128" height="128" loading="lazy" />
                <p class="label">{r.step}</p><h3>{r.title}</h3><p>{r.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <JoinCover n={1} />

      <section id="ripple" class="jp-sec jp-ripple">
        <div class="jp-split">
          <div class="reveal">
            <p class="kicker">{j.ripple.kicker}</p>
            <h2 class="h2">{j.ripple.title}</h2>
            <p class="lede">{j.ripple.lede}</p>
            <ol class="jp-rings">
              {j.ripple.rings.map((r) => (
                <li><span class="ring" aria-hidden="true"></span><div><h3>{r.title}</h3><p>{r.body}</p></div></li>
              ))}
            </ol>
            <p class="jp-note">{j.ripple.note}</p>
          </div>
          <div class="jp-orbits reveal">
            <div class="bleed">
              <video data-loop poster={media("orbits.jpg")} muted loop playsinline preload="metadata" aria-label={j.ripple.videoLabel}>
                <source src={media("orbits-600.webm")} type="video/webm" media="(max-width: 680px)" />
                <source src={media("orbits-600.mp4")} type="video/mp4" media="(max-width: 680px)" />
                <source src={media("orbits.webm")} type="video/webm" />
                <source src={media("orbits.mp4")} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </section>

      <section id="goal" class="jp-sec jp-goal">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{j.goal.kicker}</p>
            <h2 class="h2" style="max-width: 900px">{j.goal.title}</h2>
          </div>
          <div class="jp-cols jp-stats reveal">
            {j.goal.stats.map((s) => (
              <div class:list={["jp-stat", { accent: s.accent }]}><p class="v">{s.value}</p><p class="l">{s.label}</p></div>
            ))}
          </div>
          <div class="jp-roster reveal">
            <p class="kicker">{j.goal.roster.kicker}</p>
            <ol aria-label={j.goal.roster.label.replace("{filled}", String(founders.length)).replace("{slots}", String(slots))}>
              {Array.from({ length: slots }, (_, i) => founders[i]).map((r, i) => (
                <li class:list={{ in: Boolean(r) }}><span class="n">{String(i + 1).padStart(2, "0")}</span>{r ? <><b>{r.first}</b><span class="a">{r.area}</span></> : <span class="open">{j.goal.roster.open}</span>}</li>
              ))}
            </ol>
          </div>
          <div class="jp-goal-foot">
            <p class="lede reveal">{j.goal.note}</p>
            <figure class="jp-quote reveal">
              <blockquote><span class="q" aria-hidden="true">“</span>{j.goal.quote.text}<span class="q" aria-hidden="true">”</span></blockquote>
              <figcaption><b>{j.goal.quote.name}</b><span>{j.goal.quote.role}</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <JoinCover n={2} />

      <section id="path" class="jp-sec jp-path">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{j.path.kicker}</p>
            <h2 class="h2">{j.path.title[0]}<br />{j.path.title[1]}</h2>
            <p class="lede" style="max-width: 640px">{j.path.lede}</p>
          </div>
          <div class="jp-how" data-how>
            <div class="jp-how-visual" aria-hidden="true">
              <img src={media("button-800.webp")} alt="" width="800" height="800" loading="lazy" data-how-visual="button" class="on" />
            </div>
            <ol class="jp-steps reveal">
              {j.path.steps.map((s, i) => (
                <li class:list={{ milestone: s.milestone }} data-how-step={s.reward}><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.body}</p></li>
              ))}
            </ol>
          </div>
          <div class="jp-rewards reveal">
            <div id="button" class="jp-reward">
              <img src={media(j.path.button.image)} alt={j.path.button.alt} loading="lazy" width="180" height="180" />
              <div><p class="kicker">{j.path.button.kicker}</p><h3>{j.path.button.title}</h3><p>{j.path.button.body}</p></div>
            </div>
            <div id="members" class="jp-reward jp-members">
              <!-- Two doors that overlap: you can be both. -->
              <svg class="venn" viewBox="0 0 132 132" aria-hidden="true">
                <defs><clipPath id="venn-a"><circle cx="50" cy="66" r="38" /></clipPath></defs>
                <circle cx="82" cy="66" r="38" clip-path="url(#venn-a)" class="both" />
                <circle cx="50" cy="66" r="38" class="a" />
                <circle cx="82" cy="66" r="38" class="b" />
              </svg>
              <div>
                <p class="kicker">{j.path.members.kicker}</p><h3>{j.path.members.title}</h3><p>{j.path.members.body}</p>
                <dl class="doors">
                  {j.path.members.doors.map((d, i) => (
                    <div class={i ? "b" : "a"}><dt>{d.name}</dt><dd>{d.body}</dd></div>
                  ))}
                </dl>
              </div>
            </div>
          </div>
          <p class="jp-cta-row reveal"><a class="btn" href={apply}>{j.path.cta}</a></p>
        </div>
      </section>

      <section id="faq" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{j.faq.kicker}</p>
            <h2 class="h2">{j.faq.title}</h2>
          </div>
          <div class="jp-faq reveal">
            {j.faq.items.map((f) => (
              <details><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>
            ))}
          </div>
          <p class="jp-cta-row reveal"><a class="btn" href={apply}>{j.faq.cta}</a></p>
        </div>
      </section>

      <section id="commit" class="jp-sec">
        <div class="wrap">
          <div class="reveal">
            <p class="kicker">{j.commit.kicker}</p>
            <h2 class="h2">{j.commit.title}</h2>
          </div>
          <div class="jp-cols three reveal">
            {j.commit.items.map((it) => (
              <div class="jp-col"><p class="label">{it.label}</p><h3>{it.title}</h3><p>{it.body}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section id="join" class="jp-join">
        <div class="wrap reveal" style="position: relative">
          <h2>{j.join.title}</h2>
          <p class="lede">{j.join.lede}</p>
          <div class="row">
            <a class="btn" href={apply}>{j.join.cta}</a>
            <p class="status"><i aria-hidden="true"></i>{j.hero.status}</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="jp-foot">
      <div class="wrap">
        <div class="col">
          <img class="logo" src={u("/assets/logo-lockup-white.png")} alt="The Upskilling Labs" width="392" height="144" loading="lazy" />
          <p>{j.footer.legal}</p>
          <p>{j.footer.rights}</p>
          <p>{j.footer.renders}</p>
          <p><a class="textlink" href={guideHome}>{j.footer.guide} →</a></p>
          {j.placeholder && <p class="ph">[PLACEHOLDER] draft copy: [N] and the join link are still to be set.</p>}
        </div>
        <div class="col">
          <p class="kicker">{j.footer.sponsors}</p>
          <div class="sponsors">
            <img src={u("/assets/dcpl-knockout-logo.png")} alt="DC Public Library" width="117" height="96" loading="lazy" />
            <img src={u("/assets/superbloom-white.png")} alt="Superbloom Design" width="406" height="96" loading="lazy" />
          </div>
        </div>
      </div>
    </footer>

    <script>
      import { mountButton } from "../scripts/button3d";
      import { openCovers } from "../scripts/covers";

      // Nav: transparent over the hero, solid once you scroll; the link for the
      // section in view is marked; the header button steps aside at the join section.
      const root = document.documentElement;
      const head = document.querySelector<HTMLElement>("[data-head]")!;
      new IntersectionObserver(([e]) => { root.dataset.scrolled = String(!e.isIntersecting); })
        .observe(document.querySelector("[data-top-sentinel]")!);
      const cta = head.querySelector<HTMLAnchorElement>("[data-head-cta]")!;
      new IntersectionObserver(([e]) => {
        head.classList.toggle("cta-off", e.isIntersecting);
        cta.tabIndex = e.isIntersecting ? -1 : 0;
      }, { threshold: 0.25 }).observe(document.getElementById("join")!);
      const links = [...head.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
      const order = ["you", "labs", "team", "ripple", "goal", "path", "faq", "commit", "join"].map((id) => document.getElementById(id)!);
      let queued = false;
      const spy = () => {
        queued = false;
        const line = innerHeight * 0.35;
        const current = order.filter((el) => el.getBoundingClientRect().top <= line).pop()?.id ?? "";
        links.forEach((a) => (a.dataset.spy!.split(" ").includes(current) ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(spy); } }, { passive: true });
      spy();

      // Chapter covers: opened as they come into view where scroll timelines aren't supported.
      openCovers();

      // How it works: the step crossing the middle of the screen is the active
      // one, and the sticky picture shows its reward (each step names its own; all are the button for now).
      const how = document.querySelector<HTMLElement>("[data-how]")!;
      const howSteps = [...how.querySelectorAll<HTMLElement>("[data-how-step]")];
      const howVisuals = [...how.querySelectorAll<HTMLElement>("[data-how-visual]")];
      howSteps[0].classList.add("active");
      const howIo = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const step = e.target as HTMLElement;
        howSteps.forEach((st) => st.classList.toggle("active", st === step));
        howVisuals.forEach((v) => v.classList.toggle("on", v.dataset.howVisual === step.dataset.howStep));
      }), { rootMargin: "-45% 0px -45% 0px" });
      howSteps.forEach((st) => howIo.observe(st));

      // Our why: the manifesto brightens letter by letter, line by line, as you
      // scroll: it starts as the block rises past 85% of the screen and is fully
      // bright once its centre passes 55%. Scrolling back up dims it again. That's
      // its one effect. Reduced motion: it's simply bright.
      const manifesto = document.querySelector<HTMLElement>("[data-manifesto]");
      if (manifesto && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const letters = [...manifesto.querySelectorAll<HTMLElement>(".c")];
        manifesto.classList.add("dim");
        let lit = 0, near = false, queued = false;
        const paint = () => {
          queued = false;
          const r = manifesto.getBoundingClientRect();
          const start = innerHeight * 0.85, end = Math.min(start - 1, innerHeight * 0.55 - r.height / 2);
          const n = Math.max(0, Math.min(letters.length, Math.round(((start - r.top) / (start - end)) * letters.length)));
          for (let i = Math.min(n, lit); i < Math.max(n, lit); i++) letters[i].classList.toggle("lit", i < n);
          lit = n;
        };
        new IntersectionObserver(([e]) => { near = e.isIntersecting; if (near) paint(); }, { rootMargin: "25% 0px" }).observe(manifesto);
        addEventListener("scroll", () => { if (near && !queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
        addEventListener("resize", paint, { passive: true });
        paint();
      }

      // Videos: muted inline loops, started here too (some browsers ignore autoplay).
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      const videos = document.querySelectorAll<HTMLVideoElement>("video[data-loop]");
      if (!reduce && !saveData) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
        }));
        videos.forEach((v) => { v.muted = true; io.observe(v); });

        // Hero button: live 3D on wide screens with a mouse, after the page has loaded.
        // It turns to face a mouse or pen through a soft spring, and drifts on its
        // own after a few seconds without the pointer moving. The same behaviour
        // the pin had (poses are the Blender rig's, in degrees); the button is
        // built on the pin's 3D bundle in src/scripts/button3d.ts.
        const stage = document.querySelector<HTMLElement>("[data-pin3d]")!;
        const canvas = stage.querySelector<HTMLCanvasElement>("[data-pin-canvas]")!;
        const hero = document.getElementById("top")!;
        const SPIN_LEFT = 24, SPIN_RIGHT = -36, TILT_UP = 14, TILT_DOWN = -14;
        const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
        const soft = (v: number) => Math.sign(v) * Math.pow(Math.abs(v), 0.8);
        // WebGL on a real GPU only: software renderers (no GPU, and headless test
        // browsers) draw the button on the CPU, which stalls the page; they keep the still.
        // "?pin3d=force" skips that check, for testing.
        const force = new URLSearchParams(location.search).has("pin3d");
        const webgl = () => {
          try {
            const gl = document.createElement("canvas").getContext("webgl2");
            if (!gl) return false;
            if (force) return true;
            const info = gl.getExtension("WEBGL_debug_renderer_info");
            const name = String(info ? gl.getParameter(info.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER));
            return !/swiftshader|llvmpipe|softpipe|software|basic render/i.test(name);
          } catch { return false; }
        };
        let px = 0, py = 0, pt = 0;
        addEventListener("pointermove", (e) => { if (e.pointerType === "touch") return; px = e.clientX; py = e.clientY; pt = performance.now(); }, { passive: true });
        addEventListener("pointerout", (e) => { if (!e.relatedTarget) pt = 0; });
        const mount = () => {
          mountButton(stage.dataset.pin3d!, canvas, stage.dataset.art!).then((pin) => {
            let size = 0, dpr = 1, scale = 1, drawn = false, n = 0, sum = 0, raf = 0;
            const c = { s: 0, t: 0, vs: 0, vt: 0 };
            const t0 = performance.now(); let last = t0;
            // Off screen, the loop stops entirely; it restarts when the hero comes back.
            let onScreen = true;
            new IntersectionObserver(([e]) => {
              onScreen = e.isIntersecting;
              if (onScreen && !raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
            }).observe(hero);
            const tick = (now: number) => {
              if (!onScreen) { raf = 0; return; }
              raf = requestAnimationFrame(tick);
              const dt = Math.min(0.05, (now - last) / 1000); last = now;
              // Up to 2x, capped near 1400 px across, stepped down if frames run slow.
              const cs = Math.round(canvas.clientWidth);
              let dirty = false;
              if (cs && cs !== size) { size = cs; dpr = Math.min(devicePixelRatio || 1, 2, 1400 / size) * scale; pin.resize(size, dpr); dirty = true; }
              let ts: number, tt: number;
              if (pt && now - pt < 3500) {
                const r = canvas.getBoundingClientRect();
                const hw = Math.min(innerWidth, 1800) * 0.5, hh = Math.min(innerHeight, 1000) * 0.5;
                const nx = soft(clamp((px - (r.left + r.width / 2)) / hw, -1, 1));
                const ny = soft(clamp((py - (r.top + r.height / 2)) / hh, -1, 1));
                ts = nx < 0 ? -nx * SPIN_LEFT : nx * SPIN_RIGHT;
                tt = ny < 0 ? -ny * TILT_UP : ny * TILT_DOWN;
              } else {
                const s = (now - t0) / 1000;
                ts = -6 + 15 * Math.sin((s * 2 * Math.PI) / 10);
                tt = -3 + 6 * Math.sin((s * 2 * Math.PI) / 7 + 1);
              }
              // A soft spring: quick to answer, no jitter, a whisper of overshoot.
              const k = 70, d = 2 * Math.sqrt(k) * 0.85;
              c.vs += ((ts - c.s) * k - c.vs * d) * dt; c.s += c.vs * dt;
              c.vt += ((tt - c.t) * k - c.vt * d) * dt; c.t += c.vt * dt;
              const moving = Math.abs(ts - c.s) + Math.abs(tt - c.t) + Math.abs(c.vs) + Math.abs(c.vt) > 0.002;
              if (!(moving || dirty || !drawn)) return;
              pin.setPose(c.s, c.t);
              pin.render();
              if (!drawn) { drawn = true; stage.classList.add("live"); }
              n++; sum += dt;
              if (n >= 40) { if (sum / n > 0.024 && dpr > 1) { scale *= 0.8; size = 0; } n = 0; sum = 0; }
            };
            raf = requestAnimationFrame(tick);
            addEventListener("pagehide", () => { cancelAnimationFrame(raf); pin.dispose(); }, { once: true });
          }).catch(() => {}); // no WebGL after all: the still stays
        };
        const start = () => {
          // Phones, touch-only devices and no WebGL keep the still (1.2 MB of script otherwise).
          if (!matchMedia("(hover: hover) and (pointer: fine) and (min-width: 900px)").matches || !webgl()) return;
          mount();
        };
        // After the page has loaded and gone quiet, so it never competes with the intro.
        const later = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 1200));
        if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
      }
    </script>
  </body>
</html>
