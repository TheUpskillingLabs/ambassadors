---
/* Home — one next step, not a menu.
   1. Event countdown (only when an event is within 14 days).
   2. Up next: make your plan → next unread page → send your 3 invites →
      present. One card that changes state.
   3. Your path as a plain list, plus "Stuck? Text your coordinator".
      Finishing the path earns the ambassador pin (design/pin/), so the
      pin sits under the title and the coordinator line turns into the claim.
   Refreshers, Deck and Help live in the tab bar. */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Orb from "../components/Orb.astro";
import Row from "../components/Row.astro";
import CoordinatorLink from "../components/CoordinatorLink.astro";
import { u } from "../lib/url";
import { t } from "../lib/i18n";
import { readinessPath } from "../lib/content";
const path = await readinessPath();
const pathData = path.map((g) => ({ id: g.id, cover: g.cover, title: g.title, href: g.href, kind: g.kind, steps: g.steps.map((s) => ({ id: s.id, title: s.title, href: s.href, readTime: s.readTime })) }));
const states = {
  plan: { title: t("home.upPlan"), sub: t("home.upPlanSub"), href: u("/welcome/"), cover: "cover" },
  invite: { title: t("home.upInvite"), sub: t("home.upInviteSub"), href: u("/playbooks/conversation/invite/"), cover: "teal" },
  present: { title: t("home.upPresent"), sub: t("home.upPresentSub"), href: u("/present/"), cover: "cover" },
};
---
<Base nav="home">
  <div class="wrap">
    <section class="hello">
      <h1 class="only-first">{t("home.firstTitle")}</h1>
      <h1 class="only-returning">{t("home.returningTitle")}</h1>
      <p class="pin-goal"><img src={u("/pin.svg")} width="40" height="40" alt="" />{t("home.pin")}</p>
    </section>

    <div class="home2" data-home={JSON.stringify(pathData)} data-states={JSON.stringify(states)}
      data-of-read={t("home.groupOfRead")} data-done={t("home.groupDone")} data-story-saved={t("home.storySaved")}
      data-story-not={t("home.storyNotYet")} data-ready={t("home.readiness")} data-if-then={t("home.ifThen")}>

      <section class="event-card s-cover grain" data-event-card hidden
        data-today={t("event.today")} data-tomorrow={t("event.tomorrow")} data-days={t("event.days")}
        data-refresh-conv={u("/refreshers/conversation/")} data-refresh-room={u("/refreshers/room/")} data-practice={u("/practice/")}>
        <Orb class="ev-orb" />
        <div class="ev-inner on-dark">
          <p class="kicker" data-ev-when></p>
          <p class="ev-count" data-ev-count></p>
          <ol class="ev-plan">
            <li><a class="ev-step" href="#" data-ev-refresh><span class="ev-n">1</span><span><b>{t("event.step1")}</b></span><Icon name="chevron" size={18} /></a></li>
            <li><a class="ev-step" href="#" data-ev-practice><span class="ev-n">2</span><span><b>{t("event.step2")}</b></span><Icon name="chevron" size={18} /></a></li>
            <li><a class="ev-step" href={u("/present/?practice")}><span class="ev-n">3</span><span><b>{t("event.step3")}</b></span><Icon name="chevron" size={18} /></a></li>
          </ol>
        </div>
      </section>

      <section>
        <div class="rail-head"><h2 class="rail-title">{t("home.upNext")}</h2></div>
        <a class="row up-row" href={states.plan.href} data-upnext>
          <span class="row-main">
            <span class="row-title" data-up-title>{states.plan.title}</span>
            <span class="row-sub" data-up-sub>{states.plan.sub}</span>
          </span>
          <span class="up-go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        <p class="if-then" data-if-then-line hidden></p>
      </section>

      <section>
        <div class="rail-head"><h2 class="rail-title">{t("home.pathTitle")}</h2><span class="rail-meta" data-readiness></span></div>
        <ol class="rows">
          {pathData.map((g, i) => (
            <li><Row href={g.href} title={g.title} lead={String(i + 1)} check attrs={{ "data-group": g.id }}><span slot="sub" class="row-sub" data-group-sub></span></Row></li>
          ))}
        </ol>
      </section>

      <p class="stuck" data-stuck><CoordinatorLink label={t("coord.stuck")} /></p>
      <p class="stuck" data-claim hidden><CoordinatorLink label={t("coord.pin")} /></p>
    </div>
  </div>

  <script>
    import { progress, story, profile, asks, daysUntil } from "../lib/store";
    type Step = { id: string; title: string; href: string; readTime: number };
    type Group = { id: string; cover: string; title: string; href: string; kind: "pages" | "story"; steps: Step[] };
    type State = { title: string; sub: string; href: string; cover: string };
    const root = document.querySelector<HTMLElement>("[data-home]")!;
    const groups: Group[] = JSON.parse(root.dataset.home!);
    const states: Record<string, State> = JSON.parse(root.dataset.states!);
    const d = root.dataset;

    function paint() {
      const read = progress.all();
      const p = profile.get();
      const hasStory = Boolean(story.get().draft.trim());
      let done = 0;
      let next: { step: Step; group: Group; r: number } | null = null;
      for (const g of groups) {
        const a = root.querySelector<HTMLAnchorElement>(`[data-group="${g.id}"]`)!;
        const sub = a.querySelector<HTMLElement>("[data-group-sub]")!;
        let complete: boolean;
        if (g.kind === "story") {
          complete = hasStory;
          sub.textContent = hasStory ? d.storySaved! : d.storyNot!;
          if (!hasStory && !next) next = { step: { id: "story", title: g.title, href: g.href, readTime: 10 }, group: g, r: 0 };
        } else {
          const r = g.steps.filter((x) => read[x.id]).length;
          complete = r === g.steps.length;
          sub.textContent = complete ? d.done! : d.ofRead!.replace("{n}", String(r)).replace("{total}", String(g.steps.length));
          const firstUnread = g.steps.find((x) => !read[x.id]);
          if (firstUnread && !next) next = { step: firstUnread, group: g, r };
          if (firstUnread && r > 0) a.href = firstUnread.href;
        }
        a.classList.toggle("is-read", complete);
        if (complete) done++;
      }
      const all = done === groups.length;
      root.querySelector<HTMLElement>("[data-stuck]")!.hidden = all;
      root.querySelector<HTMLElement>("[data-claim]")!.hidden = !all;
      document.querySelector<HTMLElement>(".pin-goal")!.hidden = all;
      root.querySelector("[data-readiness]")!.textContent = d.ready!.replace("{n}", String(done)).replace("{total}", String(groups.length));

      // One next step: plan → next page → send invites → present.
      const up = root.querySelector<HTMLAnchorElement>("[data-upnext]")!;
      const set = (title: string, sub: string, href: string, _variant?: string) => {
        up.href = href;
        up.querySelector("[data-up-title]")!.textContent = title;
        up.querySelector("[data-up-sub]")!.textContent = sub;
      };
      const sent = asks.get().filter((x) => x.sent).length;
      if (!p.onboarded) set(states.plan.title, states.plan.sub, states.plan.href, states.plan.cover);
      else if (next) set(next.r === 0 ? next.group.title : next.step.title, next.r === 0 ? `${next.step.readTime} min` : `${next.group.title} · ${next.step.readTime} min`, next.step.href, next.group.cover);
      else if (sent < 3) set(states.invite.title, states.invite.sub.replace("{n}", String(3 - sent)), states.invite.href, states.invite.cover);
      else set(states.present.title, states.present.sub, states.present.href, states.present.cover);

      const line = root.querySelector<HTMLElement>("[data-if-then-line]")!;
      if (p.planWhere && p.planWho) { line.textContent = d.ifThen!.replace("{where}", p.planWhere).replace("{who}", p.planWho); line.hidden = false; }

      // Event mode: countdown and a 2-minute plan for the next 14 days.
      const card = root.querySelector<HTMLElement>("[data-event-card]")!;
      if (p.eventDate) {
        const days = daysUntil(p.eventDate);
        if (days >= 0 && days <= 14) {
          const [y, m, dd] = p.eventDate.split("-").map(Number);
          card.querySelector("[data-ev-when]")!.textContent = new Date(y, m - 1, dd).toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
          card.querySelector("[data-ev-count]")!.textContent = days === 0 ? card.dataset.today! : days === 1 ? card.dataset.tomorrow! : card.dataset.days!.replace("{n}", String(days));
          const mode = p.mode === "room" ? "room" : "conversation";
          card.querySelector<HTMLAnchorElement>("[data-ev-refresh]")!.href = mode === "room" ? card.dataset.refreshRoom! : card.dataset.refreshConv!;
          card.querySelector<HTMLAnchorElement>("[data-ev-practice]")!.href = `${card.dataset.practice}?mode=${mode}`;
          card.hidden = false;
        }
      }
    }
    paint();
    document.addEventListener("ag:progress", paint);
  </script>
</Base>
