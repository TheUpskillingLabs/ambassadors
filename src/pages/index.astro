---
/* Home. First visit: Start Here first. Returning (Start Here complete):
   Refreshers, Present now and what's new first. The state attribute is set
   before paint by the inline script in Base.astro. */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProgressMeter from "../components/ProgressMeter.astro";
import NextSession from "../components/NextSession.astro";
import Icon from "../components/Icon.astro";
import { t } from "../lib/i18n";
import { startHereIds } from "../lib/content";
import sections from "../../content/site/sections.json";
const shIds = await startHereIds();
const refreshers = (await getCollection("refreshers")).sort((a) => (a.data.playbook === "conversation" ? -1 : 1));
const updates = (await getCollection("updates")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = updates[0];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---
<Base nav="home" bodyClass="page-home">
  <!-- First visit -->
  <section class="home-head only-first">
    <div class="wrap">
      <span class="lbl lbl-teal">{t("home.eyebrow")}</span>
      <h1 class="t-display">{t("home.firstTitle")}</h1>
      <p class="t-lede">{t("home.firstLede")}</p>
      <div class="btn-row">
        <a class="btn btn-teal" href="/start-here/">{t("home.firstCta")} <Icon name="arrow-right" size={18} /></a>
      </div>
      <ProgressMeter ids={shIds} />
    </div>
  </section>

  <!-- Returning -->
  <section class="home-head only-returning">
    <div class="wrap">
      <span class="lbl lbl-teal">{t("home.eyebrow")}</span>
      <h1 class="t-h1">{t("home.returningTitle")}</h1>
      <p class="t-lede">{t("home.returningLede")}</p>
    </div>
  </section>

  <div class="wrap page-body">
    <div class="only-returning home-grid">
      <section>
        <h2 class="section-h">{t("home.refreshersTitle")}</h2>
        <div class="stack">
          {refreshers.map((r) => (
            <a class="card tappable row-card" href={`/refreshers/${r.data.playbook}/`}>
              <span class="row-icon"><Icon name="refreshers" /></span>
              <span class="toc-main">
                <span class="t-h4">{r.data.title}</span>
                <span class="t-small">{r.data.readTime} {t("page.minRead")} · {r.data.shape.map((s) => s.step).join(" → ")}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
      <section>
        <h2 class="section-h">{t("home.presentTitle")}</h2>
        <div class="present-card s-cover grain">
          <div class="present-inner on-dark">
            <NextSession compact />
            <div class="btn-row">
              <a class="btn btn-white" href="/present/"><Icon name="play" size={18} /> {t("home.presentCta")}</a>
              <a class="btn btn-ghost" href="/present/?short">{t("home.shortCta")}</a>
            </div>
          </div>
        </div>
      </section>
      {latest && (
        <section>
          <h2 class="section-h">{t("home.whatsNew")} <span class="news-dot" role="img" aria-label={t("home.newDot")}></span></h2>
          <a class="card tappable row-card" href="/help/#whats-new">
            <span class="toc-main">
              <span class="lbl">{fmt(latest.data.date)}</span>
              <span class="t-body">{latest.data.change}</span>
            </span>
          </a>
        </section>
      )}
    </div>

    <section>
      <h2 class="section-h">{t("home.allSections")}</h2>
      <div class="tiles">
        {sections.sections.map((s) => (
          <a class="tile card tappable" href={s.href}>
            <span class="t-h4">{s.title}{s.id === "help" && <span class="news-dot" aria-hidden="true"></span>}</span>
            <span class="t-small">{s.blurb}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
