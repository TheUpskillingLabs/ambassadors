---
/* The 1-minute plan. Three questions — how you'll reach people, your next
   event, and an if-then plan for your first conversation (implementation
   intentions: "When I'm at X, I'll ask Y") — then your plan. Optional:
   Home offers it; nothing forces it. Answers stay in localStorage. */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import CoordinatorLink from "../../components/CoordinatorLink.astro";
import { u } from "../../lib/url";
import { t } from "../../lib/i18n";
import { readinessPath } from "../../lib/content";
import ob from "../../../content/site/onboarding.json";
const path = await readinessPath();
const planData = path.map((g) => ({ id: g.id, title: g.title, min: g.kind === "story" ? 10 : g.steps.reduce((n, s) => n + s.readTime, 0) }));
const Q = 3;
---
<Base title={ob.plan.kicker} chrome={false} bodyClass="page-welcome">
  <div class="ob" data-ob data-plan={JSON.stringify(planData)} data-home={u("/")}
    data-if-then={ob.plan.ifThen} data-event-line={ob.plan.eventLine} data-event-soon={ob.plan.eventSoon}>
    <form class="ob-flow" data-flow onsubmit="return false">
      <div class="ob-top">
        <button class="icon-btn2" type="button" data-back aria-label={t("page.previous")}><Icon name="arrow-left" size={22} /></button>
        <div class="ob-seg" aria-hidden="true">{Array.from({ length: Q }, () => <i><b></b></i>)}</div>
        <a class="btn-text" href={u("/")}>{t("page.close")}</a>
      </div>

      <fieldset class="ob-screen ob-q" data-screen="1">
        <legend class="ob-h">{ob.mode.q}</legend>
        <div class="opts">
          {ob.mode.options.map((o) => (
            <label class="opt"><input type="radio" name="mode" value={o.id} /><span class="opt-main"><span class="opt-label">{o.label}</span></span><span class="opt-dot" aria-hidden="true"><Icon name="check" size={14} /></span></label>
          ))}
        </div>
      </fieldset>

      <section class="ob-screen ob-q" data-screen="2" hidden>
        <label class="ob-h" for="ob-date">{ob.event.q}</label>
        <p class="ob-help">{ob.event.help}</p>
        <div class="field"><input id="ob-date" type="date" name="eventDate" data-date aria-label={ob.event.label} /></div>
        <button class="btn-text ob-none" type="button" data-no-event>{ob.event.none}</button>
      </section>

      <section class="ob-screen ob-q" data-screen="3" hidden>
        <h1 class="ob-h">{ob.first.q}</h1>
        <p class="ob-help">{ob.first.help}</p>
        <div class="field"><label for="ob-where">{ob.first.where}</label><input id="ob-where" maxlength="60" placeholder={ob.first.wherePh} data-where /></div>
        <div class="field"><label for="ob-who">{ob.first.who}</label><input id="ob-who" maxlength="40" placeholder={ob.first.whoPh} data-who /></div>
      </section>

      <div class="ob-bar">
        <button class="btn btn-teal btn-block" type="button" data-next><span data-next-label data-cta={ob.event.cta} data-last={ob.first.cta}>{ob.event.cta}</span> <Icon name="arrow-right" size={18} /></button>
      </div>
    </form>

    <section class="ob-screen ob-plan" data-screen="4" hidden>
      <div class="ob-plan-body">
        <p class="kicker">{ob.plan.kicker}</p>
        <h1 class="ob-title" data-if-then-line>{ob.plan.title}</h1>
        <p class="t-body" data-event-line hidden></p>
        <ol class="ob-steps" data-steps></ol>
        <div class="ob-plan-actions">
          <a class="btn btn-teal btn-block" href={u("/start-here/")}>{ob.plan.cta} <Icon name="arrow-right" size={18} /></a>
          <CoordinatorLink />
          <button class="btn-text" type="button" data-edit>{ob.plan.edit}</button>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { profile, daysUntil, type Profile } from "../../lib/store";
    const root = document.querySelector<HTMLElement>("[data-ob]")!;
    const flow = root.querySelector<HTMLFormElement>("[data-flow]")!;
    const screens = Array.from(root.querySelectorAll<HTMLElement>("[data-screen]"));
    const plan = JSON.parse(root.dataset.plan!) as { id: string; title: string; min: number }[];
    const Q = 3;
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const date = $<HTMLInputElement>("[data-date]"), where = $<HTMLInputElement>("[data-where]"), who = $<HTMLInputElement>("[data-who]");
    let at = 1;

    const p0 = profile.get();
    date.value = p0.eventDate ?? ""; where.value = p0.planWhere ?? ""; who.value = p0.planWho ?? "";
    date.min = new Date().toISOString().slice(0, 10);
    if (p0.mode) flow.querySelector<HTMLInputElement>(`input[name=mode][value=${p0.mode}]`)!.checked = true;

    function show(i: number) {
      at = i;
      flow.hidden = i > Q;
      screens.forEach((s) => (s.hidden = Number(s.dataset.screen) !== i));
      root.querySelectorAll(".ob-seg i").forEach((seg, k) => seg.classList.toggle("on", k < i));
      const label = $("[data-next-label]");
      label.textContent = i === Q ? label.dataset.last! : label.dataset.cta!;
      if (i > Q) renderPlan();
      screens[i - 1]?.querySelector<HTMLElement>("input:not([type=radio])")?.focus({ preventScroll: true });
      window.scrollTo({ top: 0 });
    }
    function finish() {
      const mode = (new FormData(flow).get("mode") as Profile["mode"]) || undefined;
      profile.set({ mode, eventDate: date.value || undefined, planWhere: where.value.trim() || undefined, planWho: who.value.trim() || undefined, onboarded: Date.now() });
      document.dispatchEvent(new Event("ag:plan"));
      show(Q + 1);
    }
    function renderPlan() {
      const p = profile.get();
      if (p.planWhere && p.planWho) $("[data-if-then-line]").textContent = root.dataset.ifThen!.replace("{where}", p.planWhere).replace("{who}", p.planWho);
      const order = p.mode === "room" ? ["start-here", "know-the-labs", "room", "conversation", "your-story"] : plan.map((g) => g.id);
      const steps = order.map((id) => plan.find((g) => g.id === id)!);
      $("[data-steps]").replaceChildren(...steps.map((g, i) => {
        const li = document.createElement("li");
        li.innerHTML = `<span class="ob-step-n">${i + 1}</span><span class="ob-step-main"><span class="ob-step-title"></span><span class="ob-step-min">${g.min} min</span></span>`;
        li.querySelector(".ob-step-title")!.textContent = g.title;
        return li;
      }));
      const ev = $("[data-event-line]");
      ev.hidden = !p.eventDate;
      if (p.eventDate) {
        const [y, m, d] = p.eventDate.split("-").map(Number);
        const when = new Date(y, m - 1, d).toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
        const days = daysUntil(p.eventDate);
        const min = steps.reduce((n, g) => n + g.min, 0);
        ev.textContent = days <= 1 ? root.dataset.eventSoon!.replace("{when}", when) : root.dataset.eventLine!.replace("{when}", when).replace("{perDay}", String(Math.ceil(min / days / 5) * 5));
      }
    }

    root.querySelector("[data-next]")!.addEventListener("click", () => (at >= Q ? finish() : show(at + 1)));
    root.querySelector("[data-back]")!.addEventListener("click", () => (at <= 1 ? (location.href = root.dataset.home!) : show(at - 1)));
    root.querySelector("[data-no-event]")!.addEventListener("click", () => { date.value = ""; show(3); });
    root.querySelector("[data-edit]")!.addEventListener("click", () => show(1));
    flow.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((r) => r.addEventListener("change", () => setTimeout(() => show(2), 200)));
    flow.addEventListener("keydown", (e) => { if (e.key === "Enter" && (e.target as HTMLElement).tagName === "INPUT") { e.preventDefault(); at >= Q ? finish() : show(at + 1); } });
    show(new URLSearchParams(location.search).has("edit") || !p0.onboarded ? 1 : Q + 1);
  </script>
</Base>
